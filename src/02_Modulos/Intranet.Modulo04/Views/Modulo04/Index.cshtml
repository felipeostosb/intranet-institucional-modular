@{
    ViewData["Title"] = "04. Horarios & Aulas";
}

<div class="space-y-6">
    <div class="bg-white dark:bg-[#111827] rounded-3xl p-6 border border-slate-200/80 dark:border-slate-800 shadow-sm flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-2xl bg-amber-50 dark:bg-amber-950/50 text-amber-600 dark:text-amber-400 flex items-center justify-center text-xl shrink-0">
                ⏰
            </div>
            <div>
                <div class="flex items-center gap-2 mb-1">
                    <span class="text-[10px] font-mono font-bold bg-amber-100 dark:bg-amber-950 text-amber-800 dark:text-amber-300 px-2 py-0.5 rounded">04</span>
                    <span class="text-xs font-bold text-amber-700 dark:text-amber-300 bg-amber-50 dark:bg-amber-900/40 px-2 py-0.5 rounded-md border border-amber-200 dark:border-amber-800">🗄️ Responsable BD: Equipo 04 (Morales)</span>
                </div>
                <h1 class="text-lg sm:text-xl font-black text-slate-900 dark:text-slate-100 tracking-tight">
                    Programación Horaria & Aulas
                </h1>
                <p class="text-xs text-slate-500 dark:text-slate-400">
                    Distribución de aulas físicas, laboratorios de cómputo y turnos académicos.
                </p>
            </div>
        </div>
        <div class="flex gap-2">
            <button class="btn btn-primary btn-sm rounded-xl text-xs font-bold" onclick="modal_nuevo_04.showModal()">
                + Asignar Horario
            </button>
        </div>
    </div>

    <!-- Indicadores -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white dark:bg-[#111827] rounded-2xl p-4 border border-slate-200/80 dark:border-slate-800 shadow-sm">
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Aulas Activas</span>
            <div class="text-xl font-bold text-amber-600 dark:text-amber-400 mt-1">18</div>
            <p class="text-[10px] text-slate-400 mt-0.5">Pabellón Central</p>
        </div>
        <div class="bg-white dark:bg-[#111827] rounded-2xl p-4 border border-slate-200/80 dark:border-slate-800 shadow-sm">
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Laboratorios</span>
            <div class="text-xl font-bold text-slate-900 dark:text-slate-100 mt-1">6 Labs</div>
            <p class="text-[10px] text-slate-400 mt-0.5">Equipos de Cómputo</p>
        </div>
        <div class="bg-white dark:bg-[#111827] rounded-2xl p-4 border border-slate-200/80 dark:border-slate-800 shadow-sm">
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Esquema & DBA</span>
            <div class="text-xl font-bold text-slate-900 dark:text-slate-100 font-mono mt-1">mod04</div>
            <p class="text-[10px] text-amber-600 dark:text-amber-400 font-semibold mt-0.5">DBA: Equipo 04</p>
        </div>
        <div class="bg-white dark:bg-[#111827] rounded-2xl p-4 border border-slate-200/80 dark:border-slate-800 shadow-sm">
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Usuario</span>
            <div class="text-sm font-bold text-slate-800 dark:text-slate-200 mt-1 truncate">@ViewData["UsuarioNombre"]</div>
            <p class="text-[10px] text-slate-400 mt-0.5">Rol: @ViewData["UsuarioRol"]</p>
        </div>
    </div>

    <!-- Listado Zen -->
    <div class="bg-white dark:bg-[#111827] rounded-2xl border border-slate-200/80 dark:border-slate-800 shadow-sm overflow-hidden">
        <div class="p-4 border-b border-slate-100 dark:border-slate-800 flex justify-between items-center">
            <h2 class="text-xs font-bold text-slate-800 dark:text-slate-200 uppercase tracking-wider">
                Distribución de Aulas & Laboratorios
            </h2>
        </div>
        <div class="overflow-x-auto">
            <table class="table table-zebra w-full text-xs">
                <thead>
                    <tr class="text-slate-400 dark:text-slate-500 uppercase text-[10px]">
                        <th>#</th>
                        <th>Ambiente</th>
                        <th>Tipo</th>
                        <th>Capacidad</th>
                        <th>Turno</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody class="text-slate-700 dark:text-slate-300">
                    <tr>
                        <td class="text-slate-400 font-mono">1</td>
                        <td><span class="font-mono font-bold text-amber-600 dark:text-amber-400">LAB-01</span></td>
                        <td class="font-medium text-slate-900 dark:text-slate-100">Laboratorio de Software</td>
                        <td>35 Alumnos</td>
                        <td>Mañana / Noche</td>
                        <td><span class="badge badge-success badge-xs font-semibold text-white">Disponible</span></td>
                    </tr>
                    <tr>
                        <td class="text-slate-400 font-mono">2</td>
                        <td><span class="font-mono font-bold text-amber-600 dark:text-amber-400">AULA-204</span></td>
                        <td class="font-medium text-slate-900 dark:text-slate-100">Aula Teórica</td>
                        <td>40 Alumnos</td>
                        <td>Noche</td>
                        <td><span class="badge badge-success badge-xs font-semibold text-white">Disponible</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<dialog id="modal_nuevo_04" class="modal">
    <div class="modal-box max-w-md bg-white dark:bg-[#111827] text-slate-800 dark:text-slate-200 rounded-3xl p-6 border border-slate-200/80 dark:border-slate-800 shadow-2xl">
        <h3 class="text-sm font-bold mb-3">Asignar Horario</h3>
        <div class="space-y-3 text-xs">
            <div>
                <label class="font-bold block mb-1 text-[11px]">Ambiente / Aula</label>
                <input type="text" placeholder="LAB-02" class="input input-xs input-bordered w-full rounded-xl dark:bg-slate-800 dark:border-slate-700 h-9" />
            </div>
            <div>
                <label class="font-bold block mb-1 text-[11px]">Día & Horario</label>
                <input type="text" placeholder="Lunes 18:00 - 20:15" class="input input-xs input-bordered w-full rounded-xl dark:bg-slate-800 dark:border-slate-700 h-9" />
            </div>
        </div>
        <div class="modal-action pt-2">
            <form method="dialog">
                <button class="btn btn-ghost btn-xs rounded-xl">Cancelar</button>
                <button class="btn btn-primary btn-xs rounded-xl font-bold">Guardar</button>
            </form>
        </div>
    </div>
</dialog>
