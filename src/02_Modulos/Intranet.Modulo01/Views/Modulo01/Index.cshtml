@{
    ViewData["Title"] = "01. Matrícula Académica";
}

<div class="space-y-6">
    <!-- Header Zen del Módulo -->
    <div class="bg-white dark:bg-[#111827] rounded-3xl p-6 border border-slate-200/80 dark:border-slate-800 shadow-sm flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-2xl bg-sky-50 dark:bg-sky-950/50 text-sky-600 dark:text-sky-400 flex items-center justify-center text-xl shrink-0">
                📝
            </div>
            <div>
                <div class="flex items-center gap-2 mb-1">
                    <span class="text-[10px] font-mono font-bold bg-sky-100 dark:bg-sky-950 text-sky-800 dark:text-sky-300 px-2 py-0.5 rounded">01</span>
                    <span class="text-xs font-bold text-sky-700 dark:text-sky-300 bg-sky-50 dark:bg-sky-900/40 px-2 py-0.5 rounded-md border border-sky-200 dark:border-sky-800">🗄️ Responsable BD: Ismael</span>
                </div>
                <h1 class="text-lg sm:text-xl font-black text-slate-900 dark:text-slate-100 tracking-tight">
                    Matrícula Académica & Admisión
                </h1>
                <p class="text-xs text-slate-500 dark:text-slate-400">
                    Procesamiento de matrículas regulares, extemporáneas y convalidaciones.
                </p>
            </div>
        </div>
        <div class="flex gap-2">
            <button class="btn btn-primary btn-sm rounded-xl text-xs font-bold" onclick="modal_nuevo_01.showModal()">
                + Nueva Matrícula
            </button>
        </div>
    </div>

    <!-- Indicadores -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white dark:bg-[#111827] rounded-2xl p-4 border border-slate-200/80 dark:border-slate-800 shadow-sm">
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Matriculados</span>
            <div class="text-xl font-bold text-sky-600 dark:text-sky-400 mt-1">128</div>
            <p class="text-[10px] text-slate-400 mt-0.5">Periodo 2026-II</p>
        </div>
        <div class="bg-white dark:bg-[#111827] rounded-2xl p-4 border border-slate-200/80 dark:border-slate-800 shadow-sm">
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Esquema & DBA</span>
            <div class="text-xl font-bold text-slate-900 dark:text-slate-100 font-mono mt-1">mod01</div>
            <p class="text-[10px] text-sky-600 dark:text-sky-400 font-semibold mt-0.5">DBA: Ismael</p>
        </div>
        <div class="bg-white dark:bg-[#111827] rounded-2xl p-4 border border-slate-200/80 dark:border-slate-800 shadow-sm">
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Estado</span>
            <div class="text-base font-bold text-emerald-600 dark:text-emerald-400 mt-1 flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                <span>En Línea</span>
            </div>
            <p class="text-[10px] text-slate-400 mt-0.5">Aislamiento Zero-Blast</p>
        </div>
        <div class="bg-white dark:bg-[#111827] rounded-2xl p-4 border border-slate-200/80 dark:border-slate-800 shadow-sm">
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Usuario</span>
            <div class="text-sm font-bold text-slate-800 dark:text-slate-200 mt-1 truncate">@ViewData["UsuarioNombre"]</div>
            <p class="text-[10px] text-slate-400 mt-0.5">Rol: @ViewData["UsuarioRol"]</p>
        </div>
    </div>

    <!-- Listado Zen -->
    <div class="bg-white dark:bg-[#111827] rounded-2xl border border-slate-200/80 dark:border-slate-800 shadow-sm overflow-hidden">
        <div class="p-4 border-b border-slate-100 dark:border-slate-800 flex justify-between items-center">
            <h2 class="text-xs font-bold text-slate-800 dark:text-slate-200 uppercase tracking-wider">
                Registros de Matrícula
            </h2>
        </div>
        <div class="overflow-x-auto">
            <table class="table table-zebra w-full text-xs">
                <thead>
                    <tr class="text-slate-400 dark:text-slate-500 uppercase text-[10px]">
                        <th>#</th>
                        <th>Código</th>
                        <th>Estudiante</th>
                        <th>Fecha</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody class="text-slate-700 dark:text-slate-300">
                    <tr>
                        <td class="text-slate-400 font-mono">1</td>
                        <td><span class="font-mono font-bold text-sky-600 dark:text-sky-400">MAT-2026-001</span></td>
                        <td class="font-medium text-slate-900 dark:text-slate-100">Carlos Mendoza</td>
                        <td class="text-slate-400 font-mono">@DateTime.Now.ToString("dd/MM/yyyy")</td>
                        <td><span class="badge badge-success badge-xs font-semibold text-white">Regular</span></td>
                    </tr>
                    <tr>
                        <td class="text-slate-400 font-mono">2</td>
                        <td><span class="font-mono font-bold text-sky-600 dark:text-sky-400">MAT-2026-002</span></td>
                        <td class="font-medium text-slate-900 dark:text-slate-100">Ana García</td>
                        <td class="text-slate-400 font-mono">@DateTime.Now.ToString("dd/MM/yyyy")</td>
                        <td><span class="badge badge-success badge-xs font-semibold text-white">Regular</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Formulario -->
<dialog id="modal_nuevo_01" class="modal">
    <div class="modal-box max-w-md bg-white dark:bg-[#111827] text-slate-800 dark:text-slate-200 rounded-3xl p-6 border border-slate-200/80 dark:border-slate-800 shadow-2xl">
        <h3 class="text-sm font-bold mb-3">Nueva Matrícula</h3>
        <div class="space-y-3 text-xs">
            <div>
                <label class="font-bold block mb-1 text-[11px]">DNI del Estudiante</label>
                <input type="text" placeholder="87654321" class="input input-xs input-bordered w-full rounded-xl dark:bg-slate-800 dark:border-slate-700 h-9" />
            </div>
            <div>
                <label class="font-bold block mb-1 text-[11px]">Carrera & Ciclo</label>
                <input type="text" placeholder="Desarrollo de Sistemas de Información - VI" class="input input-xs input-bordered w-full rounded-xl dark:bg-slate-800 dark:border-slate-700 h-9" />
            </div>
        </div>
        <div class="modal-action pt-2">
            <form method="dialog">
                <button class="btn btn-ghost btn-xs rounded-xl">Cancelar</button>
                <button class="btn btn-primary btn-xs rounded-xl font-bold">Guardar</button>
            </form>
        </div>
    </div>
</dialog>
