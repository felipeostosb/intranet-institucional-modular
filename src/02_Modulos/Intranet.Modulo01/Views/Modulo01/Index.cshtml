@model Intranet.Modulo01.Controllers.Modulo01DashboardViewModel
@{
    ViewData["Title"] = "01. Matrícula Académica";
}

<div class="space-y-6">
    <!-- Tabs del módulo (flujo por rol) -->
    <div class="tabs-modulo flex flex-wrap gap-1.5 mb-1 bg-slate-100 dark:bg-slate-800/60 rounded-2xl p-1.5 w-fit" data-modulo="01">
        <a href="/Modulo01" class="tab-link px-4 py-2 rounded-xl text-xs font-bold transition">Resumen</a>
        @if (Model.EsAlumno)
        {
            <a href="/Modulo01/Matriculas/MiMatricula" class="tab-link px-4 py-2 rounded-xl text-xs font-bold transition">Mi matrícula</a>
        }
        else
        {
            <a href="/Modulo01/Matriculatura" class="tab-link px-4 py-2 rounded-xl text-xs font-bold transition" data-solo-rol="Secretaria,Director,Coordinador,Admin">Matriculatura</a>
            <a href="/Modulo01/Matriculas" class="tab-link px-4 py-2 rounded-xl text-xs font-bold transition">Panel de trabajo</a>
            <a href="/Modulo01/Matriculas/Vacantes" class="tab-link px-4 py-2 rounded-xl text-xs font-bold transition">Vacantes</a>
        }
    </div>
    <!-- Header Zen del Módulo (patrón del Módulo 02) -->
    <div class="bg-white dark:bg-[#111827] rounded-3xl p-6 border border-slate-200/80 dark:border-slate-800 shadow-sm flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-2xl bg-sky-50 dark:bg-sky-950/50 text-sky-600 dark:text-sky-400 flex items-center justify-center text-xl shrink-0">
                🎓
            </div>
            <div>
                <div class="flex items-center gap-2 mb-1">
                    <span class="text-[10px] font-mono font-bold bg-sky-100 dark:bg-sky-950 text-sky-800 dark:text-sky-300 px-2 py-0.5 rounded">01</span>
                    <span class="text-xs font-bold text-sky-700 dark:text-sky-300 bg-sky-50 dark:bg-sky-900/40 px-2 py-0.5 rounded-md border border-sky-200 dark:border-sky-800">🗄️ Responsable BD: Ismael</span>
                </div>
                <h1 class="text-lg sm:text-xl font-black text-slate-900 dark:text-slate-100 tracking-tight">
                    Matrícula Académica — Proceso Cero Filas
                </h1>
                <p class="text-xs text-slate-500 dark:text-slate-400">
                    @if (User.IsInRole("Tesoreria") && !User.IsInRole("Admin"))
                    {
                        <span>Tu puesto: <strong>validar vouchers de matrícula</strong> (cotejo DRELM). Sin tu validación no hay conformidad.</span>
                    }
                    else if (User.IsInRole("Secretaria") && !User.IsInRole("Admin"))
                    {
                        <span>Tu puesto: <strong>validar fotos y dar la conformidad</strong> que consume la vacante.</span>
                    }
                    else
                    {
                        <span>Trámite → doble validación (voucher + foto) → conformidad → registro con consumo de vacante.</span>
                    }
                </p>
            </div>
        </div>
        <div class="flex flex-wrap gap-2">
            @if (Model.EsAlumno)
            {
                <a href="/Modulo01/Matriculas/MiMatricula" class="btn btn-primary btn-sm rounded-xl text-xs font-bold shadow-sm">🎓 Mi Matrícula</a>
            }
            else if (User.IsInRole("Tesoreria") && !User.IsInRole("Admin"))
            {
                <a href="/Modulo01/Matriculas" class="btn btn-primary btn-sm rounded-xl text-xs font-bold shadow-sm">
                    💳 Tu Bandeja de Vouchers
                    @if (Model.Resumen.EnEspera > 0)
                    {
                        <span class="badge badge-error badge-xs text-white font-bold">@Model.Resumen.EnEspera en espera</span>
                    }
                </a>
                <a href="/Modulo01/Matriculas/Vacantes" class="btn btn-ghost btn-sm rounded-xl text-xs font-semibold">📊 Vacantes</a>
            }
            else if (User.IsInRole("Secretaria") && !User.IsInRole("Admin"))
            {
                <a href="/Modulo01/Matriculatura" class="btn btn-primary btn-sm rounded-xl text-xs font-bold shadow-sm">🗂️ Matricular estudiante (Reserva TM05)</a>
                <a href="/Modulo01/Matriculas" class="btn btn-outline btn-sm rounded-xl text-xs font-semibold">
                    📷 Tu Panel: Fotos + Conformidad
                    @if (Model.Resumen.ListasParaRegistrar > 0)
                    {
                        <span class="badge badge-error badge-xs text-white font-bold">@Model.Resumen.ListasParaRegistrar listas</span>
                    }
                </a>
                <a href="/Modulo01/Matriculas/Vacantes" class="btn btn-ghost btn-sm rounded-xl text-xs font-semibold">📊 Vacantes</a>
            }
            else
            {
                <a href="/Modulo01/Matriculas" class="btn btn-primary btn-sm rounded-xl text-xs font-bold shadow-sm">📋 Panel de Trabajo</a>
                <a href="/Modulo01/Matriculas/Vacantes" class="btn btn-ghost btn-sm rounded-xl text-xs font-semibold">📊 Vacantes</a>
            }
        </div>
    </div>

    @if (!Model.EsAlumno)
    {
    @if (Model.ResumenTesoreria != null)
    {
        var rt = Model.ResumenTesoreria;
        <!-- Panel de TESORERÍA (ámbar): SU puesto — vouchers de la Reserva de Matrícula -->
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
            <div class="bg-white dark:bg-[#111827] rounded-2xl p-4 border border-amber-300/70 dark:border-amber-800/60 shadow-sm">
                <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">🧾 Vouchers de reserva por validar</span>
                <div class="text-xl font-bold @(rt.VouchersPendientes > 0 ? "text-rose-600 dark:text-rose-400" : "text-emerald-600 dark:text-emerald-400") mt-1">@rt.VouchersPendientes</div>
                <p class="text-[10px] text-slate-400 mt-0.5"><a class="link link-primary" href="/Modulo09/Pagos">Validarlos en la bandeja →</a></p>
            </div>
            <div class="bg-white dark:bg-[#111827] rounded-2xl p-4 border border-amber-300/70 dark:border-amber-800/60 shadow-sm">
                <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">✅ Vouchers validados</span>
                <div class="text-xl font-bold text-emerald-600 dark:text-emerald-400 mt-1">@rt.VouchersValidados</div>
                <p class="text-[10px] text-slate-400 mt-0.5">@(rt.VouchersRechazados > 0 ? $"{rt.VouchersRechazados} rechazados por re-subir" : "sin rechazos pendientes")</p>
            </div>
            <div class="bg-white dark:bg-[#111827] rounded-2xl p-4 border border-amber-300/70 dark:border-amber-800/60 shadow-sm">
                <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">💰 Recaudado por reservas</span>
                <div class="text-xl font-bold text-emerald-600 dark:text-emerald-400 mt-1 font-mono">S/ @rt.RecaudadoReservas.ToString("0.00")</div>
                <p class="text-[10px] text-slate-400 mt-0.5"> vouchers CT13 validados</p>
            </div>
            <div class="bg-white dark:bg-[#111827] rounded-2xl p-4 border border-amber-300/70 dark:border-amber-800/60 shadow-sm">
                <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">⏳ Pagadas sin matricular</span>
                <div class="text-xl font-bold @(rt.PagadasSinMatricular > 0 ? "text-amber-600 dark:text-amber-400" : "text-slate-600 dark:text-slate-300") mt-1">@rt.PagadasSinMatricular</div>
                <p class="text-[10px] text-slate-400 mt-0.5">alumnas/os validados esperando a Secretaría</p>
            </div>
        </div>
    }
    else if (Model.ResumenSecretaria != null)
    {
        var rs = Model.ResumenSecretaria;
        <!-- Panel de SECRETARÍA (celeste): SU puesto — el cierre de matrículas -->
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
            <div class="bg-white dark:bg-[#111827] rounded-2xl p-4 border border-sky-300/70 dark:border-sky-800/60 shadow-sm">
                <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">🗂️ Listas para cerrar</span>
                <div class="text-xl font-bold @(rs.ListasParaCerrar > 0 ? "text-emerald-600 dark:text-emerald-400" : "text-slate-600 dark:text-slate-300") mt-1">@rs.ListasParaCerrar</div>
                <p class="text-[10px] text-slate-400 mt-0.5"><a class="link link-primary" href="/Modulo01/Matriculatura">Matricular en Matriculatura →</a></p>
            </div>
            <div class="bg-white dark:bg-[#111827] rounded-2xl p-4 border border-sky-300/70 dark:border-sky-800/60 shadow-sm">
                <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">🎓 Matriculados del período</span>
                <div class="text-xl font-bold text-sky-600 dark:text-sky-400 mt-1">@rs.MatriculadosPeriodo</div>
                <p class="text-[10px] text-slate-400 mt-0.5">cierre completado con ficha enviada</p>
            </div>
            <div class="bg-white dark:bg-[#111827] rounded-2xl p-4 border border-sky-300/70 dark:border-sky-800/60 shadow-sm">
                <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">⏳ Esperando voucher</span>
                <div class="text-xl font-bold @(rs.EsperandoVoucher > 0 ? "text-amber-600 dark:text-amber-400" : "text-slate-600 dark:text-slate-300") mt-1">@rs.EsperandoVoucher</div>
                <p class="text-[10px] text-slate-400 mt-0.5">pendiente de Tesorería, no tuyo</p>
            </div>
            <div class="bg-white dark:bg-[#111827] rounded-2xl p-4 border border-sky-300/70 dark:border-sky-800/60 shadow-sm">
                <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">📥 Trámites TM05 activos</span>
                <div class="text-xl font-bold text-slate-700 dark:text-slate-300 mt-1">@rs.TramitesActivos</div>
                <p class="text-[10px] text-slate-400 mt-0.5">en mesa / evaluación (módulo 09)</p>
            </div>
        </div>
        @if (rs.PorCarrera.Any())
        {
            var maxCant = rs.PorCarrera.Max(x => x.Cantidad);
            <!-- Mini-gráfico: matrículas cerradas por carrera (barras CSS) -->
            <div class="bg-white dark:bg-[#111827] rounded-2xl border border-slate-200/80 dark:border-slate-800 shadow-sm p-5">
                <div class="flex justify-between items-center mb-4">
                    <h2 class="text-xs font-bold text-slate-800 dark:text-slate-200 uppercase tracking-wider">🎓 Matriculados por carrera</h2>
                    <span class="text-[10px] text-slate-400">período habilitado</span>
                </div>
                <div class="space-y-2.5">
                    @foreach (var x in rs.PorCarrera)
                    {
                        var pct = maxCant > 0 ? x.Cantidad * 100 / maxCant : 0;
                        <div class="flex items-center gap-2">
                            <span class="text-[10px] font-mono font-bold text-slate-500 dark:text-slate-400 w-14 shrink-0" title="@x.Nombre">@x.Codigo</span>
                            <div class="flex-1 h-3 bg-slate-100 dark:bg-slate-800 rounded-full overflow-hidden">
                                <div class="h-full bg-sky-500 rounded-full" style="width:@(pct)%"></div>
                            </div>
                            <span class="text-[10px] font-mono font-bold text-slate-600 dark:text-slate-300 w-8 text-right">@x.Cantidad</span>
                        </div>
                    }
                </div>
            </div>
        }
    }
    else
    {
    <!-- Indicadores operativos (personal) -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white dark:bg-[#111827] rounded-2xl p-4 border border-slate-200/80 dark:border-slate-800 shadow-sm">
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Matriculados</span>
            <div class="text-xl font-bold text-emerald-600 dark:text-emerald-400 mt-1">@Model.Resumen.Matriculados</div>
            <p class="text-[10px] text-slate-400 mt-0.5">con conformidad</p>
        </div>
        <div class="bg-white dark:bg-[#111827] rounded-2xl p-4 border border-slate-200/80 dark:border-slate-800 shadow-sm">
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Listas para registrar</span>
            <div class="text-xl font-bold text-sky-600 dark:text-sky-400 mt-1">@Model.Resumen.ListasParaRegistrar</div>
            <p class="text-[10px] text-slate-400 mt-0.5">doble validación completa</p>
        </div>
        <div class="bg-white dark:bg-[#111827] rounded-2xl p-4 border border-slate-200/80 dark:border-slate-800 shadow-sm">
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">En espera</span>
            <div class="text-xl font-bold text-amber-600 dark:text-amber-400 mt-1">@Model.Resumen.EnEspera</div>
            <p class="text-[10px] text-slate-400 mt-0.5">falta voucher o foto</p>
        </div>
        <div class="bg-white dark:bg-[#111827] rounded-2xl p-4 border border-slate-200/80 dark:border-slate-800 shadow-sm">
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Reservadas</span>
            <div class="text-xl font-bold text-slate-700 dark:text-slate-300 mt-1">@Model.Resumen.Reservadas</div>
            <p class="text-[10px] text-slate-400 mt-0.5">Art. 24 RI</p>
        </div>
    </div>
    }

    }

    @if (!Model.EsAlumno)
    {
        <!-- Últimas matrículas -->
        <div class="bg-white dark:bg-[#111827] rounded-2xl border border-slate-200/80 dark:border-slate-800 shadow-sm p-5">
            <div class="flex justify-between items-center mb-3">
                <h2 class="text-xs font-bold text-slate-800 dark:text-slate-200 uppercase tracking-wider">📋 Últimas matrículas</h2>
                <a href="/Modulo01/Matriculas" class="link link-primary text-[11px]">Ver el panel completo</a>
            </div>
            <div class="space-y-2">
                @if (!Model.Ultimas.Any())
                {
                    <p class="text-xs text-slate-400 italic">Sin matrículas todavía.</p>
                }
                @foreach (var m in Model.Ultimas)
                {
                    <div class="flex items-center justify-between gap-2 text-xs">
                        <span class="font-mono font-bold text-sky-600 dark:text-sky-400">@m.Codigo</span>
                        <span class="flex-1 truncate text-slate-600 dark:text-slate-300">@m.Estudiante · @m.CarreraCodigo @m.Ciclo @m.Turno</span>
                        <span class="badge @(m.Estado == "Matriculado" ? "badge-success" : m.Estado == "En trámite" ? "badge-warning" : "badge-ghost") badge-xs font-semibold text-white">@m.Estado</span>
                    </div>
                }
            </div>
        </div>

        <!-- Carriles de vacantes más apretados -->
        <div class="bg-white dark:bg-[#111827] rounded-2xl border border-slate-200/80 dark:border-slate-800 shadow-sm p-5">
            <div class="flex justify-between items-center mb-3">
                <h2 class="text-xs font-bold text-slate-800 dark:text-slate-200 uppercase tracking-wider">📊 Vacantes: carriles con menos cupos</h2>
                <a href="/Modulo01/Matriculas/Vacantes" class="link link-primary text-[11px]">Tablero completo</a>
            </div>
            <div class="grid grid-cols-2 lg:grid-cols-4 gap-3">
                @foreach (var v in Model.VacantesCriticas)
                {
                    <div class="border border-slate-200 dark:border-slate-700 rounded-xl p-3">
                        <p class="text-[11px] font-bold text-slate-800 dark:text-slate-200 font-mono">@v.CarreraCodigo-@v.Turno @v.Ciclo</p>
                        <p class="text-lg font-bold @(v.Disponibles == 0 ? "text-rose-500" : "text-emerald-600 dark:text-emerald-400") font-mono mt-0.5">@v.Disponibles<span class="text-[10px] text-slate-400 font-sans"> / @(v.Ocupadas + v.Disponibles)</span></p>
                        <p class="text-[10px] text-slate-400">@v.Ocupadas ocupadas</p>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <!-- Mini-dashboard del alumno: SUS datos reales (nada global del instituto) -->
        @if (Model.Panel != null)
        {
            var p = Model.Panel;
            var ordenCiclo = new[] { "I", "II", "III", "IV", "V", "VI" };
            var idxCiclo = Array.IndexOf(ordenCiclo, p.CicloActual);
            var pctCarrera = idxCiclo >= 0 ? (int)Math.Round((idxCiclo + 1) * 100.0 / ordenCiclo.Length) : 0;
            var notaColor = new Dictionary<string, string>
            {
                ["Aprobado"] = "bg-emerald-500",
                ["Desaprobado"] = "bg-rose-500",
                ["Retirado"] = "bg-slate-400"
            };

            <!-- Indicadores personales (mismo patrón visual que los del personal) -->
            <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
                <div class="bg-white dark:bg-[#111827] rounded-2xl p-4 border border-slate-200/80 dark:border-slate-800 shadow-sm">
                    <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Promedio</span>
                    <div class="text-xl font-bold @(p.Promedio >= 10.5m ? "text-emerald-600 dark:text-emerald-400" : "text-amber-600 dark:text-amber-400") mt-1">@(p.Historial.Count > 0 ? p.Promedio.ToString("0.0") : "—")</div>
                    <p class="text-[10px] text-slate-400 mt-0.5">vigesimal, @(p.Historial.Count) cursos</p>
                </div>
                <div class="bg-white dark:bg-[#111827] rounded-2xl p-4 border border-slate-200/80 dark:border-slate-800 shadow-sm">
                    <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Condición</span>
                    <div class="text-xl font-bold text-sky-600 dark:text-sky-400 mt-1">@(string.IsNullOrEmpty(p.Condicion) ? "—" : p.Condicion)</div>
                    <p class="text-[10px] text-slate-400 mt-0.5">@(string.IsNullOrEmpty(p.CursosDesaprobadosNombres) ? "sin cursos a cargo" : p.CursosDesaprobadosNombres)</p>
                </div>
                <div class="bg-white dark:bg-[#111827] rounded-2xl p-4 border border-slate-200/80 dark:border-slate-800 shadow-sm">
                    <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Progreso de carrera</span>
                    <div class="flex items-center gap-2 mt-2">
                        <div class="flex-1 h-2 bg-slate-100 dark:bg-slate-800 rounded-full overflow-hidden">
                            <div class="h-full bg-sky-500 rounded-full" style="width:@(pctCarrera)%"></div>
                        </div>
                        <span class="text-sm font-bold text-slate-700 dark:text-slate-300 font-mono">@(pctCarrera)%</span>
                    </div>
                    <p class="text-[10px] text-slate-400 mt-1">ciclo @(string.IsNullOrEmpty(p.CicloActual) ? "—" : p.CicloActual) de VI@(string.IsNullOrEmpty(p.CicloProximo) ? "" : " → " + p.CicloProximo)</p>
                </div>
                <div class="bg-white dark:bg-[#111827] rounded-2xl p-4 border border-slate-200/80 dark:border-slate-800 shadow-sm">
                    <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Créditos aprobados</span>
                    <div class="text-xl font-bold text-amber-600 dark:text-amber-400 mt-1">@(p.CreditosAprobados > 0 ? p.CreditosAprobados.ToString() : "—")</div>
                    <p class="text-[10px] text-slate-400 mt-0.5">@(p.CarreraCodigo) · @p.CodigoEstudiante</p>
                </div>
            </div>

            <div class="grid lg:grid-cols-5 gap-4 items-start">
                <!-- Timeline del flujo de reserva -->
                <div class="lg:col-span-2 bg-white dark:bg-[#111827] rounded-2xl border border-slate-200/80 dark:border-slate-800 shadow-sm p-5">
                    <h2 class="text-xs font-bold text-slate-800 dark:text-slate-200 uppercase tracking-wider mb-4">🧭 Tu proceso de matrícula</h2>
                    <ol class="relative border-l-2 border-slate-200 dark:border-slate-700 ml-3 space-y-5">
                        @foreach (var paso in p.PasosFlujo)
                        {
                            var icono = paso.Estado == "Completado" ? "✅" : paso.Estado == "Actual" ? "🔵" : "⬜";
                            <li class="ml-4">
                                <span class="absolute -left-[13px] flex w-6 h-6 items-center justify-center text-xs">@icono</span>
                                <h3 class="text-xs font-bold @(paso.Estado == "Pendiente" ? "text-slate-400" : "text-slate-800 dark:text-slate-200")">@paso.Titulo</h3>
                                <p class="text-[11px] @(paso.Estado == "Pendiente" ? "text-slate-400" : "text-slate-500 dark:text-slate-400") mt-0.5">@paso.Detalle</p>
                            </li>
                        }
                    </ol>
                    <div class="flex flex-wrap gap-2 mt-5">
                        <a href="/Modulo01/Matriculas/MiMatricula" class="btn btn-primary btn-sm rounded-xl text-xs font-bold shadow-sm">Ver mi matrícula</a>
                        <a href="/Modulo09/Tramites#nuevoTramite" class="btn btn-outline btn-sm rounded-xl text-xs">Solicitar reserva / trámite TUPA</a>
                    </div>
                </div>

                <!-- Barras de notas del historial -->
                <div class="lg:col-span-3 bg-white dark:bg-[#111827] rounded-2xl border border-slate-200/80 dark:border-slate-800 shadow-sm p-5">
                    <div class="flex justify-between items-center mb-4">
                        <h2 class="text-xs font-bold text-slate-800 dark:text-slate-200 uppercase tracking-wider">📊 Mis notas</h2>
                        <span class="text-[10px] text-slate-400">escala 0 – 20</span>
                    </div>
                    @if (!p.Historial.Any())
                    {
                        <p class="text-xs text-slate-400 italic">Aún no tienes historial académico registrado.</p>
                    }
                    else
                    {
                        <div class="space-y-2.5">
                            @foreach (var h in p.Historial)
                            {
                                var pct = Math.Min(100, (int)Math.Round(h.Nota * 5));
                                <div class="flex items-center gap-2">
                                    <span class="text-[10px] font-mono font-bold text-slate-500 dark:text-slate-400 w-14 shrink-0" title="@h.UnidadNombre">@h.UnidadCodigo</span>
                                    <div class="flex-1 h-3 bg-slate-100 dark:bg-slate-800 rounded-full overflow-hidden">
                                        <div class="h-full @(notaColor.TryGetValue(h.Estado, out var c) ? c : "bg-slate-400") rounded-full" style="width:@(pct)%"></div>
                                    </div>
                                    <span class="text-[10px] font-mono font-bold @(h.Estado == "Desaprobado" ? "text-rose-500" : "text-slate-600 dark:text-slate-300") w-8 text-right">@h.Nota.ToString("0")</span>
                                </div>
                            }
                        </div>
                        <p class="text-[10px] text-slate-400 mt-4">
                            🔴 en rojo: curso a cargo para tu próximo ciclo (Art. 24 del RI).
                        </p>
                    }
                </div>
            </div>
        }
        else
        {
            <!-- Fallback: sin datos de estudiante (usuario con rol Alumno sin expediente) -->
            <div class="bg-white dark:bg-[#111827] rounded-2xl border border-slate-200/80 dark:border-slate-800 shadow-sm p-5">
                <h2 class="text-xs font-bold text-slate-800 dark:text-slate-200 uppercase tracking-wider mb-3">📄 Tu matrícula</h2>
                <p class="text-xs text-slate-500 dark:text-slate-400 mb-3">El seguimiento de tu trámite y los documentos están en <strong>Mi matrícula</strong>. Si aún no la iniciaste, hazlo desde Trámites TUPA.</p>
                <div class="flex flex-wrap gap-2">
                    <a href="/Modulo01/Matriculas/MiMatricula" class="btn btn-primary btn-sm rounded-xl text-xs font-bold shadow-sm">Ver mi matrícula</a>
                    <a href="/Modulo09/Tramites#nuevoTramite" class="btn btn-outline btn-sm rounded-xl text-xs">Solicitar reserva / trámite TUPA</a>
                </div>
            </div>
        }
    }

    <!-- Pie de módulo -->
    <p class="text-[10px] text-slate-400 text-center">
        Módulo 01 · Esquema PostgreSQL <span class="font-mono">mod01</span> · Aislamiento Zero-Blast-Radius
    </p>
