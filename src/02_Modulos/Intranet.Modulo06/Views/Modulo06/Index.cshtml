@{
    ViewData["Title"] = "06. Mesa de Partes & Trámites";
}

<div class="space-y-6">
    <div class="bg-white dark:bg-[#111827] rounded-3xl p-6 border border-slate-200/80 dark:border-slate-800 shadow-sm flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-2xl bg-rose-50 dark:bg-rose-950/50 text-rose-600 dark:text-rose-400 flex items-center justify-center text-xl shrink-0">
                📋
            </div>
            <div>
                <div class="flex items-center gap-2 mb-1">
                    <span class="text-[10px] font-mono font-bold bg-rose-100 dark:bg-rose-950 text-rose-800 dark:text-rose-300 px-2 py-0.5 rounded">06</span>
                    <span class="text-xs text-slate-400">Equipo 06 • Trámites & Documentación</span>
                </div>
                <h1 class="text-lg sm:text-xl font-black text-slate-900 dark:text-slate-100 tracking-tight">
                    Mesa de Partes & Trámites Digitales
                </h1>
                <p class="text-xs text-slate-500 dark:text-slate-400">
                    Recepción de expedientes, certificados de estudio y solicitudes institucionales.
                </p>
            </div>
        </div>
        <div class="flex gap-2">
            <button class="btn btn-primary btn-sm rounded-xl text-xs font-bold" onclick="modal_nuevo_06.showModal()">
                + Nuevo Trámite
            </button>
        </div>
    </div>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white dark:bg-[#111827] rounded-2xl p-4 border border-slate-200/80 dark:border-slate-800 shadow-sm">
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Expedientes</span>
            <div class="text-xl font-bold text-rose-600 dark:text-rose-400 mt-1">42</div>
            <p class="text-[10px] text-slate-400 mt-0.5">En trámite</p>
        </div>
        <div class="bg-white dark:bg-[#111827] rounded-2xl p-4 border border-slate-200/80 dark:border-slate-800 shadow-sm">
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Atendidos</span>
            <div class="text-xl font-bold text-emerald-600 dark:text-emerald-400 mt-1">115</div>
            <p class="text-[10px] text-slate-400 mt-0.5">Completados</p>
        </div>
        <div class="bg-white dark:bg-[#111827] rounded-2xl p-4 border border-slate-200/80 dark:border-slate-800 shadow-sm">
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Esquema BD</span>
            <div class="text-xl font-bold text-slate-900 dark:text-slate-100 font-mono mt-1">mod06</div>
            <p class="text-[10px] text-slate-400 mt-0.5">PostgreSQL Cloud</p>
        </div>
        <div class="bg-white dark:bg-[#111827] rounded-2xl p-4 border border-slate-200/80 dark:border-slate-800 shadow-sm">
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Usuario</span>
            <div class="text-sm font-bold text-slate-800 dark:text-slate-200 mt-1 truncate">@ViewData["UsuarioNombre"]</div>
            <p class="text-[10px] text-slate-400 mt-0.5">Rol: @ViewData["UsuarioRol"]</p>
        </div>
    </div>

    <div class="bg-white dark:bg-[#111827] rounded-2xl border border-slate-200/80 dark:border-slate-800 shadow-sm overflow-hidden">
        <div class="p-4 border-b border-slate-100 dark:border-slate-800 flex justify-between items-center">
            <h2 class="text-xs font-bold text-slate-800 dark:text-slate-200 uppercase tracking-wider">
                Expedientes en Trámite
            </h2>
        </div>
        <div class="overflow-x-auto">
            <table class="table table-zebra w-full text-xs">
                <thead>
                    <tr class="text-slate-400 dark:text-slate-500 uppercase text-[10px]">
                        <th>#</th>
                        <th>Expediente</th>
                        <th>Solicitante</th>
                        <th>Tipo de Trámite</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody class="text-slate-700 dark:text-slate-300">
                    <tr>
                        <td class="text-slate-400 font-mono">1</td>
                        <td><span class="font-mono font-bold text-rose-600 dark:text-rose-400">EXP-2026-089</span></td>
                        <td class="font-medium text-slate-900 dark:text-slate-100">Carlos Mendoza</td>
                        <td>Certificado de Estudios Oficial</td>
                        <td><span class="badge badge-info badge-xs font-semibold text-white">En Evaluación</span></td>
                    </tr>
                    <tr>
                        <td class="text-slate-400 font-mono">2</td>
                        <td><span class="font-mono font-bold text-rose-600 dark:text-rose-400">EXP-2026-090</span></td>
                        <td class="font-medium text-slate-900 dark:text-slate-100">Kevin Ramos</td>
                        <td>Justificación de Inasistencia</td>
                        <td><span class="badge badge-warning badge-xs font-semibold text-white">Pendiente</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<dialog id="modal_nuevo_06" class="modal">
    <div class="modal-box max-w-md bg-white dark:bg-[#111827] text-slate-800 dark:text-slate-200 rounded-3xl p-6 border border-slate-200/80 dark:border-slate-800 shadow-2xl">
        <h3 class="text-sm font-bold mb-3">Nuevo Trámite Digital</h3>
        <div class="space-y-3 text-xs">
            <div>
                <label class="font-bold block mb-1 text-[11px]">DNI del Solicitante</label>
                <input type="text" placeholder="87654321" class="input input-xs input-bordered w-full rounded-xl dark:bg-slate-800 dark:border-slate-700 h-9" />
            </div>
            <div>
                <label class="font-bold block mb-1 text-[11px]">Asunto / Tipo de Trámite</label>
                <input type="text" placeholder="Constancia de Matrícula" class="input input-xs input-bordered w-full rounded-xl dark:bg-slate-800 dark:border-slate-700 h-9" />
            </div>
        </div>
        <div class="modal-action pt-2">
            <form method="dialog">
                <button class="btn btn-ghost btn-xs rounded-xl">Cancelar</button>
                <button class="btn btn-primary btn-xs rounded-xl font-bold">Enviar</button>
            </form>
        </div>
    </div>
</dialog>
