@model IEnumerable<Intranet.Modulo06.Models.ExpedienteDashboardDto>

@{
    ViewData["Title"] = "06. Egresados & Titulación";
    var egresado = ViewBag.EgresadoBuscado as Intranet.Modulo06.Models.EgresadoDetalleDto;
    string dniActual = ViewBag.DniBuscado as string ?? "";
}

<div class="space-y-6 max-w-7xl mx-auto p-4">
    
    <!-- Header Institucional -->
    <div class="bg-white rounded-lg p-6 border-l-4 border-cyan-500 shadow-sm flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div>
            <h1 class="text-2xl font-black text-slate-800 tracking-tight uppercase">
                Egresados & Titulación Profesional
            </h1>
            <p class="text-sm text-slate-500 mt-1">
                Seguimiento a graduados, trámites de titulación profesional, emisión de diplomas y libro de egresados.
            </p>
        </div>
        <div class="flex gap-2">
            <button class="bg-cyan-500 hover:bg-cyan-600 text-white font-bold text-sm px-6 py-2.5 rounded-md shadow-sm transition-colors" onclick="modal_nuevo_06.showModal()">
                + Nueva Solicitud
            </button>
        </div>
    </div>

    <!-- Indicadores Estadísticos (Estilo Web IESTP) -->
    <div class="bg-cyan-500 rounded-lg p-6 shadow-sm">
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 text-center text-white">
            <div>
                <div class="text-4xl font-black font-mono">380</div>
                <span class="text-xs font-bold uppercase tracking-wider block mt-2">Total Egresados</span>
                <p class="text-[10px] text-cyan-100 mt-1">Libro Institucional</p>
            </div>
            <div>
                <div class="text-4xl font-black font-mono">28</div>
                <span class="text-xs font-bold uppercase tracking-wider block mt-2">Titulaciones en Proceso</span>
                <p class="text-[10px] text-cyan-100 mt-1">Sustentación</p>
            </div>
            <div>
                <div class="text-4xl font-black font-mono">mod06</div>
                <span class="text-xs font-bold uppercase tracking-wider block mt-2">Esquema & DBA</span>
                <p class="text-[10px] text-cyan-100 mt-1">DBA: Sandra</p>
            </div>
            <div>
                <div class="text-xl font-bold mt-2 truncate">@ViewData["UsuarioNombre"]</div>
                <span class="text-xs font-bold uppercase tracking-wider block mt-2">Usuario Activo</span>
                <p class="text-[10px] text-cyan-100 mt-1">Rol: @ViewData["UsuarioRol"]</p>
            </div>
        </div>
    </div>

    <!-- 🔍 ZONA DE BÚSQUEDA POR DNI -->
    <div class="bg-white rounded-lg p-6 border border-slate-200 shadow-sm">
        <h2 class="text-sm font-bold text-slate-800 uppercase tracking-wider mb-4 border-b border-slate-100 pb-2">
            🔍 Búsqueda de Egresado por DNI
        </h2>
        <form method="get" action="/Modulo06" class="flex flex-col sm:flex-row gap-3">
            <div class="relative flex-1">
                <input type="text" name="dniBusqueda" value="@dniActual" maxlength="8" placeholder="Ingrese DNI de 8 dígitos..." 
                       class="w-full rounded-md text-sm border-slate-300 focus:border-cyan-500 focus:ring-cyan-500 h-11 px-4 outline-none border transition-colors" />
            </div>
            <button type="submit" class="bg-cyan-500 hover:bg-cyan-600 text-white font-bold text-sm h-11 px-8 rounded-md shadow-sm transition-colors">
                Buscar Egresado
            </button>
        </form>

        @if (TempData["MensajeError"] != null)
        {
            <div class="bg-red-50 border border-red-200 text-red-600 mt-4 text-sm p-3 rounded-md flex items-center">
                <span>@TempData["MensajeError"]</span>
            </div>
        }
    </div>

    <!-- 👤 TARJETA DEL EGRESADO ENCONTRADO -->
    @if (egresado != null)
    {
        <div class="bg-white border-t-4 border-t-cyan-500 border border-slate-200 rounded-lg p-6 shadow-sm">
            <div class="text-[11px] font-bold text-cyan-600 uppercase tracking-widest mb-4">DATOS DEL EGRESADO ENCONTRADO</div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div>
                    <span class="text-slate-400 text-xs block mb-1 uppercase tracking-wider font-semibold">Nombre Completo:</span>
                    <span class="text-base font-bold text-slate-800">@egresado.NombreCompleto</span>
                </div>
                <div>
                    <span class="text-slate-400 text-xs block mb-1 uppercase tracking-wider font-semibold">Programa / Carrera:</span>
                    <span class="text-base font-bold text-slate-800">@(string.IsNullOrEmpty(egresado.Carrera) ? "Computación e Informática" : egresado.Carrera)</span>
                </div>
                <div>
                    <span class="text-slate-400 text-xs block mb-1 uppercase tracking-wider font-semibold">Estado General del Trámite:</span>
                    <span class="inline-block bg-green-100 text-green-700 border border-green-200 font-bold text-xs px-3 py-1 rounded-md mt-1">@egresado.EstadoGeneral</span>
                </div>
            </div>
        </div>
    }

    <!-- Listado General de Expedientes Recientes -->
    <div class="bg-white rounded-lg border border-slate-200 shadow-sm overflow-hidden">
        <div class="p-5 border-b border-slate-100 bg-slate-50 flex justify-between items-center">
            <h2 class="text-sm font-bold text-slate-800 uppercase tracking-wider">
                Expedientes de Titulación Recientes
            </h2>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-sm text-left">
                <thead class="text-xs text-slate-500 uppercase bg-slate-50 border-b border-slate-200">
                    <tr>
                        <th class="px-6 py-4 font-bold">Expediente</th>
                        <th class="px-6 py-4 font-bold">Egresado</th>
                        <th class="px-6 py-4 font-bold">Carrera / Programa</th>
                        <th class="px-6 py-4 font-bold">Modalidad</th>
                        <th class="px-6 py-4 font-bold">Estado</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var exp in Model)
                        {
                            string badgeClass = "bg-slate-100 text-slate-700 border-slate-200";
                            if (exp.Estado == "Validado" || exp.Estado == "Aprobado" || exp.Estado == "Apto")
                                badgeClass = "bg-green-100 text-green-700 border-green-200";
                            else if (exp.Estado == "En Revisión" || exp.Estado == "Observado")
                                badgeClass = "bg-amber-100 text-amber-700 border-amber-200";
                            else if (exp.Estado == "Pendiente" || exp.Estado == "Rechazado")
                                badgeClass = "bg-red-100 text-red-700 border-red-200";

                            <tr class="hover:bg-slate-50 transition-colors">
                                <td class="px-6 py-4 font-mono font-bold text-cyan-600">@exp.NumeroExpediente</td>
                                <td class="px-6 py-4 font-medium text-slate-800">@exp.NombreCompleto</td>
                                <td class="px-6 py-4 text-slate-600">@exp.Carrera</td>
                                <td class="px-6 py-4 text-slate-600">@exp.Modalidad</td>
                                <td class="px-6 py-4">
                                    <span class="border @badgeClass text-[11px] font-bold px-2.5 py-1 rounded-md">@exp.Estado</span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-8 text-slate-500 italic">No hay expedientes recientes registrados en el sistema.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal para Nueva Solicitud -->
<dialog id="modal_nuevo_06" class="modal">
    <div class="modal-box max-w-md bg-white rounded-lg p-6 border border-slate-200 shadow-xl">
        <h3 class="text-lg font-bold text-slate-800 mb-4 border-b border-slate-100 pb-2">Registrar Solicitud de Titulación</h3>
        <div class="space-y-4 text-sm">
            <div>
                <label class="font-bold block mb-1.5 text-slate-700">DNI del Egresado</label>
                <input type="text" placeholder="Ingrese DNI..." class="w-full rounded-md border-slate-300 focus:border-cyan-500 focus:ring-cyan-500 h-10 px-3 outline-none border transition-colors" />
            </div>
            <div>
                <label class="font-bold block mb-1.5 text-slate-700">Carrera Profesional</label>
                <input type="text" placeholder="Computación e Informática" class="w-full rounded-md border-slate-300 focus:border-cyan-500 focus:ring-cyan-500 h-10 px-3 outline-none border transition-colors" />
            </div>
        </div>
        <div class="modal-action pt-4 mt-2 border-t border-slate-100">
            <form method="dialog" class="flex gap-2 w-full justify-end">
                <button class="px-4 py-2 text-sm font-bold text-slate-600 hover:bg-slate-100 rounded-md transition-colors">Cancelar</button>
                <button class="bg-cyan-500 hover:bg-cyan-600 text-white px-6 py-2 text-sm font-bold rounded-md shadow-sm transition-colors">Guardar Solicitud</button>
            </form>
        </div>
    </div>
</dialog>
