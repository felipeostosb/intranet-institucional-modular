@{
    ViewData["Title"] = "06. Egresados & Titulación";
}

<div class="space-y-6">
    <!-- Header Zen del Módulo -->
    <div class="bg-white dark:bg-[#111827] rounded-3xl p-6 border border-slate-200/80 dark:border-slate-800 shadow-sm flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-2xl bg-rose-50 dark:bg-rose-950/50 text-rose-600 dark:text-rose-400 flex items-center justify-center text-xl shrink-0">
                🎓
            </div>
            <div>
                <div class="flex items-center gap-2 mb-1">
                    <span class="text-[10px] font-mono font-bold bg-rose-100 dark:bg-rose-950 text-rose-800 dark:text-rose-300 px-2 py-0.5 rounded">06</span>
                    <span class="text-xs font-bold text-rose-700 dark:text-rose-300 bg-rose-50 dark:bg-rose-900/40 px-2 py-0.5 rounded-md border border-rose-200 dark:border-rose-800">🗄️ Responsable BD: Sandra</span>
                </div>
                <h1 class="text-lg sm:text-xl font-black text-slate-900 dark:text-slate-100 tracking-tight">
                    Egresados & Titulación Profesional
                </h1>
                <p class="text-xs text-slate-500 dark:text-slate-400">
                    Seguimiento a graduados, trámites de titulación profesional, emisión de diplomas y libro de egresados.
                </p>
            </div>
        </div>
        <div class="flex gap-2">
            <button class="btn btn-primary btn-sm rounded-xl text-xs font-bold" onclick="modal_nuevo_06.showModal()">
                + Nueva Solicitud
            </button>
        </div>
    </div>

    <!-- Indicadores -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white dark:bg-[#111827] rounded-2xl p-4 border border-slate-200/80 dark:border-slate-800 shadow-sm">
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Total Egresados</span>
            <div class="text-xl font-bold text-rose-600 dark:text-rose-400 mt-1 font-mono">380</div>
            <p class="text-[10px] text-slate-400 mt-0.5">Libro Institucional</p>
        </div>
        <div class="bg-white dark:bg-[#111827] rounded-2xl p-4 border border-slate-200/80 dark:border-slate-800 shadow-sm">
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Titulaciones en Proceso</span>
            <div class="text-xl font-bold text-emerald-600 dark:text-emerald-400 mt-1 font-mono">28</div>
            <p class="text-[10px] text-slate-400 mt-0.5">Sustentación</p>
        </div>
        <div class="bg-white dark:bg-[#111827] rounded-2xl p-4 border border-slate-200/80 dark:border-slate-800 shadow-sm">
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Esquema & DBA</span>
            <div class="text-xl font-bold text-slate-900 dark:text-slate-100 font-mono mt-1">mod06</div>
            <p class="text-[10px] text-rose-600 dark:text-rose-400 font-semibold mt-0.5">DBA: Sandra</p>
        </div>
        <div class="bg-white dark:bg-[#111827] rounded-2xl p-4 border border-slate-200/80 dark:border-slate-800 shadow-sm">
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Usuario Activo</span>
            <div class="text-sm font-bold text-slate-800 dark:text-slate-200 mt-1 truncate">@ViewData["UsuarioNombre"]</div>
            <p class="text-[10px] text-slate-400 mt-0.5">Rol: @ViewData["UsuarioRol"]</p>
        </div>
    </div>

    <!-- Listado Zen de Titulaciones -->
    <div class="bg-white dark:bg-[#111827] rounded-2xl border border-slate-200/80 dark:border-slate-800 shadow-sm overflow-hidden">
        <div class="p-4 border-b border-slate-100 dark:border-slate-800 flex justify-between items-center">
            <h2 class="text-xs font-bold text-slate-800 dark:text-slate-200 uppercase tracking-wider">
                Expedientes de Titulación Recientes
            </h2>
        </div>
        <div class="overflow-x-auto">
            <table class="table table-zebra w-full text-xs">
                <thead>
                    <tr class="text-slate-400 dark:text-slate-500 uppercase text-[10px]">
                        <th>Expediente</th>
                        <th>Egresado</th>
                        <th>Carrera / Programa</th>
                        <th>Modalidad</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody class="text-slate-700 dark:text-slate-300">
                    <tr>
                        <td class="font-mono font-bold text-rose-600 dark:text-rose-400">#TIT-2026-042</td>
                        <td class="font-medium text-slate-900 dark:text-slate-100">Carlos Mendoza Gómez</td>
                        <td>Desarrollo de Sistemas de Información</td>
                        <td>Proyecto de Innovación</td>
                        <td><span class="badge badge-success badge-xs font-semibold text-white">Aprobado</span></td>
                    </tr>
                    <tr>
                        <td class="font-mono font-bold text-rose-600 dark:text-rose-400">#TIT-2026-043</td>
                        <td class="font-medium text-slate-900 dark:text-slate-100">Lucía Ramos Pérez</td>
                        <td>Contabilidad Técnica</td>
                        <td>Examen de Suficiencia</td>
                        <td><span class="badge badge-warning badge-xs font-semibold text-white">En Revisión</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<dialog id="modal_nuevo_06" class="modal">
    <div class="modal-box max-w-md bg-white dark:bg-[#111827] text-slate-800 dark:text-slate-200 rounded-3xl p-6 border border-slate-200/80 dark:border-slate-800 shadow-2xl">
        <h3 class="text-sm font-bold mb-3">Registrar Solicitud de Titulación</h3>
        <div class="space-y-3 text-xs">
            <div>
                <label class="font-bold block mb-1 text-[11px]">DNI del Egresado</label>
                <input type="text" placeholder="87654321" class="input input-xs input-bordered w-full rounded-xl dark:bg-slate-800 dark:border-slate-700 h-9" />
            </div>
            <div>
                <label class="font-bold block mb-1 text-[11px]">Carrera Profesional</label>
                <input type="text" placeholder="Desarrollo de Sistemas de Información" class="input input-xs input-bordered w-full rounded-xl dark:bg-slate-800 dark:border-slate-700 h-9" />
            </div>
        </div>
        <div class="modal-action pt-2">
            <form method="dialog">
                <button class="btn btn-ghost btn-xs rounded-xl">Cancelar</button>
                <button class="btn btn-primary btn-xs rounded-xl font-bold">Guardar Solicitud</button>
            </form>
        </div>
    </div>
</dialog>
