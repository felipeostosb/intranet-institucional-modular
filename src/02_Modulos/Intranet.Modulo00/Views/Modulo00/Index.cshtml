@{
    ViewData["Title"] = "00. Seguridad & Accesos";
}

<div class="space-y-6">
    <!-- Header Zen del Módulo -->
    <div class="bg-white dark:bg-[#111827] rounded-3xl p-6 border border-slate-200/80 dark:border-slate-800 shadow-sm flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-2xl bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 flex items-center justify-center text-xl shrink-0">
                🛡️
            </div>
            <div>
                <div class="flex items-center gap-2 mb-1">
                    <span class="text-[10px] font-mono font-bold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 px-2 py-0.5 rounded">00</span>
                    <span class="text-xs text-slate-400">Equipo 00 • Seguridad & Auditoría</span>
                </div>
                <h1 class="text-lg sm:text-xl font-black text-slate-900 dark:text-slate-100 tracking-tight">
                    Seguridad, Autenticación & Accesos
                </h1>
                <p class="text-xs text-slate-500 dark:text-slate-400">
                    Gestión central de sesiones, roles institucionales y auditoría de eventos.
                </p>
            </div>
        </div>
        <div class="flex gap-2">
            <a href="/Account/Login" class="btn btn-outline btn-sm rounded-xl text-xs">
                Pantalla Login SSO
            </a>
        </div>
    </div>

    <!-- Indicadores de Estado -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="bg-white dark:bg-[#111827] rounded-2xl p-4 border border-slate-200/80 dark:border-slate-800 shadow-sm space-y-1">
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Estado SSO</span>
            <div class="text-xl font-bold text-emerald-600 dark:text-emerald-400 flex items-center gap-2">
                <span>Activo</span>
                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            </div>
            <p class="text-[11px] text-slate-500 dark:text-slate-400">Cookies Criptográficas (.NET 10 LTS)</p>
        </div>

        <div class="bg-white dark:bg-[#111827] rounded-2xl p-4 border border-slate-200/80 dark:border-slate-800 shadow-sm space-y-1">
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Esquema Soberano</span>
            <div class="text-xl font-bold text-slate-900 dark:text-slate-100 font-mono">mod00</div>
            <p class="text-[11px] text-slate-500 dark:text-slate-400">PostgreSQL 16 Cloud RBAC</p>
        </div>

        <div class="bg-white dark:bg-[#111827] rounded-2xl p-4 border border-slate-200/80 dark:border-slate-800 shadow-sm space-y-1">
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Protección Anti-Fuerza Bruta</span>
            <div class="text-xl font-bold text-indigo-600 dark:text-indigo-400">5 Intentos Máx</div>
            <p class="text-[11px] text-slate-500 dark:text-slate-400">Bloqueo preventivo de 15 minutos</p>
        </div>
    </div>
</div>
