@model IEnumerable<Intranet.Modulo03.Models.TransferenciaModel>
<div class="min-h-screen bg-base-200 p-6"><div class="max-w-7xl mx-auto">
<div class="flex justify-between items-center mb-5"><div><h1 class="text-3xl font-bold">Transferencias</h1><p class="text-base-content/60">Movimientos entre almacenes.</p></div><div class="flex gap-2"><a href="/Modulo03/Transferencias/Crear" class="btn btn-primary">+ Nueva transferencia</a><a href="/Modulo03" class="btn btn-ghost">Panel</a></div></div>
@if (TempData["Ok"] is not null) { <div class="alert alert-success mb-4">@TempData["Ok"]</div> } @if (TempData["Error"] is not null) { <div class="alert alert-error mb-4">@TempData["Error"]</div> }
<div class="card bg-base-100 shadow-xl"><div class="card-body overflow-x-auto"><table class="table table-zebra"><thead><tr><th>CBI</th><th>Bien</th><th>Origen</th><th>Destino</th><th>Solicitud</th><th>Estado</th><th>Motivo</th><th>Acciones</th></tr></thead><tbody>
@foreach(var t in Model){<tr><td class="font-semibold">@t.Cbi</td><td>@t.Descripcion</td><td>@t.AlmacenOrigen</td><td>@t.AlmacenDestino</td><td>@t.FechaSolicitud.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td><span class="badge @(t.EstadoMovimiento=="Recepcionado"?"badge-success":t.EstadoMovimiento=="Cancelado"?"badge-error":"badge-warning")">@t.EstadoMovimiento</span></td><td>@t.Motivo</td><td class="flex gap-1">@if(t.EstadoMovimiento!="Recepcionado" && t.EstadoMovimiento!="Cancelado"){<form method="post" action="/Modulo03/Transferencias/Recepcionar/@t.IdTransferencia" onsubmit="return confirm('¿Recepcionar esta transferencia?');">@Html.AntiForgeryToken()<button class="btn btn-xs btn-success">Recepcionar</button></form><form method="post" action="/Modulo03/Transferencias/Cancelar/@t.IdTransferencia" onsubmit="return confirm('¿Cancelar esta transferencia?');">@Html.AntiForgeryToken()<button class="btn btn-xs btn-error btn-outline">Cancelar</button></form>}</td></tr>}
</tbody></table></div></div></div></div>
