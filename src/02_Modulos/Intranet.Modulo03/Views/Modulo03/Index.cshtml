@{
    ViewData["Title"] = "Módulo 03";
}

<div class="space-y-6">
    <!-- Header del Módulo con Tono Pastel e Icono Llamativo -->
    <div class="bg-white rounded-3xl p-6 sm:p-7 border border-slate-200/80 shadow-sm flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div class="flex items-center gap-4">
            <div class="w-14 h-14 rounded-2xl bg-emerald-100 text-emerald-700 border border-emerald-200 flex items-center justify-center shrink-0 shadow-sm">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                </svg>
            </div>
            <div>
                <div class="flex items-center gap-2 mb-1">
                    <span class="text-xs font-bold bg-emerald-100 text-emerald-800 px-2.5 py-0.5 rounded-full border border-emerald-200">Módulo 03</span>
                    <span class="text-xs text-slate-400 font-medium">db_modulo03 • Equipo 03</span>
                </div>
                <h1 class="text-xl sm:text-2xl font-extrabold text-slate-900 tracking-tight">
                    Módulo 03 — Espacio de Trabajo
                </h1>
                <p class="text-xs text-slate-500">
                    Panel administrado por el <strong>Equipo 03</strong>. Conectado a la base de datos <code class="text-emerald-700 font-mono font-bold">db_modulo03</code>.
                </p>
            </div>
        </div>
        <div class="flex gap-2">
            <button class="btn bg-emerald-600 hover:bg-emerald-700 text-white btn-sm rounded-xl font-bold border-0 shadow-sm text-xs px-4" onclick="modal_nuevo_03.showModal()">
                + Nuevo Registro
            </button>
        </div>
    </div>

    <!-- Indicadores del Módulo -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white rounded-2xl p-4 border border-slate-200/80 shadow-sm">
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Registros Activos</span>
            <div class="text-2xl font-extrabold text-emerald-600 mt-1">24</div>
            <p class="text-[10px] text-slate-400 mt-0.5">En db_modulo03</p>
        </div>
        <div class="bg-white rounded-2xl p-4 border border-slate-200/80 shadow-sm">
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Equipo Responsable</span>
            <div class="text-lg font-bold text-slate-800 mt-1">Equipo 03</div>
            <p class="text-[10px] text-slate-400 mt-0.5">4 Desarrolladores</p>
        </div>
        <div class="bg-white rounded-2xl p-4 border border-slate-200/80 shadow-sm">
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Estado de Conexión</span>
            <div class="text-lg font-bold text-emerald-600 mt-1 flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                <span>En Línea</span>
            </div>
            <p class="text-[10px] text-slate-400 mt-0.5">Aislamiento Zero-Blast</p>
        </div>
        <div class="bg-white rounded-2xl p-4 border border-slate-200/80 shadow-sm">
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Sesión Activa</span>
            <div class="text-sm font-bold text-slate-800 mt-1 truncate">@ViewData["UsuarioNombre"]</div>
            <p class="text-[10px] text-slate-400 mt-0.5">Rol: @ViewData["UsuarioRol"]</p>
        </div>
    </div>

    <!-- Tabla de Registros del Módulo -->
    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">
        <div class="p-4 border-b border-slate-100 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 bg-slate-50/50">
            <div>
                <h2 class="text-sm font-bold text-slate-800">Listado de Datos — Módulo 03</h2>
                <p class="text-xs text-slate-400">Plantilla lista para vincular a consultas SQL o modelos C#.</p>
            </div>
            <div class="flex gap-2">
                <input type="text" placeholder="Buscar registro..." class="input input-sm input-bordered rounded-xl bg-white text-xs w-48" />
            </div>
        </div>

        <div class="overflow-x-auto">
            <table class="table table-zebra w-full text-xs">
                <thead>
                    <tr class="bg-slate-100/70 text-slate-600 font-bold uppercase text-[10px]">
                        <th>#</th>
                        <th>Código</th>
                        <th>Descripción del Registro</th>
                        <th>Fecha</th>
                        <th>Estado</th>
                        <th class="text-right">Acción</th>
                    </tr>
                </thead>
                <tbody class="text-slate-700">
                    <tr class="hover">
                        <td class="font-bold text-slate-400">1</td>
                        <td><span class="font-mono font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-lg border border-emerald-200">REG-03-001</span></td>
                        <td class="font-medium text-slate-900">Registro de prueba inicial para el Módulo 03</td>
                        <td class="text-slate-400 font-mono">@DateTime.Now.ToString("dd/MM/yyyy")</td>
                        <td><span class="badge badge-success badge-sm font-semibold">Completado</span></td>
                        <td class="text-right"><button class="btn btn-ghost btn-xs text-emerald-700 font-bold">Ver</button></td>
                    </tr>
                    <tr class="hover">
                        <td class="font-bold text-slate-400">2</td>
                        <td><span class="font-mono font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-lg border border-emerald-200">REG-03-002</span></td>
                        <td class="font-medium text-slate-900">Segundo registro de demostración</td>
                        <td class="text-slate-400 font-mono">@DateTime.Now.ToString("dd/MM/yyyy")</td>
                        <td><span class="badge badge-info badge-sm font-semibold">En Proceso</span></td>
                        <td class="text-right"><button class="btn btn-ghost btn-xs text-emerald-700 font-bold">Ver</button></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Formulario -->
<dialog id="modal_nuevo_03" class="modal">
    <div class="modal-box max-w-md bg-white rounded-3xl p-6 shadow-2xl border border-slate-200">
        <h3 class="text-base font-bold text-slate-900 mb-1">
            Nuevo Registro — Módulo 03
        </h3>
        <p class="text-xs text-slate-400 mb-4">Formulario listo para vincular a tu controlador en C#.</p>
        
        <div class="space-y-3 text-xs">
            <div>
                <label class="font-bold text-slate-600 block mb-1">Código / Identificador</label>
                <input type="text" placeholder="Ej: REG-03-003" class="input input-sm input-bordered w-full rounded-xl" />
            </div>
            <div>
                <label class="font-bold text-slate-600 block mb-1">Título / Nombre</label>
                <input type="text" placeholder="Nombre del registro" class="input input-sm input-bordered w-full rounded-xl" />
            </div>
            <div>
                <label class="font-bold text-slate-600 block mb-1">Descripción</label>
                <textarea class="textarea textarea-bordered w-full rounded-xl text-xs" rows="3" placeholder="Detalle adicional..."></textarea>
            </div>
        </div>

        <div class="modal-action mt-6 flex gap-2">
            <form method="dialog">
                <button class="btn btn-ghost btn-sm rounded-xl">Cancelar</button>
                <button class="btn bg-emerald-600 hover:bg-emerald-700 text-white btn-sm rounded-xl font-bold border-0">Guardar</button>
            </form>
        </div>
    </div>
</dialog>
