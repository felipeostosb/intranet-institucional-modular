@model Intranet.Modulo03.Models.InventarioFiltroModel
@using System.Linq
@{
    var bienes = Model.Resultados ?? [];
    var total = bienes.Count;
    var buenos = bienes.Count(x => x.Estado == "Bueno");
    var regular = bienes.Count(x => x.Estado == "Regular");
    var reparacion = bienes.Count(x => x.Estado == "En reparación");
    var inoperativos = bienes.Count(x => x.Estado == "Inoperativo");
    var bajas = bienes.Count(x => x.Estado == "De baja" || x.Estado == "Baja en trámite");
}

<div class="min-h-screen bg-base-200 p-5 md:p-6">
    <div class="max-w-[1700px] mx-auto space-y-6">
        <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
            <div>
                <div class="badge badge-primary mb-3">Módulo 03</div>
                <h1 class="text-3xl md:text-4xl font-bold">Inventario &amp; Equipos Informáticos</h1>
                <p class="text-base-content/60 mt-2">Gestión de bienes, equipos, almacenes y movimientos.</p>
            </div>
            <div class="flex flex-wrap gap-2">
                <a href="/Modulo03/Bienes/Crear" class="btn btn-primary">+ Registrar bien</a>
                <a href="/Modulo03/Reportes/Excel" class="btn btn-outline">↓ Excel</a>
            </div>
        </div>

        @if (TempData["Ok"] is not null) { <div class="alert alert-success">@TempData["Ok"]</div> }
        @if (TempData["Error"] is not null) { <div class="alert alert-error">@TempData["Error"]</div> }

        <div class="grid grid-cols-2 lg:grid-cols-6 gap-4">
            <div class="card bg-base-100 shadow"><div class="card-body"><div class="text-sm text-base-content/60">Total</div><div class="text-3xl font-bold">@total</div></div></div>
            <div class="card bg-base-100 shadow"><div class="card-body"><div class="text-sm text-base-content/60">Bueno</div><div class="text-3xl font-bold text-success">@buenos</div></div></div>
            <div class="card bg-base-100 shadow"><div class="card-body"><div class="text-sm text-base-content/60">Regular</div><div class="text-3xl font-bold">@regular</div></div></div>
            <div class="card bg-base-100 shadow"><div class="card-body"><div class="text-sm text-base-content/60">Reparación</div><div class="text-3xl font-bold text-warning">@reparacion</div></div></div>
            <div class="card bg-base-100 shadow"><div class="card-body"><div class="text-sm text-base-content/60">Inoperativo</div><div class="text-3xl font-bold text-error">@inoperativos</div></div></div>
            <div class="card bg-base-100 shadow"><div class="card-body"><div class="text-sm text-base-content/60">Baja</div><div class="text-3xl font-bold">@bajas</div></div></div>
        </div>

        <div class="card bg-base-100 shadow-xl">
            <div class="card-body">
                <div class="flex flex-col xl:flex-row xl:items-end gap-3">
                    <div class="flex-1">
                        <label class="label"><span class="label-text font-semibold">Buscar</span></label>
                        <input form="filtros" name="Q" value="@Model.Q" class="input input-bordered w-full" placeholder="CBI, serie, descripción, marca, modelo, estado..." />
                    </div>
                    <div class="w-full xl:w-56">
                        <label class="label"><span class="label-text">Estado</span></label>
                        <select form="filtros" name="Estado" class="select select-bordered w-full">
                            <option value="">Todos</option>
                            @foreach (var estado in new[] { "Bueno", "Regular", "Malo", "En reparación", "Inoperativo", "Baja en trámite", "De baja" })
                            {
                                <option value="@estado" selected="@(Model.Estado == estado ? "selected" : null)">@estado</option>
                            }
                        </select>
                    </div>
                    <div class="w-full xl:w-56">
                        <label class="label"><span class="label-text">Clasificación</span></label>
                        <select form="filtros" name="IdClasificacion" class="select select-bordered w-full">
                            <option value="">Todas</option>
                            @foreach (var c in Model.Clasificaciones)
                            {
                                <option value="@c.IdClasificacion" selected="@(Model.IdClasificacion == c.IdClasificacion ? "selected" : null)">@c.Nombre</option>
                            }
                        </select>
                    </div>
                    <div class="w-full xl:w-56">
                        <label class="label"><span class="label-text">Almacén</span></label>
                        <select form="filtros" name="IdAlmacen" class="select select-bordered w-full">
                            <option value="">Todos</option>
                            @foreach (var a in Model.Almacenes)
                            {
                                <option value="@a.IdAlmacen" selected="@(Model.IdAlmacen == a.IdAlmacen ? "selected" : null)">@a.Nombre</option>
                            }
                        </select>
                    </div>
                    <div class="flex gap-2">
                        <button form="filtros" class="btn btn-primary">Filtrar</button>
                        <a href="/Modulo03" class="btn btn-ghost">Limpiar</a>
                    </div>
                </div>
                <form id="filtros" method="get" action="/Modulo03"></form>

                <div class="flex flex-wrap gap-2 mt-4">
                    <a href="/Modulo03/Almacenes" class="btn btn-sm btn-outline">Almacenes</a>
                    <a href="/Modulo03/Ambientes" class="btn btn-sm btn-outline">Ambientes</a>
                    <a href="/Modulo03/Asignaciones" class="btn btn-sm btn-outline">Asignaciones</a>
                    <a href="/Modulo03/Transferencias" class="btn btn-sm btn-outline">Transferencias</a>
                    <a href="/Modulo03/InventarioAnual" class="btn btn-sm btn-outline">Inventario anual</a>
                    <a href="/Modulo03/Reportes" class="btn btn-sm btn-outline">Reportes</a>
                </div>

                <div class="overflow-x-auto mt-5">
                    <table class="table table-zebra text-sm">
                        <thead>
                        <tr>
                            <th>CBI</th><th>Equipo</th><th>Clasificación</th><th>Marca</th><th>Modelo</th><th>Serie</th><th>Estado</th><th>Almacén</th><th>Ambiente</th><th>Ingreso</th><th>Acciones</th>
                        </tr>
                        </thead>
                        <tbody>
                        @if (!bienes.Any())
                        {
                            <tr><td colspan="11" class="text-center py-10 text-base-content/60">No hay bienes que coincidan con los filtros.</td></tr>
                        }
                        else
                        {
                            foreach (var bien in bienes)
                            {
                                var badge = bien.Estado switch
                                {
                                    "Bueno" => "badge-success",
                                    "En reparación" => "badge-warning",
                                    "Inoperativo" or "De baja" => "badge-error",
                                    _ => "badge-ghost"
                                };
                                <tr>
                                    <td class="font-semibold">@bien.Cbi</td>
                                    <td>@bien.Descripcion</td>
                                    <td><span class="badge badge-outline">@bien.Clasificacion</span></td>
                                    <td>@(bien.Marca ?? "-")</td>
                                    <td>@(bien.Modelo ?? "-")</td>
                                    <td>@(bien.Serie ?? "-")</td>
                                    <td><span class="badge @badge">@bien.Estado</span></td>
                                    <td>@bien.AlmacenActual</td>
                                    <td>@(bien.AmbienteActual ?? "Sin asignar")</td>
                                    <td>@bien.FechaIngreso.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        <div class="flex gap-1">
                                            <a href="/Modulo03/Bienes/Detalle/@bien.IdBien" class="btn btn-xs btn-ghost">Ver</a>
                                            <a href="/Modulo03/Bienes/Editar/@bien.IdBien" class="btn btn-xs btn-outline">Editar</a>
                                            @if (bien.Estado != "De baja")
                                            {
                                                <form method="post" action="/Modulo03/Bienes/Baja/@bien.IdBien" onsubmit="return confirm('¿Marcar este bien como De baja?');">
                                                    @Html.AntiForgeryToken()
                                                    <button class="btn btn-xs btn-warning">Baja</button>
                                                </form>
                                            }
                                            <form method="post" action="/Modulo03/Bienes/Eliminar/@bien.IdBien" onsubmit="return confirm('¿Eliminar físicamente este bien? Solo funcionará si no tiene movimientos relacionados.');">
                                                @Html.AntiForgeryToken()
                                                <button class="btn btn-xs btn-error btn-outline">Eliminar</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
