@model Intranet.Modulo02.Models.DashboardAsistenciaViewModel
@{
    ViewData["Title"] = "02. Asistencia & DPI";
}

<div class="space-y-6">
    <!-- Header Zen del Módulo -->
    <div class="bg-white dark:bg-[#111827] rounded-3xl p-6 border border-slate-200/80 dark:border-slate-800 shadow-sm flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-2xl bg-indigo-50 dark:bg-indigo-950/50 text-indigo-600 dark:text-indigo-400 flex items-center justify-center text-xl shrink-0">
                📅
            </div>
            <div>
                <div class="flex items-center gap-2 mb-1">
                    <span class="text-[10px] font-mono font-bold bg-indigo-100 dark:bg-indigo-950 text-indigo-800 dark:text-indigo-300 px-2 py-0.5 rounded">02</span>
                    <span class="text-xs font-bold text-indigo-700 dark:text-indigo-300 bg-indigo-50 dark:bg-indigo-900/40 px-2 py-0.5 rounded-md border border-indigo-200 dark:border-indigo-800">🗄️ Responsable BD: Sheyla / Felipe</span>
                </div>
                <h1 class="text-lg sm:text-xl font-black text-slate-900 dark:text-slate-100 tracking-tight">
                    Control de Asistencia & Deserción
                </h1>
                <p class="text-xs text-slate-500 dark:text-slate-400">
                    Registro de sesiones, sábana de 18 semanas y prevención de deserción estudiantil.
                </p>
            </div>
        </div>
        <div class="flex flex-wrap gap-2">
            <a href="/Modulo02/MiAsistencia" class="btn btn-ghost btn-sm rounded-xl text-xs font-semibold">
                Mi Asistencia
            </a>
            <a href="/Modulo02/Justificaciones" class="btn btn-ghost btn-sm rounded-xl text-xs font-semibold">
                Justificaciones
                @if (Model.TotalJustificacionesPendientes > 0)
                {
                    <span class="badge badge-error badge-xs text-white font-bold">@Model.TotalJustificacionesPendientes</span>
                }
            </a>
            <a href="/Modulo02/ReportesDpi" class="btn btn-primary btn-sm rounded-xl text-xs font-bold shadow-sm">
                Reportes DPI
            </a>
        </div>
    </div>

    <!-- Indicadores -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white dark:bg-[#111827] rounded-2xl p-4 border border-slate-200/80 dark:border-slate-800 shadow-sm">
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Clases Asignadas</span>
            <div class="text-xl font-bold text-indigo-600 dark:text-indigo-400 mt-1">@Model.TotalClasesAsignadas</div>
            <p class="text-[10px] text-slate-400 mt-0.5">Periodo 2026-II</p>
        </div>
        <div class="bg-white dark:bg-[#111827] rounded-2xl p-4 border border-slate-200/80 dark:border-slate-800 shadow-sm">
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Sesiones Hoy</span>
            <div class="text-xl font-bold text-emerald-600 dark:text-emerald-400 mt-1">@Model.TotalSesionesHoy</div>
            <p class="text-[10px] text-slate-400 mt-0.5">Programadas</p>
        </div>
        <div class="bg-white dark:bg-[#111827] rounded-2xl p-4 border border-slate-200/80 dark:border-slate-800 shadow-sm">
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Alumnos en DPI</span>
            <div class="text-xl font-bold text-rose-600 dark:text-rose-400 mt-1 flex items-center gap-1.5">
                <span>@Model.TotalAlumnosDpi</span>
                <span class="text-[10px] font-semibold bg-rose-50 dark:bg-rose-950/50 text-rose-700 dark:text-rose-300 px-1.5 py-0.5 rounded">&ge;30% Faltas</span>
            </div>
            <p class="text-[10px] text-slate-400 mt-0.5">Inhabilitados</p>
        </div>
        <div class="bg-white dark:bg-[#111827] rounded-2xl p-4 border border-slate-200/80 dark:border-slate-800 shadow-sm">
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Usuario</span>
            <div class="text-sm font-bold text-slate-800 dark:text-slate-200 mt-1 truncate">@Model.NombreUsuario</div>
            <p class="text-[10px] text-slate-400 mt-0.5">Rol: @Model.RolUsuario</p>
        </div>
    </div>

    <!-- SECCIÓN 1: Mis Asignaturas -->
    @if (Model.EsDocente || Model.MisClasesDocente.Any())
    {
        <div class="space-y-3">
            <h2 class="text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider">
                Mis Asignaturas Asignadas
            </h2>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                @foreach (var clase in Model.MisClasesDocente)
                {
                    <div class="bg-white dark:bg-[#111827] rounded-2xl p-5 border border-slate-200/80 dark:border-slate-800 shadow-sm flex flex-col justify-between space-y-3">
                        <div class="space-y-2">
                            <div class="flex items-center justify-between">
                                <span class="text-[10px] font-mono font-bold bg-indigo-50 dark:bg-indigo-950 text-indigo-700 dark:text-indigo-300 px-2 py-0.5 rounded">@clase.UnidadDidacticaCodigo</span>
                                <span class="text-[10px] text-slate-400">Ciclo @clase.Ciclo • @clase.Turno</span>
                            </div>
                            <h3 class="font-bold text-xs text-slate-900 dark:text-slate-100 leading-snug">
                                @clase.UnidadDidacticaNombre
                            </h3>
                            <p class="text-[11px] text-slate-400">@clase.CarreraNombre • Secc @clase.Seccion</p>

                            <!-- Avance -->
                            <div class="space-y-1 pt-1">
                                <div class="flex justify-between text-[11px] text-slate-500 dark:text-slate-400">
                                    <span>Avance</span>
                                    <span class="font-mono font-bold">@clase.SemanasRegistradas / @clase.TotalSemanasRegulares sem</span>
                                </div>
                                <div class="w-full bg-slate-100 dark:bg-slate-800 h-1.5 rounded-full overflow-hidden">
                                    <div class="bg-indigo-600 h-full rounded-full" style="width: @Math.Min(100, (clase.SemanasRegistradas * 100 / clase.TotalSemanasRegulares))%"></div>
                                </div>
                            </div>
                        </div>

                        <div class="pt-3 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between">
                            <a href="/Modulo02/Matriz/@clase.ClaseId" class="text-[11px] text-slate-600 dark:text-slate-400 font-semibold hover:underline">
                                📊 Matriz 18 Sem
                            </a>
                            <a href="/Modulo02/Clase/@clase.ClaseId" class="text-[11px] text-indigo-600 dark:text-indigo-400 font-bold hover:underline">
                                Semanas →
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- SECCIÓN 2: Sesiones & Alertas -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
        <div class="lg:col-span-2 space-y-3">
            <h2 class="text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider">
                Sesiones Dictadas & En Curso
            </h2>

            <div class="bg-white dark:bg-[#111827] rounded-2xl border border-slate-200/80 dark:border-slate-800 shadow-sm overflow-hidden divide-y divide-slate-100 dark:divide-slate-800">
                @if (Model.SesionesHoy.Any())
                {
                    @foreach (var s in Model.SesionesHoy)
                    {
                        <div class="p-4 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3">
                            <div class="flex items-start gap-3">
                                <div class="w-9 h-9 rounded-xl bg-indigo-50 dark:bg-indigo-950/50 text-indigo-700 dark:text-indigo-300 flex flex-col items-center justify-center shrink-0 font-bold">
                                    <span class="text-[8px] uppercase">S</span>
                                    <span class="text-xs leading-none">@s.NumeroSemana</span>
                                </div>
                                <div>
                                    <div class="flex items-center gap-2">
                                        <span class="font-bold text-xs text-slate-900 dark:text-slate-100">@s.UnidadDidacticaNombre</span>
                                        @if (s.Estado == "CERRADA")
                                        {
                                            <span class="badge badge-success badge-xs font-semibold text-white">Cerrada</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-warning badge-xs font-semibold text-white">Abierta</span>
                                        }
                                    </div>
                                    <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">
                                        Docente: @s.DocenteNombreCompleto • @(s.AulaCodigo ?? "Lab") • @s.HoraInicio.ToString(@"hh\:mm") a @s.HoraFin.ToString(@"hh\:mm")
                                    </p>
                                </div>
                            </div>
                            <a href="/Modulo02/TomarAsistencia/@s.Id" class="btn btn-primary btn-xs rounded-xl text-xs font-bold">
                                @(s.Estado == "CERRADA" ? "Ver Lista" : "Tomar Lista")
                            </a>
                        </div>
                    }
                }
                else
                {
                    <div class="p-6 text-center text-xs text-slate-400">
                        No hay sesiones registradas hoy.
                    </div>
                }
            </div>
        </div>

        <div class="space-y-3">
            <h2 class="text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider">
                Alertas DPI (30%)
            </h2>

            <div class="bg-white dark:bg-[#111827] rounded-2xl border border-slate-200/80 dark:border-slate-800 shadow-sm p-4 space-y-3">
                @if (Model.CasosCriticosDpi.Any())
                {
                    @foreach (var c in Model.CasosCriticosDpi)
                    {
                        <div class="p-2.5 rounded-xl bg-rose-50/50 dark:bg-rose-950/20 border border-rose-100 dark:border-rose-900/40 flex items-center justify-between text-xs">
                            <div>
                                <p class="font-bold text-slate-800 dark:text-slate-200">@c.EstudianteNombre</p>
                                <p class="text-[10px] text-slate-400">@c.UnidadDidacticaNombre</p>
                            </div>
                            <span class="badge badge-error badge-xs font-bold text-white">@c.PorcentajeInasistencia%</span>
                        </div>
                    }
                }
                else
                {
                    <p class="text-xs text-slate-400 text-center py-2">
                        ✅ Ningún alumno en riesgo DPI.
                    </p>
                }
            </div>
        </div>
    </div>
</div>
