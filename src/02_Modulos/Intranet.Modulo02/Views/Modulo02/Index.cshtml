@model Intranet.Modulo02.Models.DashboardAsistenciaViewModel
@{
    ViewData["Title"] = "02. Control de Asistencia & Prevención DPI";
}

<div class="space-y-6">
    <!-- Header Zen del Módulo -->
    <div class="bg-white dark:bg-[#111827] rounded-3xl p-6 border border-slate-200/80 dark:border-slate-800 shadow-sm flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-2xl bg-indigo-50 dark:bg-indigo-950/50 text-indigo-600 dark:text-indigo-400 flex items-center justify-center text-xl shrink-0 font-bold">
                📅
            </div>
            <div>
                <div class="flex items-center gap-2 mb-1">
                    <span class="text-[10px] font-mono font-bold bg-indigo-100 dark:bg-indigo-950 text-indigo-800 dark:text-indigo-300 px-2 py-0.5 rounded">02</span>
                    <span class="text-xs font-bold text-indigo-700 dark:text-indigo-300 bg-indigo-50 dark:bg-indigo-900/40 px-2 py-0.5 rounded-md border border-indigo-200 dark:border-indigo-800">🏛️ IESTP "Argentina" — Ley 30512 & MPA 2024</span>
                </div>
                <h1 class="text-lg sm:text-xl font-black text-slate-900 dark:text-slate-100 tracking-tight">
                    Control de Asistencia & Prevención de Deserción DPI
                </h1>
                <p class="text-xs text-slate-500 dark:text-slate-400">
                    Sábana de 18 semanas, toma flash en 1 clic, atajos de teclado y sincronización con REGISTRA MINEDU.
                </p>
            </div>
        </div>
        <div class="flex flex-wrap gap-2">
            <a href="/Modulo02/MiAsistencia" class="btn btn-ghost btn-sm rounded-xl text-xs font-semibold">
                🛡️ Mi Asistencia (Alumno)
            </a>
            <a href="/Modulo02/Justificaciones" class="btn btn-ghost btn-sm rounded-xl text-xs font-semibold">
                📄 Justificaciones
                @if (Model.TotalJustificacionesPendientes > 0)
                {
                    <span class="badge badge-error badge-xs text-white font-bold">@Model.TotalJustificacionesPendientes</span>
                }
            </a>
            <a href="/Modulo02/ReportesDpi" class="btn bg-rose-600 hover:bg-rose-700 text-white btn-sm rounded-xl text-xs font-bold shadow-sm">
                🚨 Radar DPI (&ge;30%)
            </a>
        </div>
    </div>

    <!-- HERO CARD: DETECCIÓN DE CLASE ACTIVA HOY (EXPERIENCIA 1 CLIC) -->
    @if (Model.ClaseActivaHoy != null)
    {
        var ca = Model.ClaseActivaHoy;
        <div class="bg-gradient-to-r from-indigo-900 via-indigo-800 to-slate-900 text-white rounded-3xl p-6 sm:p-7 shadow-lg border border-indigo-700/50 flex flex-col md:flex-row justify-between items-start md:items-center gap-5 relative overflow-hidden">
            <div class="space-y-2 relative z-10">
                <div class="flex flex-wrap items-center gap-2">
                    <span class="badge bg-emerald-500 text-white font-black text-[10px] px-2.5 py-1 tracking-wider uppercase animate-pulse border-0">
                        ⚡ Clase Activa Hoy
                    </span>
                    <span class="text-xs font-mono bg-indigo-950/80 text-indigo-200 px-2 py-0.5 rounded border border-indigo-700/60">
                        @ca.UnidadDidacticaCodigo
                    </span>
                    <span class="text-xs text-indigo-200">
                        Semana @ca.NumeroSemana • @ca.Ciclo @ca.Turno (Secc @ca.Seccion)
                    </span>
                    <span class="text-xs font-bold bg-indigo-700/80 text-white px-2 py-0.5 rounded">
                        🏫 @ca.AulaCodigo
                    </span>
                </div>
                <h2 class="text-xl sm:text-2xl font-black tracking-tight text-white">
                    @ca.UnidadDidacticaNombre
                </h2>
                <p class="text-xs text-indigo-200/90 flex items-center gap-2">
                    <span>⏰ Horario: <strong>@ca.HoraInicio.ToString(@"hh\:mm") – @ca.HoraFin.ToString(@"hh\:mm")</strong></span>
                    <span>•</span>
                    <span>👥 Nómina: <strong>@ca.TotalAlumnos alumnos</strong></span>
                    <span>•</span>
                    <span>Estado: <strong class="text-emerald-300">@ca.EstadoSesion</strong></span>
                </p>
            </div>

            <div class="flex flex-wrap items-center gap-3 relative z-10 w-full md:w-auto">
                <a href="/Modulo02/TomarAsistencia/@ca.SesionId" class="btn bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-black text-sm px-6 rounded-2xl border-0 shadow-xl transition transform hover:scale-105 w-full md:w-auto flex items-center justify-center gap-2">
                    <span>⚡ Tomar Asistencia Ahora (1 Clic)</span>
                </a>
                <a href="/Modulo02/Matriz/@ca.ClaseDocenteId" class="btn bg-indigo-950/80 hover:bg-indigo-900 text-indigo-100 font-bold text-xs px-4 rounded-2xl border border-indigo-600/60 w-full md:w-auto">
                    📊 Ver Sábana 18 Sem
                </a>
            </div>
            
            <!-- Decoración Zen de fondo -->
            <div class="absolute -right-10 -bottom-10 w-48 h-48 bg-indigo-600/10 rounded-full blur-2xl pointer-events-none"></div>
        </div>
    }

    <!-- KPIs Indicadores Generales -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white dark:bg-[#111827] rounded-2xl p-4 border border-slate-200/80 dark:border-slate-800 shadow-sm">
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Cursos Asignados</span>
            <div class="text-xl font-bold text-indigo-600 dark:text-indigo-400 mt-1">@Model.TotalClasesAsignadas</div>
            <p class="text-[10px] text-slate-400 mt-0.5">Semestre 2026-I (18 semanas)</p>
        </div>
        <div class="bg-white dark:bg-[#111827] rounded-2xl p-4 border border-slate-200/80 dark:border-slate-800 shadow-sm">
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Sesiones Hoy</span>
            <div class="text-xl font-bold text-emerald-600 dark:text-emerald-400 mt-1">@Model.TotalSesionesHoy</div>
            <p class="text-[10px] text-slate-400 mt-0.5">Programadas</p>
        </div>
        <div class="bg-white dark:bg-[#111827] rounded-2xl p-4 border border-slate-200/80 dark:border-slate-800 shadow-sm">
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Alumnos en DPI</span>
            <div class="text-xl font-bold text-rose-600 dark:text-rose-400 mt-1 flex items-center gap-1.5">
                <span>@Model.TotalAlumnosDpi</span>
                <span class="text-[10px] font-semibold bg-rose-50 dark:bg-rose-950/50 text-rose-700 dark:text-rose-300 px-1.5 py-0.5 rounded">&ge;30% Faltas</span>
            </div>
            <p class="text-[10px] text-slate-400 mt-0.5">Inhabilitados para Recup. Sem 17</p>
        </div>
        <div class="bg-white dark:bg-[#111827] rounded-2xl p-4 border border-slate-200/80 dark:border-slate-800 shadow-sm">
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Justificaciones 72h</span>
            <div class="text-xl font-bold text-amber-600 dark:text-amber-400 mt-1">@Model.TotalJustificacionesPendientes</div>
            <p class="text-[10px] text-slate-400 mt-0.5">Por Evaluar</p>
        </div>
    </div>

    <!-- SECCIÓN 1: Mis Asignaturas Docente (Acceso a Sábana y Semanas) -->
    @if (Model.EsDocente || Model.MisClasesDocente.Any())
    {
        <div class="space-y-3">
            <div class="flex items-center justify-between">
                <h2 class="text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider">
                    Mis Asignaturas Asignadas
                </h2>
                <span class="text-[11px] text-indigo-600 dark:text-indigo-400 font-semibold">
                    Ciclo de 18 Semanas: Sem 1..16 Regular • Sem 17 Recuperación • Sem 18 Cierre
                </span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                @foreach (var clase in Model.MisClasesDocente)
                {
                    <div class="bg-white dark:bg-[#111827] rounded-2xl p-5 border border-slate-200/80 dark:border-slate-800 shadow-sm flex flex-col justify-between space-y-3 hover:shadow-md transition">
                        <div class="space-y-2">
                            <div class="flex items-center justify-between">
                                <span class="text-[10px] font-mono font-bold bg-indigo-50 dark:bg-indigo-950 text-indigo-700 dark:text-indigo-300 px-2 py-0.5 rounded">@clase.UnidadDidacticaCodigo</span>
                                <span class="text-[10px] text-slate-400">Ciclo @clase.Ciclo • @clase.Turno (Secc @clase.Seccion)</span>
                            </div>
                            <h3 class="font-bold text-xs text-slate-900 dark:text-slate-100 leading-snug">
                                @clase.UnidadDidacticaNombre
                            </h3>
                            <p class="text-[11px] text-slate-400">@clase.CarreraNombre • 🏫 @(clase.AulaCodigo ?? "LAB-401")</p>

                            <!-- Barra de Avance de las 18 Semanas -->
                            <div class="space-y-1 pt-1">
                                <div class="flex justify-between text-[11px] text-slate-500 dark:text-slate-400">
                                    <span>Avance Académico</span>
                                    <span class="font-mono font-bold">@clase.SemanasRegistradas / 18 sem</span>
                                </div>
                                <div class="w-full bg-slate-100 dark:bg-slate-800 h-2 rounded-full overflow-hidden flex">
                                    <div class="bg-indigo-600 h-full transition-all" style="width: @Math.Min(100, (clase.SemanasRegistradas * 100 / 18))%"></div>
                                </div>
                            </div>
                        </div>

                        <div class="pt-3 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between gap-2">
                            <a href="/Modulo02/Matriz/@clase.ClaseId" class="btn btn-ghost btn-xs text-slate-700 dark:text-slate-300 font-bold hover:bg-slate-100 dark:hover:bg-slate-800 rounded-lg">
                                📊 Sábana Live Grid
                            </a>
                            <a href="/Modulo02/Clase/@clase.ClaseId" class="btn bg-indigo-50 hover:bg-indigo-100 text-indigo-700 dark:bg-indigo-950/60 dark:text-indigo-300 btn-xs font-bold rounded-lg border border-indigo-200 dark:border-indigo-800">
                                18 Semanas →
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- SECCIÓN 2: Sesiones Recientes & Casos de Riesgo DPI -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
        <!-- Sesiones -->
        <div class="lg:col-span-2 space-y-3">
            <h2 class="text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider">
                Sesiones Dictadas & En Curso
            </h2>

            <div class="bg-white dark:bg-[#111827] rounded-2xl border border-slate-200/80 dark:border-slate-800 shadow-sm overflow-hidden divide-y divide-slate-100 dark:divide-slate-800">
                @if (Model.SesionesHoy.Any())
                {
                    @foreach (var s in Model.SesionesHoy)
                    {
                        <div class="p-4 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 hover:bg-slate-50/50 dark:hover:bg-slate-900/40 transition">
                            <div class="flex items-start gap-3">
                                <div class="w-9 h-9 rounded-xl bg-indigo-50 dark:bg-indigo-950/50 text-indigo-700 dark:text-indigo-300 flex flex-col items-center justify-center shrink-0 font-bold">
                                    <span class="text-[8px] uppercase">S</span>
                                    <span class="text-xs leading-none">@s.NumeroSemana</span>
                                </div>
                                <div>
                                    <div class="flex items-center gap-2">
                                        <span class="font-bold text-xs text-slate-900 dark:text-slate-100">@s.UnidadDidacticaNombre</span>
                                        @if (s.Estado == "CERRADA")
                                        {
                                            <span class="badge badge-success badge-xs font-semibold text-white">Oficializada</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-warning badge-xs font-semibold text-white animate-pulse">Abierta</span>
                                        }
                                    </div>
                                    <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">
                                        Docente: @s.DocenteNombreCompleto • @(s.AulaCodigo ?? "LAB-401") • @s.HoraInicio.ToString(@"hh\:mm") a @s.HoraFin.ToString(@"hh\:mm")
                                    </p>
                                </div>
                            </div>

                            <div class="flex items-center gap-2 w-full sm:w-auto justify-end">
                                <a href="/Modulo02/TomarAsistencia/@s.Id" class="btn bg-indigo-600 hover:bg-indigo-700 text-white btn-xs rounded-lg font-bold border-0 px-3">
                                    @(s.Estado == "CERRADA" ? "Ver Asistencia" : "Tomar Lista")
                                </a>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="p-6 text-center text-xs text-slate-400">
                        No hay sesiones registradas hoy.
                    </div>
                }
            </div>
        </div>

        <!-- Casos Críticos DPI -->
        <div class="space-y-3">
            <div class="flex items-center justify-between">
                <h2 class="text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider">
                    Radar DPI (&ge;20% Faltas)
                </h2>
                <a href="/Modulo02/ReportesDpi" class="text-[10px] text-indigo-600 font-bold hover:underline">Ver Todos</a>
            </div>

            <div class="bg-white dark:bg-[#111827] rounded-2xl border border-slate-200/80 dark:border-slate-800 shadow-sm p-4 space-y-3">
                @if (Model.CasosCriticosDpi.Any())
                {
                    @foreach (var c in Model.CasosCriticosDpi)
                    {
                        <div class="p-2.5 rounded-xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200/60 dark:border-slate-800 flex items-center justify-between gap-2 text-xs">
                            <div>
                                <p class="font-bold text-slate-900 dark:text-slate-100 text-[11px] leading-tight">@c.EstudianteNombre</p>
                                <p class="text-[10px] text-slate-400">@c.UnidadDidacticaNombre</p>
                            </div>
                            <div class="text-right shrink-0">
                                @if (c.PorcentajeInasistencia >= 30)
                                {
                                    <span class="badge badge-error badge-xs font-black text-white">DPI @c.PorcentajeInasistencia%</span>
                                    <span class="text-[9px] text-rose-600 font-bold block">Inhabilitado Sem 17</span>
                                }
                                else
                                {
                                    <span class="badge badge-warning badge-xs font-bold text-white">Riesgo @c.PorcentajeInasistencia%</span>
                                    <span class="text-[9px] text-amber-600 font-semibold block">Alerta temprana</span>
                                }
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-xs text-slate-400 text-center py-4">Cero estudiantes en condición crítica de DPI.</p>
                }
            </div>
        </div>
    </div>
</div>
