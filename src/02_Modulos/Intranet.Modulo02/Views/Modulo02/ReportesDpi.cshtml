@model IEnumerable<Intranet.Modulo02.Models.AlertaDpiDto>
@{
    ViewData["Title"] = "Radar Preventivo de Deserción & Casos DPI (30%)";
}

<div class="space-y-6 pb-20">
    <!-- Header -->
    <div class="bg-white dark:bg-[#111827] rounded-3xl p-6 sm:p-7 border border-slate-200/80 dark:border-slate-800 shadow-sm flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div class="flex items-center gap-4">
            <div class="w-14 h-14 rounded-2xl bg-rose-100 dark:bg-rose-950 text-rose-700 dark:text-rose-300 border border-rose-200 dark:border-rose-800 flex items-center justify-center shrink-0 shadow-sm font-bold text-2xl">
                🚨
            </div>
            <div>
                <div class="flex items-center gap-2 mb-1.5">
                    <span class="text-xs font-bold bg-rose-100 dark:bg-rose-950 text-rose-800 dark:text-rose-300 px-2.5 py-0.5 rounded-full border border-rose-200 dark:border-rose-800">Supervisión Académica y Dirección</span>
                    <span class="text-xs text-slate-400 font-medium">Límite 30% Inasistencias (Art. 8.8.1 MPA 2024)</span>
                </div>
                <h1 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-slate-100 tracking-tight">
                    Radar Preventivo de Deserción & Casos DPI
                </h1>
                <p class="text-xs text-slate-500 dark:text-slate-400">
                    Detección temprana de estudiantes en zona de riesgo (&ge;20%) e inhabilitados por DPI (&ge;30%) sin derecho a recuperación en Semana 17.
                </p>
            </div>
        </div>
        <div class="flex gap-2">
            <button onclick="window.print()" class="btn bg-white dark:bg-slate-800 hover:bg-slate-50 text-slate-700 dark:text-slate-200 btn-sm rounded-xl font-bold border border-slate-200 text-xs px-3.5 shadow-sm">
                🖨️ Imprimir Radar
            </button>
            <a href="/Modulo02" class="btn bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 text-slate-700 dark:text-slate-300 btn-sm rounded-xl font-bold border-0 text-xs px-3.5">
                Volver
            </a>
        </div>
    </div>

    <!-- Indicadores Resumen -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="bg-white dark:bg-[#111827] rounded-3xl p-5 border border-slate-200/80 dark:border-slate-800 shadow-sm">
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Total Alumnos en Riesgo / DPI</span>
            <div class="text-2xl font-black text-rose-600 dark:text-rose-400 mt-1">@Model.Count()</div>
            <p class="text-[10px] text-slate-400 mt-0.5">Estudiantes detectados por el algoritmo</p>
        </div>
        <div class="bg-white dark:bg-[#111827] rounded-3xl p-5 border border-slate-200/80 dark:border-slate-800 shadow-sm">
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Condición DPI Oficial (&ge;30%)</span>
            <div class="text-2xl font-black text-rose-700 dark:text-rose-500 mt-1">@Model.Count(x => x.SemaforoEstado == "DPI")</div>
            <p class="text-[10px] text-rose-600 font-bold mt-0.5">Inhabilitados para Semana 17 (Nota 00)</p>
        </div>
        <div class="bg-white dark:bg-[#111827] rounded-3xl p-5 border border-slate-200/80 dark:border-slate-800 shadow-sm">
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Zona de Alerta Temprana (10% – 29%)</span>
            <div class="text-2xl font-black text-amber-600 dark:text-amber-400 mt-1">@Model.Count(x => x.SemaforoEstado != "DPI")</div>
            <p class="text-[10px] text-amber-600 font-bold mt-0.5">Derivables a tutoría y prevención</p>
        </div>
    </div>

    <!-- Barra de Búsqueda y Filtros de Carrera -->
    <div class="bg-white dark:bg-[#111827] p-4 rounded-3xl border border-slate-200/80 dark:border-slate-800 shadow-sm flex flex-col sm:flex-row items-center justify-between gap-4">
        <input type="text" id="inputBuscarRadar" placeholder="🔍 Buscar estudiante, DNI o curso..." onkeyup="filtrarRadar()" class="input input-xs input-bordered w-full sm:w-72 rounded-xl text-xs bg-slate-50 dark:bg-slate-900" />

        <div class="flex items-center gap-2">
            <select id="selectFiltroCarrera" onchange="filtrarRadar()" class="select select-xs select-bordered rounded-xl text-xs bg-slate-50 dark:bg-slate-900">
                <option value="TODAS">Todas las Carreras</option>
                <option value="SISTEMAS">Desarrollo de Sistemas (DSI)</option>
                <option value="CONTABILIDAD">Contabilidad (CONT)</option>
                <option value="ADMINISTRACION">Administración (ADM)</option>
            </select>
        </div>
    </div>

    <!-- Tabla de Casos -->
    <div class="bg-white dark:bg-[#111827] rounded-3xl border border-slate-200/80 dark:border-slate-800 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="table w-full text-xs" id="tablaRadarDpi">
                <thead>
                    <tr class="bg-slate-100/80 dark:bg-slate-800 text-slate-600 dark:text-slate-300 font-bold uppercase text-[10px] tracking-wider">
                        <th>Estudiante</th>
                        <th>Carrera / Ciclo / Turno</th>
                        <th>Unidad Didáctica</th>
                        <th>Docente Asignado</th>
                        <th class="text-center">Horas Falta / Total</th>
                        <th class="text-center">% Inasistencia</th>
                        <th class="text-center">Estado Oficial</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                    @if (Model.Any())
                    {
                        @foreach (var c in Model)
                        {
                            <tr class="hover:bg-slate-50 dark:hover:bg-slate-900/50 transition fila-radar" data-estudiante="@c.EstudianteNombre.ToLower()" data-codigo="@c.EstudianteCodigo" data-carrera="@c.CarreraNombre.ToLower()" data-curso="@c.UnidadDidacticaNombre.ToLower()">
                                <td>
                                    <p class="font-bold text-slate-900 dark:text-slate-100">@c.EstudianteNombre</p>
                                    <span class="text-[10px] font-mono text-slate-400">@c.EstudianteCodigo</span>
                                </td>
                                <td>
                                    <p class="font-semibold text-slate-800 dark:text-slate-200">@c.CarreraNombre</p>
                                    <span class="text-[10px] text-slate-500">Ciclo @c.Ciclo • @c.Turno</span>
                                </td>
                                <td>
                                    <p class="font-semibold text-slate-800 dark:text-slate-200">@c.UnidadDidacticaNombre</p>
                                </td>
                                <td class="text-slate-600 dark:text-slate-400">@c.DocenteNombre</td>
                                <td class="text-center font-mono font-bold">
                                    <span class="text-rose-600">@c.HorasFalta hrs</span> / <span class="text-slate-400">@c.TotalHoras hrs</span>
                                </td>
                                <td class="text-center">
                                    <div class="font-black text-xs @(c.PorcentajeInasistencia >= 30 ? "text-rose-600 dark:text-rose-400" : "text-amber-600 dark:text-amber-400")">
                                        @c.PorcentajeInasistencia%
                                    </div>
                                </td>
                                <td class="text-center">
                                    @if (c.SemaforoEstado == "DPI")
                                    {
                                        <span class="badge badge-error badge-sm font-black text-white shadow-xs">
                                            🚨 DPI (Nota 00 - Sin Recup)
                                        </span>
                                    }
                                    else if (c.SemaforoEstado == "RIESGO_ALTO")
                                    {
                                        <span class="badge badge-warning badge-sm font-bold text-white shadow-xs">
                                            ⚠️ Riesgo Alto (&ge;20%)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-amber-100 dark:bg-amber-950 text-amber-800 dark:text-amber-300 border border-amber-200 dark:border-amber-800 badge-sm font-semibold">
                                            Alerta Preventiva
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="p-8 text-center text-xs text-slate-400">
                                ✅ No se registran estudiantes en riesgo crítico de inasistencia en este momento.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    function filtrarRadar() {
        const texto = document.getElementById('inputBuscarRadar').value.toLowerCase().trim();
        const carrera = document.getElementById('selectFiltroCarrera').value;

        document.querySelectorAll('#tablaRadarDpi tbody tr.fila-radar').forEach(fila => {
            const estudiante = fila.getAttribute('data-estudiante') || '';
            const codigo = fila.getAttribute('data-codigo') || '';
            const curso = fila.getAttribute('data-curso') || '';
            const car = fila.getAttribute('data-carrera') || '';

            let matchTexto = !texto || estudiante.includes(texto) || codigo.includes(texto) || curso.includes(texto);
            let matchCarrera = true;

            if (carrera === 'SISTEMAS') matchCarrera = car.includes('sistema');
            else if (carrera === 'CONTABILIDAD') matchCarrera = car.includes('contab');
            else if (carrera === 'ADMINISTRACION') matchCarrera = car.includes('admin');

            fila.style.display = (matchTexto && matchCarrera) ? '' : 'none';
        });
    }
</script>
