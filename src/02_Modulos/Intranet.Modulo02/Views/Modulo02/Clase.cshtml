@model IEnumerable<Intranet.Modulo02.Models.SemanaSelectorDto>
@{
    var claseId = (int)ViewBag.ClaseId;
    var sesionEjemplo = (Intranet.Modulo02.Models.SesionClaseDto?)ViewBag.SesionEjemplo;
    var nombreCurso = sesionEjemplo?.UnidadDidacticaNombre ?? "Asignatura";
    var codigoCurso = sesionEjemplo?.UnidadDidacticaCodigo ?? "UD";
    var carrera = sesionEjemplo?.CarreraNombre ?? "Carrera";
    var turno = sesionEjemplo?.Turno ?? "Noche";
    var ciclo = sesionEjemplo?.Ciclo ?? "I";
    var docente = sesionEjemplo?.DocenteNombreCompleto ?? "Docente";
}

<div class="space-y-6">
    <!-- Header de la Clase -->
    <div class="bg-white rounded-3xl p-6 sm:p-7 border border-slate-200/80 shadow-sm flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
        <div class="flex items-start gap-4">
            <a href="/Modulo02" class="w-10 h-10 rounded-2xl bg-slate-100 hover:bg-slate-200 text-slate-700 flex items-center justify-center shrink-0 transition mt-1">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                </svg>
            </a>
            <div>
                <div class="flex flex-wrap items-center gap-2 mb-1">
                    <span class="text-xs font-bold bg-indigo-100 text-indigo-800 px-2.5 py-0.5 rounded-full border border-indigo-200">17 Semanas + Semana 18</span>
                    <span class="text-xs font-mono bg-slate-100 text-slate-600 px-2 py-0.5 rounded-lg">@codigoCurso</span>
                    <span class="text-xs font-bold bg-purple-50 text-purple-700 px-2 py-0.5 rounded-lg border border-purple-200">Ciclo @ciclo • @turno</span>
                    <span class="text-xs text-slate-400">@carrera</span>
                </div>
                <h1 class="text-xl sm:text-2xl font-extrabold text-slate-900 tracking-tight">
                    @nombreCurso
                </h1>
                <p class="text-xs text-slate-500 mt-0.5">
                    👨‍🏫 Docente: <strong>@docente</strong> • 📅 Periodo Lectivo 2026-I
                </p>
            </div>
        </div>

        <!-- Alternador de Vista (Semanas vs Sábana Excel) -->
        <div class="flex flex-wrap gap-2 w-full md:w-auto justify-end">
            <a href="/Modulo02/Matriz/@claseId" class="btn bg-white hover:bg-slate-50 text-slate-700 btn-sm rounded-xl font-bold border border-slate-200 text-xs px-4 shadow-sm flex items-center gap-2">
                <span>📊 Ver Sábana Excel (18 Sem)</span>
            </a>
            <a href="/Modulo02" class="btn bg-slate-100 hover:bg-slate-200 text-slate-700 btn-sm rounded-xl font-bold border-0 text-xs px-3">
                Volver
            </a>
        </div>
    </div>

    <!-- Navegación y Grid de las 18 Semanas Oficiales -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        @foreach (var sem in Model)
        {
            var esRecup = sem.EsRecuperacion;
            var tarjetaBorder = sem.EstadoSemana switch
            {
                "CERRADA" => "border-emerald-200/80 bg-white hover:border-emerald-300",
                "ABIERTA" => "border-indigo-400 bg-indigo-50/20 shadow-md",
                _ => esRecup ? "border-purple-200 bg-purple-50/10" : "border-slate-200 bg-white"
            };

            var badgeSemana = sem.EstadoSemana switch
            {
                "CERRADA" => "badge-success text-white font-bold",
                "ABIERTA" => "badge-warning text-white font-bold animate-pulse",
                _ => esRecup ? "badge-secondary text-white font-bold" : "badge-ghost text-slate-500"
            };

            <div class="rounded-3xl p-5 border @tarjetaBorder shadow-sm transition flex flex-col justify-between group">
                <div>
                    <!-- Header de Semana -->
                    <div class="flex justify-between items-start mb-3">
                        <div class="flex items-center gap-2.5">
                            <div class="w-10 h-10 rounded-2xl @(esRecup ? "bg-purple-100 text-purple-700" : (sem.EstadoSemana == "CERRADA" ? "bg-emerald-100 text-emerald-700" : "bg-indigo-100 text-indigo-700")) flex items-center justify-center font-extrabold text-sm shadow-inner">
                                @sem.NumeroSemana
                            </div>
                            <div>
                                <h3 class="font-extrabold text-sm text-slate-900 leading-tight">
                                    @(esRecup ? "Semana 18: Recuperación" : $"Semana {sem.NumeroSemana}")
                                </h3>
                                <span class="text-[11px] text-slate-400 font-medium">
                                    @(esRecup ? "Evaluación Extraordinaria (MPA 8.8.4)" : $"{sem.Sesiones.Count} sesión(es) programada(s)")
                                </span>
                            </div>
                        </div>
                        <span class="badge @badgeSemana badge-xs py-2 px-2.5">
                            @(esRecup && sem.EstadoSemana == "PROGRAMADA" ? "Recuperación" : sem.EstadoSemana)
                        </span>
                    </div>

                    <!-- Lista de Sesiones dentro de la semana -->
                    <div class="space-y-2 mt-3">
                        @if (sem.Sesiones.Any())
                        {
                            @foreach (var s in sem.Sesiones)
                            {
                                <div class="bg-slate-50/80 hover:bg-slate-100/80 p-3 rounded-2xl border border-slate-100 transition flex flex-col gap-1.5 text-xs">
                                    <div class="flex justify-between items-center font-semibold text-slate-700">
                                        <span class="flex items-center gap-1.5">
                                            <span>📅 @s.FechaClase.ToString("dd/MM/yyyy")</span>
                                            <span class="text-[10px] text-slate-400 font-normal">(@s.HoraInicio.ToString(@"hh\:mm") - @s.HoraFin.ToString(@"hh\:mm"))</span>
                                        </span>
                                        <span class="font-mono text-[11px] bg-slate-200/60 px-1.5 py-0.5 rounded text-slate-600">@s.HorasPedagogicas hrs</span>
                                    </div>

                                    @if (!string.IsNullOrEmpty(s.TemaDesarrollado))
                                    {
                                        <p class="text-[11px] text-slate-600 line-clamp-1 italic">
                                            📝 @s.TemaDesarrollado
                                        </p>
                                    }

                                    <!-- Métricas rápidas si está cerrada -->
                                    @if (s.Estado == "CERRADA")
                                    {
                                        <div class="flex items-center gap-2 text-[10px] font-bold pt-1 border-t border-slate-200/60">
                                            <span class="text-emerald-700">✓ @s.TotalPresentes Presentes</span>
                                            <span class="text-amber-700">⏱️ @s.TotalTardanzas Tardanzas</span>
                                            <span class="text-rose-700">❌ @s.TotalFaltas Faltas</span>
                                        </div>
                                    }

                                    <div class="pt-1 flex justify-end">
                                        <a href="/Modulo02/TomarAsistencia/@s.Id" class="btn @(s.Estado == "CERRADA" ? "btn-ghost text-indigo-700 hover:bg-indigo-50" : "bg-indigo-600 hover:bg-indigo-700 text-white") btn-xs rounded-lg font-bold border-0 px-3">
                                            @(s.Estado == "CERRADA" ? "Ver / Modificar Asistencia" : "⚡ Tomar Lista Ahora")
                                        </a>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="p-3 bg-slate-50/50 rounded-2xl text-center text-slate-400 text-[11px] italic">
                                Sesión programada según silabo.
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>
