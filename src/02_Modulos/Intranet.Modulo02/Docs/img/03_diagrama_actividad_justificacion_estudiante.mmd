flowchart LR
    subgraph Etapa1["👨‍🎓 ETAPA 1: SOLICITUD ESTUDIANTE"]
        A([Estudiante detecta falta]) --> B[Clic en '📎 Justificar']
        B --> C{¿Fecha <= 72h hábiles?}
        C -- No --> D[❌ Alerta: Plazo Extemporáneo Vencido]
        D --> D_Fin([Fin: No Admitida])
        C -- Sí --> E[Adjunta Certificado Médico / CITA]
        E --> F[Envía expediente -> Estado PENDIENTE]
    end

    subgraph Etapa2["👨‍🏫 ETAPA 2: EVALUACIÓN DOCENTE"]
        F --> G[Docente recibe alerta en bandeja]
        G --> H[Revisa documento adjunto]
        H --> I{¿Sustento Válido?}
        I -- No --> J[Marca RECHAZADA]
        J --> J_Fin([Fin: Mantiene Falta])
        I -- Sí --> K[Marca APROBADA]
    end

    subgraph Etapa3["⚡ ETAPA 3: RECLASIFICACIÓN & DPI"]
        K --> L[UPDATE asistencias estado='FALTA_JUSTIFICADA']
        L --> M[Recálculo automático en v_resumen_asistencia]
        M --> N[Disminuye % de Inasistencia del Estudiante]
        N --> N_Fin([🏁 Fin: Falta Regularizada])
    end