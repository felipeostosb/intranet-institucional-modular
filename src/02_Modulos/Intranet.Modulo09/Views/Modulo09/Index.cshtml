@model Intranet.Modulo09.Controllers.Modulo09DashboardViewModel
@{
    ViewData["Title"] = "09. Tesorería & Pagos";
}

<div class="space-y-6">
    <!-- Tabs del módulo (flujo por rol) -->
    <div class="tabs-modulo flex flex-wrap gap-1.5 mb-1 bg-slate-100 dark:bg-slate-800/60 rounded-2xl p-1.5 w-fit" data-modulo="09">
        <a href="/Modulo09" class="tab-link px-4 py-2 rounded-xl text-xs font-bold transition">Resumen</a>
        @if (Model.EsAlumno)
        {
            <a href="/Modulo09/Tramites" class="tab-link px-4 py-2 rounded-xl text-xs font-bold transition">Mis trámites</a>
            <a href="/Modulo09/Pagos" class="tab-link px-4 py-2 rounded-xl text-xs font-bold transition">Mis pagos</a>
        }
        else
        {
            <a href="/Modulo09/Tramites" class="tab-link px-4 py-2 rounded-xl text-xs font-bold transition">Mesa de trámites</a>
            <a href="/Modulo09/Pagos" class="tab-link px-4 py-2 rounded-xl text-xs font-bold transition">Bandeja de vouchers</a>
        }
    </div>
    <!-- Header Zen del Módulo (patrón del Módulo 02) -->
    <div class="bg-white dark:bg-[#111827] rounded-3xl p-6 border border-slate-200/80 dark:border-slate-800 shadow-sm flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-2xl bg-emerald-50 dark:bg-emerald-950/50 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-xl shrink-0">
                💰
            </div>
            <div>
                <div class="flex items-center gap-2 mb-1">
                    <span class="text-[10px] font-mono font-bold bg-emerald-100 dark:bg-emerald-950 text-emerald-800 dark:text-emerald-300 px-2 py-0.5 rounded">09</span>
                    <span class="text-xs font-bold text-emerald-700 dark:text-emerald-300 bg-emerald-50 dark:bg-emerald-900/40 px-2 py-0.5 rounded-md border border-emerald-200 dark:border-emerald-800">🗄️ Responsable BD: Ismael</span>
                </div>
                <h1 class="text-lg sm:text-xl font-black text-slate-900 dark:text-slate-100 tracking-tight">
                    Tesorería, Trámites TUPA & Pagos
                </h1>
                <p class="text-xs text-slate-500 dark:text-slate-400">
                    @if (User.IsInRole("Tesoreria") && !User.IsInRole("Admin"))
                    {
                        <span>Tu puesto: <strong>validación de vouchers</strong> (cotejo DRELM) y emisión de recibos de caja.</span>
                    }
                    else if (User.IsInRole("Secretaria") && !User.IsInRole("Admin"))
                    {
                        <span>Tu puesto: <strong>mesa de trámites TUPA</strong> — evaluar, observar, aprobar y entregar expedientes.</span>
                    }
                    else
                    {
                        <span>Cero Filas: trámites con requisitos, validación de vouchers y recibos de caja.</span>
                    }
                </p>
            </div>
        </div>
        <div class="flex flex-wrap gap-2">
            @if (Model.EsAlumno)
            {
                <a href="/Modulo09/Tramites" class="btn btn-primary btn-sm rounded-xl text-xs font-bold shadow-sm">📄 Mis Trámites</a>
                <a href="/Modulo09/Pagos" class="btn btn-outline btn-sm rounded-xl text-xs font-semibold">💳 Mis Pagos <span aria-hidden="true">↗</span></a>
            }
            else if (User.IsInRole("Tesoreria") && !User.IsInRole("Admin"))
            {
                <a href="/Modulo09/Pagos" class="btn btn-primary btn-sm rounded-xl text-xs font-bold shadow-sm">
                    🧾 Tu Bandeja de Vouchers
                    @if (Model.ResumenPagos.PorValidar > 0)
                    {
                        <span class="badge badge-error badge-xs text-white font-bold">@Model.ResumenPagos.PorValidar por validar</span>
                    }
                </a>
                <a href="/Modulo09/Tramites" class="btn btn-outline btn-sm rounded-xl text-xs font-semibold">🗂️ Mesa (consulta) <span aria-hidden="true">↗</span></a>
            }
            else if (User.IsInRole("Secretaria") && !User.IsInRole("Admin"))
            {
                <a href="/Modulo09/Tramites" class="btn btn-primary btn-sm rounded-xl text-xs font-bold shadow-sm">
                    🗂️ Tu Mesa de Trámites
                    @if (Model.TramitesPendientes > 0)
                    {
                        <span class="badge badge-error badge-xs text-white font-bold">@Model.TramitesPendientes en mesa</span>
                    }
                </a>
                <a href="/Modulo09/Pagos" class="btn btn-outline btn-sm rounded-xl text-xs font-semibold">🧾 Vouchers (consulta) <span aria-hidden="true">↗</span></a>
            }
            else
            {
                <a href="/Modulo09/Tramites" class="btn btn-outline btn-sm rounded-xl text-xs font-semibold">🗂️ Mesa de Trámites <span aria-hidden="true">↗</span></a>
                <a href="/Modulo09/Pagos" class="btn btn-outline btn-sm rounded-xl text-xs font-semibold">🧾 Bandeja de Vouchers <span aria-hidden="true">↗</span></a>
            }
        </div>
    </div>

    @if (Model.EsAlumno)
    {
    <!-- CTA del alumno: el flujo empieza en Mis trámites → Nuevo trámite (Cero Filas) -->
    <div class="bg-gradient-to-r from-emerald-500/10 via-sky-500/10 to-cyan-500/10 border border-emerald-200/70 dark:border-emerald-800/60 rounded-2xl p-5 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div>
            <h2 class="text-sm font-bold text-slate-900 dark:text-slate-100">Solicita tu trámite en línea</h2>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Constancias, carné y más — sin filas. Sube tu voucher (PDF) y sigue el estado aquí.</p>
        </div>
        <a href="/Modulo09/Tramites#nuevoTramite" class="btn btn-primary btn-sm rounded-xl text-xs font-bold shadow-sm whitespace-nowrap">Iniciar trámite</a>
    </div>
    }

@if (!Model.EsAlumno)
    {
    @if (Model.ResumenTesoreria != null)
    {
        var rt = Model.ResumenTesoreria;
        <!-- Panel de TESORERÍA (ámbar): vouchers y recaudación — SU puesto -->
        <div class="relative overflow-hidden bg-gradient-to-br from-amber-50 via-white to-orange-50 dark:from-amber-950/40 dark:via-[#111827] dark:to-orange-950/30 rounded-3xl border border-amber-200/80 dark:border-amber-800/60 p-5 shadow-sm">
            <div class="relative flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <div><div class="flex items-center gap-2 mb-1"><span class="w-2 h-2 rounded-full bg-amber-500"></span><span class="text-[10px] font-black uppercase tracking-[0.18em] text-amber-700 dark:text-amber-300">Puesto financiero</span></div><h2 class="text-base font-black text-slate-900 dark:text-slate-100">Centro de validación y caja</h2><p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Revisa vouchers pendientes y controla la recaudación validada.</p></div>
                <a href="/Modulo09/Pagos" class="btn btn-warning btn-sm rounded-xl text-xs font-bold shadow-sm whitespace-nowrap">Abrir bandeja <span aria-hidden="true">→</span></a>
            </div>
        </div>
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
            <div class="bg-white dark:bg-[#111827] rounded-2xl p-4 border border-amber-300/70 dark:border-amber-800/60 shadow-sm">
                <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">🧾 Vouchers por validar</span>
                <div class="text-xl font-bold @(rt.VouchersPendientes > 0 ? "text-rose-600 dark:text-rose-400" : "text-emerald-600 dark:text-emerald-400") mt-1">@rt.VouchersPendientes</div>
                <a class="inline-flex items-center gap-1 px-2 py-1 rounded-lg border border-primary/30 bg-primary/5 text-primary hover:bg-primary/10 transition text-[10px] font-bold" href="/Modulo09/Pagos">Abrir bandeja <span aria-hidden="true">↗</span></a>
            </div>
            <div class="bg-white dark:bg-[#111827] rounded-2xl p-4 border border-amber-300/70 dark:border-amber-800/60 shadow-sm">
                <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">↩️ Rechazados</span>
                <div class="text-xl font-bold @(rt.VouchersRechazados > 0 ? "text-amber-600 dark:text-amber-400" : "text-slate-600 dark:text-slate-300") mt-1">@rt.VouchersRechazados</div>
                <p class="text-[10px] text-slate-400 mt-0.5">el alumno debe re-subir</p>
            </div>
            <div class="bg-white dark:bg-[#111827] rounded-2xl p-4 border border-amber-300/70 dark:border-amber-800/60 shadow-sm">
                <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">✅ Validados hoy</span>
                <div class="text-xl font-bold text-emerald-600 dark:text-emerald-400 mt-1">@rt.VouchersValidadosHoy</div>
                <p class="text-[10px] text-slate-400 mt-0.5">recibos del día</p>
            </div>
            <div class="bg-white dark:bg-[#111827] rounded-2xl p-4 border border-amber-300/70 dark:border-amber-800/60 shadow-sm">
                <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">💰 Recaudado hoy</span>
                <div class="text-xl font-bold text-emerald-600 dark:text-emerald-400 mt-1 font-mono">S/ @rt.RecaudadoHoy.ToString("0.00")</div>
                <p class="text-[10px] text-slate-400 mt-0.5">período: S/ @rt.RecaudadoPeriodo.ToString("0.00") · @rt.RecibosValidados recibos</p>
            </div>
        </div>
        <!-- Recaudación por concepto (top 5, barras CSS) -->
        @if (rt.PorConcepto.Any())
        {
            var maxMonto = rt.PorConcepto.Max(c => c.Monto);
            <div class="bg-white dark:bg-[#111827] rounded-2xl border border-slate-200/80 dark:border-slate-800 shadow-sm p-5">
                <div class="flex justify-between items-center mb-4">
                    <h2 class="text-xs font-bold text-slate-800 dark:text-slate-200 uppercase tracking-wider">💰 Recaudación por concepto</h2>
                    <span class="text-[10px] text-slate-400">solo vouchers validados</span>
                </div>
                <div class="space-y-2.5">
                    @foreach (var c in rt.PorConcepto)
                    {
                        var pct = maxMonto > 0 ? (int)Math.Round((double)(c.Monto * 100 / maxMonto)) : 0;
                        <div class="flex items-center gap-2">
                            <span class="text-[10px] font-mono font-bold text-slate-500 dark:text-slate-400 w-12 shrink-0" title="@c.Nombre">@c.Codigo</span>
                            <div class="flex-1 h-3 bg-slate-100 dark:bg-slate-800 rounded-full overflow-hidden">
                                <div class="h-full bg-amber-500 rounded-full" style="width:@(pct)%"></div>
                            </div>
                            <span class="text-[10px] font-mono font-bold text-slate-600 dark:text-slate-300 w-20 text-right">S/ @c.Monto.ToString("0")</span>
                            <span class="text-[10px] text-slate-400 w-12 text-right">@c.Recibos rec.</span>
                        </div>
                    }
                </div>
            </div>
        }
    }
    else if (Model.ResumenSecretaria != null)
    {
        var rs = Model.ResumenSecretaria;
        <!-- Panel de SECRETARÍA (celeste): mesa de partes — SU puesto, cero finanzas -->
        <div class="relative overflow-hidden bg-gradient-to-br from-sky-50 via-white to-cyan-50 dark:from-sky-950/40 dark:via-[#111827] dark:to-cyan-950/30 rounded-3xl border border-sky-200/80 dark:border-sky-800/60 p-5 shadow-sm">
            <div class="relative flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <div><div class="flex items-center gap-2 mb-1"><span class="w-2 h-2 rounded-full bg-sky-500"></span><span class="text-[10px] font-black uppercase tracking-[0.18em] text-sky-700 dark:text-sky-300">Mesa de partes</span></div><h2 class="text-base font-black text-slate-900 dark:text-slate-100">Cola de atención TUPA</h2><p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Prioriza expedientes, corrige observaciones y entrega los aprobados.</p></div>
                <a href="/Modulo09/Tramites" class="btn btn-info btn-sm rounded-xl text-xs font-bold shadow-sm whitespace-nowrap">Abrir mesa de trámites <span aria-hidden="true">→</span></a>
            </div>
        </div>
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
            <div class="bg-white dark:bg-[#111827] rounded-2xl p-4 border border-sky-300/70 dark:border-sky-800/60 shadow-sm">
                <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">🗂️ En mesa</span>
                <div class="text-xl font-bold text-sky-600 dark:text-sky-400 mt-1">@rs.Recibidos</div>
                <a class="inline-flex items-center gap-1 px-2 py-1 rounded-lg border border-primary/30 bg-primary/5 text-primary hover:bg-primary/10 transition text-[10px] font-bold" href="/Modulo09/Tramites">Abrir mesa <span aria-hidden="true">↗</span></a>
            </div>
            <div class="bg-white dark:bg-[#111827] rounded-2xl p-4 border border-sky-300/70 dark:border-sky-800/60 shadow-sm">
                <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">🔍 En evaluación</span>
                <div class="text-xl font-bold text-amber-600 dark:text-amber-400 mt-1">@rs.EnEvaluacion</div>
                <p class="text-[10px] text-slate-400 mt-0.5">en revisión</p>
            </div>
            <div class="bg-white dark:bg-[#111827] rounded-2xl p-4 border border-sky-300/70 dark:border-sky-800/60 shadow-sm">
                <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">📦 Aprobados por entregar</span>
                <div class="text-xl font-bold @(rs.AprobadosPendientesEntrega > 0 ? "text-emerald-600 dark:text-emerald-400" : "text-slate-600 dark:text-slate-300") mt-1">@rs.AprobadosPendientesEntrega</div>
                <p class="text-[10px] text-slate-400 mt-0.5">listos para recoger</p>
            </div>
            <div class="bg-white dark:bg-[#111827] rounded-2xl p-4 border border-sky-300/70 dark:border-sky-800/60 shadow-sm">
                <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">⚠️ Observados</span>
                <div class="text-xl font-bold @(rs.Observados > 0 ? "text-rose-600 dark:text-rose-400" : "text-slate-600 dark:text-slate-300") mt-1">@rs.Observados</div>
                <p class="text-[10px] text-slate-400 mt-0.5">alumno debe corregir · @rs.Entregados entregados</p>
            </div>
        </div>
        <!-- Trámites por tipo (top 5, barras CSS) -->
        @if (rs.PorTipo.Any())
        {
            var maxCant = rs.PorTipo.Max(x => x.Cantidad);
            <div class="bg-white dark:bg-[#111827] rounded-2xl border border-slate-200/80 dark:border-slate-800 shadow-sm p-5">
                <div class="flex justify-between items-center mb-4">
                    <h2 class="text-xs font-bold text-slate-800 dark:text-slate-200 uppercase tracking-wider">🗂️ Trámites por tipo</h2>
                    <span class="text-[10px] text-slate-400">más solicitados</span>
                </div>
                <div class="space-y-2.5">
                    @foreach (var x in rs.PorTipo)
                    {
                        var pct = maxCant > 0 ? x.Cantidad * 100 / maxCant : 0;
                        <div class="flex items-center gap-2">
                            <span class="text-[10px] font-mono font-bold text-slate-500 dark:text-slate-400 w-12 shrink-0" title="@x.Nombre">@x.Codigo</span>
                            <div class="flex-1 h-3 bg-slate-100 dark:bg-slate-800 rounded-full overflow-hidden">
                                <div class="h-full bg-sky-500 rounded-full" style="width:@(pct)%"></div>
                            </div>
                            <span class="text-[10px] font-mono font-bold text-slate-600 dark:text-slate-300 w-8 text-right">@x.Cantidad</span>
                        </div>
                    }
                </div>
            </div>
        }
    }
    else
    {
    <!-- Indicadores operativos (staff) — el alumno no ve la operación interna -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white dark:bg-[#111827] rounded-2xl p-4 border border-slate-200/80 dark:border-slate-800 shadow-sm">
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Trámites en mesa</span>
            <div class="text-xl font-bold text-amber-600 dark:text-amber-400 mt-1">@Model.TramitesPendientes</div>
            <p class="text-[10px] text-slate-400 mt-0.5">Recibidos / en evaluación</p>
        </div>
        <div class="bg-white dark:bg-[#111827] rounded-2xl p-4 border border-slate-200/80 dark:border-slate-800 shadow-sm">
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Vouchers por validar</span>
            <div class="text-xl font-bold text-rose-600 dark:text-rose-400 mt-1">@Model.ResumenPagos.PorValidar</div>
            <p class="text-[10px] text-slate-400 mt-0.5">en la bandeja</p>
        </div>
        <div class="bg-white dark:bg-[#111827] rounded-2xl p-4 border border-slate-200/80 dark:border-slate-800 shadow-sm">
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Recaudación validada</span>
            <div class="text-xl font-bold text-emerald-600 dark:text-emerald-400 mt-1 font-mono">S/ @Model.ResumenPagos.Recaudado.ToString("0.00")</div>
            <p class="text-[10px] text-slate-400 mt-0.5">@Model.ResumenPagos.Validados recibos validados</p>
        </div>
        <div class="bg-white dark:bg-[#111827] rounded-2xl p-4 border border-slate-200/80 dark:border-slate-800 shadow-sm">
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Esquema & DBA</span>
            <div class="text-xl font-bold text-slate-900 dark:text-slate-100 font-mono mt-1">mod09</div>
            <p class="text-[10px] text-emerald-600 dark:text-emerald-400 font-semibold mt-0.5">DBA: Ismael</p>
        </div>
    </div>
    }
    }

    @if (Model.EsAlumno)
    {
        @if (Model.ResumenAlumno != null)
        {
            var ra = Model.ResumenAlumno;
            <!-- Indicadores personales del alumno (sus datos, no cifras del instituto) -->
            <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
                <div class="col-span-2 lg:col-span-1 relative overflow-hidden bg-gradient-to-br from-emerald-600 to-teal-600 rounded-2xl p-4 text-white shadow-sm">
                    <span class="relative text-[10px] font-bold uppercase tracking-wider text-emerald-100 block">Mi actividad</span>
                    <div class="relative text-4xl font-black mt-2">@ra.TramitesActivos</div>
                    <p class="relative text-[10px] text-emerald-100 mt-1">trámites en curso</p>
                </div>
                <div class="bg-white dark:bg-[#111827] rounded-2xl p-4 border border-slate-200/80 dark:border-slate-800 shadow-sm">
                    <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Requieren tu acción</span>
                    <div class="text-xl font-bold @(ra.TramitesObservados > 0 ? "text-rose-600 dark:text-rose-400" : "text-emerald-600 dark:text-emerald-400") mt-1">@ra.TramitesObservados</div>
                    <p class="text-[10px] text-slate-400 mt-0.5">observados — corrige y vuelve a subir</p>
                </div>
                <div class="bg-white dark:bg-[#111827] rounded-2xl p-4 border border-slate-200/80 dark:border-slate-800 shadow-sm">
                    <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Vouchers por subir</span>
                    <div class="text-xl font-bold @(ra.VouchersPorSubir > 0 ? "text-amber-600 dark:text-amber-400" : "text-emerald-600 dark:text-emerald-400") mt-1">@ra.VouchersPorSubir</div>
                    <p class="text-[10px] text-slate-400 mt-0.5"><a class="inline-flex items-center gap-1 px-2 py-1 rounded-lg border border-primary/30 bg-primary/5 text-primary hover:bg-primary/10 transition font-bold" href="/Modulo09/Pagos">Subir voucher <span aria-hidden="true">↗</span></a></p>
                </div>
                <div class="bg-white dark:bg-[#111827] rounded-2xl p-4 border border-slate-200/80 dark:border-slate-800 shadow-sm">
                    <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Total pagado</span>
                    <div class="text-xl font-bold text-emerald-600 dark:text-emerald-400 mt-1 font-mono">S/ @ra.TotalPagado.ToString("0.00")</div>
                    <p class="text-[10px] text-slate-400 mt-0.5">vouchers validados · @ra.TramitesCerrados trámites cerrados</p>
                </div>
            </div>
        }
        <!-- Tu flujo (estudiante): trámites con estado + acceso a pagos -->
        <div class="bg-white dark:bg-[#111827] rounded-2xl border border-slate-200/80 dark:border-slate-800 shadow-sm p-5">
            <div class="flex justify-between items-center mb-3">
                <h2 class="text-xs font-bold text-slate-800 dark:text-slate-200 uppercase tracking-wider">📄 Mis trámites</h2>
                <a href="/Modulo09/Tramites" class="btn btn-outline btn-xs rounded-lg text-[10px] font-bold">Abrir mis trámites <span aria-hidden="true">↗</span></a>
            </div>
            <div class="space-y-2">
                @if (!Model.UltimosTramites.Any())
                {
                    <p class="text-xs text-slate-400 italic">Sin trámites aún. <a class="inline-flex items-center gap-1 px-2 py-1 rounded-lg border border-primary/30 bg-primary/5 text-primary hover:bg-primary/10 transition font-bold" href="/Modulo09/Tramites#nuevoTramite">Iniciar trámite <span aria-hidden="true">↗</span></a></p>
                }
                @foreach (var t in Model.UltimosTramites)
                {
                    <div class="flex items-center justify-between gap-2 text-xs">
                        <span class="font-mono font-bold text-emerald-600 dark:text-emerald-400">@t.Codigo</span>
                        <span class="flex-1 truncate text-slate-600 dark:text-slate-300">@t.TipoCodigo · @t.TipoNombre</span>
                        <span class="badge @(t.Estado == "Aprobado" || t.Estado == "Entregado" ? "badge-success" : t.Estado == "Observado" ? "badge-error" : "badge-warning") badge-xs font-semibold text-white">@t.Estado</span>
                        <a class="btn btn-outline btn-xs rounded-lg font-bold" href="/Modulo09/Tramites/Detalle/@t.Id"><span aria-hidden="true">↗</span> Abrir ficha</a>
                    </div>
                }
            </div>
            <p class="text-[11px] text-slate-400 mt-3">Los recibos de cada trámite están en <a class="inline-flex items-center gap-1 px-2 py-1 rounded-lg border border-success/30 bg-success/5 text-success hover:bg-success/10 transition font-bold" href="/Modulo09/Pagos">Mis pagos <span aria-hidden="true">↗</span></a>.</p>
        </div>
    }
    else
    {
        <!-- Sección personal -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
            <div class="bg-white dark:bg-[#111827] rounded-2xl border border-slate-200/80 dark:border-slate-800 shadow-sm p-5">
                <div class="flex justify-between items-center mb-3">
                    <h2 class="text-xs font-bold text-slate-800 dark:text-slate-200 uppercase tracking-wider">🗂️ Últimos trámites recibidos</h2>
                    <a href="/Modulo09/Tramites" class="btn btn-outline btn-xs rounded-lg text-[10px] font-bold">Abrir mesa <span aria-hidden="true">↗</span></a>
                </div>
                <div class="space-y-2">
                    @if (!Model.UltimosTramites.Any())
                    {
                        <p class="text-xs text-slate-400 italic">Sin trámites todavía.</p>
                    }
                    @foreach (var t in Model.UltimosTramites)
                    {
                        <div class="flex items-center justify-between gap-2 text-xs">
                            <span class="font-mono font-bold text-emerald-600 dark:text-emerald-400">@t.Codigo</span>
                            <span class="flex-1 truncate text-slate-600 dark:text-slate-300">@t.Estudiante · @t.TipoCodigo</span>
                            <span class="text-slate-400 font-mono text-[10px]">@t.FechaSolicitud.ToString("dd/MM")</span>
                            <span class="badge @(t.Estado == "Aprobado" || t.Estado == "Entregado" ? "badge-success" : t.Estado == "Rechazado" ? "badge-error" : "badge-warning") badge-xs font-semibold text-white">@t.Estado</span>
                        </div>
                    }
                </div>
            </div>
            <div class="bg-white dark:bg-[#111827] rounded-2xl border border-slate-200/80 dark:border-slate-800 shadow-sm p-5">
                <div class="flex justify-between items-center mb-3">
                    <h2 class="text-xs font-bold text-slate-800 dark:text-slate-200 uppercase tracking-wider">🧾 Últimos vouchers</h2>
                    <a href="/Modulo09/Pagos" class="btn btn-outline btn-xs rounded-lg text-[10px] font-bold">Abrir bandeja <span aria-hidden="true">↗</span></a>
                </div>
                <div class="space-y-2">
                    @if (!Model.UltimosPagos.Any())
                    {
                        <p class="text-xs text-slate-400 italic">Sin pagos registrados.</p>
                    }
                    @foreach (var p in Model.UltimosPagos)
                    {
                        <div class="flex items-center justify-between gap-2 text-xs">
                            <span class="font-mono font-bold text-emerald-600 dark:text-emerald-400">@p.Codigo</span>
                            <span class="flex-1 truncate text-slate-600 dark:text-slate-300">@p.Estudiante · S/ @p.Monto.ToString("0.00")</span>
                            <span class="badge @(p.VoucherEstado == "Validado" ? "badge-success" : p.VoucherEstado == "Rechazado" ? "badge-error" : "badge-warning") badge-xs font-semibold text-white">@p.VoucherEstado</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <!-- Pie de módulo -->
    <p class="text-[10px] text-slate-400 text-center">
        Módulo 09 · Esquema PostgreSQL <span class="font-mono">mod09</span> · Aislamiento Zero-Blast-Radius
    </p>
</div>

