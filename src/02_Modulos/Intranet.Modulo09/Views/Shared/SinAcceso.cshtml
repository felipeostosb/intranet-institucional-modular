@{
    ViewData["Title"] = "09. Trámites y Pagos";
    var rolActivo = User.FindFirst("ActiveRole")?.Value ?? "Alumno";
}
<section class="min-h-[60vh] flex items-center justify-center px-4">
    <div class="max-w-lg w-full text-center">
        <div class="mx-auto w-16 h-16 rounded-2xl bg-amber-100 dark:bg-amber-500/10 flex items-center justify-center mb-6">
            <svg class="w-8 h-8 text-amber-600 dark:text-amber-400" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z"/>
            </svg>
        </div>
        <h1 class="text-2xl font-bold text-gray-900 dark:text-white mb-3">Este módulo no es para tu rol actual</h1>
        <p class="text-gray-600 dark:text-gray-400 mb-2">
            Estás navegando con el rol <strong class="text-gray-900 dark:text-white">@rolActivo</strong>,
            que no tiene funciones en <strong>Trámites y Pagos</strong>.
        </p>
        <p class="text-gray-500 dark:text-gray-500 text-sm mb-8">
            Aquí se gestionan trámites TUPA, recibos y vouchers: estudiantes, Secretaría y Tesorería.
            Si necesitas operar aquí, cambia tu rol activo en el selector superior.
        </p>
        <a href="/Dashboard" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-gray-900 text-white text-sm font-medium hover:bg-gray-700 dark:bg-white dark:text-gray-900 dark:hover:bg-gray-200 transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18"/>
            </svg>
            Volver al inicio
        </a>
    </div>
</section>
