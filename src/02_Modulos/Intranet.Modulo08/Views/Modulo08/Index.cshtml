@{
    ViewData["Title"] = "08. Login, Seguridad & Roles";
}

<div class="space-y-6">
    <!-- Header Zen del Módulo -->
    <div class="bg-white dark:bg-[#111827] rounded-3xl p-6 border border-slate-200/80 dark:border-slate-800 shadow-sm flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-2xl bg-orange-50 dark:bg-orange-950/50 text-orange-600 dark:text-orange-400 flex items-center justify-center text-xl shrink-0">
                🔐
            </div>
            <div>
                <div class="flex items-center gap-2 mb-1">
                    <span class="text-[10px] font-mono font-bold bg-orange-100 dark:bg-orange-950 text-orange-800 dark:text-orange-300 px-2 py-0.5 rounded">08</span>
                    <span class="text-xs font-bold text-orange-700 dark:text-orange-300 bg-orange-50 dark:bg-orange-900/40 px-2 py-0.5 rounded-md border border-orange-200 dark:border-orange-800">🗄️ Responsable BD: Toro</span>
                </div>
                <h1 class="text-lg sm:text-xl font-black text-slate-900 dark:text-slate-100 tracking-tight">
                    Login, Seguridad & Gestión de Accesos
                </h1>
                <p class="text-xs text-slate-500 dark:text-slate-400">
                    Gestión de credenciales de usuario, políticas de acceso RBAC, auditoría de ingresos y seguridad perimetral.
                </p>
            </div>
        </div>
        <div class="flex gap-2">
            <button class="btn btn-primary btn-sm rounded-xl text-xs font-bold" onclick="modal_nuevo_08.showModal()">
                + Nueva Política
            </button>
        </div>
    </div>

    <!-- Indicadores -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white dark:bg-[#111827] rounded-2xl p-4 border border-slate-200/80 dark:border-slate-800 shadow-sm">
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Sesiones Activas</span>
            <div class="text-xl font-bold text-orange-600 dark:text-orange-400 mt-1">128</div>
            <p class="text-[10px] text-slate-400 mt-0.5">En la Intranet</p>
        </div>
        <div class="bg-white dark:bg-[#111827] rounded-2xl p-4 border border-slate-200/80 dark:border-slate-800 shadow-sm">
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Intentos Bloqueados</span>
            <div class="text-xl font-bold text-slate-900 dark:text-slate-100 mt-1 font-mono">12</div>
            <p class="text-[10px] text-slate-400 mt-0.5">Anti-Fuerza Bruta</p>
        </div>
        <div class="bg-white dark:bg-[#111827] rounded-2xl p-4 border border-slate-200/80 dark:border-slate-800 shadow-sm">
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Esquema & DBA</span>
            <div class="text-xl font-bold text-slate-900 dark:text-slate-100 font-mono mt-1">mod08</div>
            <p class="text-[10px] text-orange-600 dark:text-orange-400 font-semibold mt-0.5">DBA: Toro</p>
        </div>
        <div class="bg-white dark:bg-[#111827] rounded-2xl p-4 border border-slate-200/80 dark:border-slate-800 shadow-sm">
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Usuario Activo</span>
            <div class="text-sm font-bold text-slate-800 dark:text-slate-200 mt-1 truncate">@ViewData["UsuarioNombre"]</div>
            <p class="text-[10px] text-slate-400 mt-0.5">Rol: @ViewData["UsuarioRol"]</p>
        </div>
    </div>

    <!-- Listado Zen de Logs -->
    <div class="bg-white dark:bg-[#111827] rounded-2xl border border-slate-200/80 dark:border-slate-800 shadow-sm overflow-hidden">
        <div class="p-4 border-b border-slate-100 dark:border-slate-800 flex justify-between items-center">
            <h2 class="text-xs font-bold text-slate-800 dark:text-slate-200 uppercase tracking-wider">
                Auditoría de Accesos Recientes
            </h2>
        </div>
        <div class="overflow-x-auto">
            <table class="table table-zebra w-full text-xs">
                <thead>
                    <tr class="text-slate-400 dark:text-slate-500 uppercase text-[10px]">
                        <th>Identificador</th>
                        <th>IP / Origen</th>
                        <th>Rol Asignado</th>
                        <th>Evento</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody class="text-slate-700 dark:text-slate-300">
                    <tr>
                        <td class="font-mono font-bold text-orange-600 dark:text-orange-400">admin</td>
                        <td class="font-mono text-slate-500">192.168.1.45</td>
                        <td><span class="badge badge-neutral badge-xs">Director</span></td>
                        <td>Inicio de Sesión SSO</td>
                        <td><span class="badge badge-success badge-xs font-semibold text-white">Exitoso</span></td>
                    </tr>
                    <tr>
                        <td class="font-mono font-bold text-orange-600 dark:text-orange-400">docente</td>
                        <td class="font-mono text-slate-500">192.168.1.88</td>
                        <td><span class="badge badge-neutral badge-xs">Docente</span></td>
                        <td>Cambio de Contraseña</td>
                        <td><span class="badge badge-info badge-xs font-semibold text-white">Completado</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<dialog id="modal_nuevo_08" class="modal">
    <div class="modal-box max-w-md bg-white dark:bg-[#111827] text-slate-800 dark:text-slate-200 rounded-3xl p-6 border border-slate-200/80 dark:border-slate-800 shadow-2xl">
        <h3 class="text-sm font-bold mb-3">Registrar Política de Seguridad</h3>
        <div class="space-y-3 text-xs">
            <div>
                <label class="font-bold block mb-1 text-[11px]">Nombre de la Política</label>
                <input type="text" placeholder="Ej: Bloqueo tras 5 intentos fallidos" class="input input-xs input-bordered w-full rounded-xl dark:bg-slate-800 dark:border-slate-700 h-9" />
            </div>
            <div>
                <label class="font-bold block mb-1 text-[11px]">Parámetro / Tiempo (Minutos)</label>
                <input type="number" placeholder="15" class="input input-xs input-bordered w-full rounded-xl dark:bg-slate-800 dark:border-slate-700 h-9" />
            </div>
        </div>
        <div class="modal-action pt-2">
            <form method="dialog">
                <button class="btn btn-ghost btn-xs rounded-xl">Cancelar</button>
                <button class="btn btn-primary btn-xs rounded-xl font-bold">Guardar</button>
            </form>
        </div>
    </div>
</dialog>
