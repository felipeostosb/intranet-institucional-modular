                        <p class="font-bold text-xs text-slate-900 dark:text-slate-100 group-hover:text-indigo-900 dark:group-hover:text-indigo-300">Mi Asistencia</p>
                        <p class="text-[10px] text-slate-500 dark:text-slate-400">Horas restantes antes de DPI</p>
                    </div>
                </a>

                <a href="/Modulo01" class="p-3.5 rounded-2xl bg-sky-50/80 dark:bg-sky-950/40 hover:bg-sky-100 dark:hover:bg-sky-900/50 text-sky-900 dark:text-sky-200 border border-sky-200/80 dark:border-sky-900/50 transition group flex flex-col justify-between">
