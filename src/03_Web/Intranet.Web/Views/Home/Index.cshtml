                    </div>
                </a>

                <a href="/Modulo02/ReportesDpi" class="p-3.5 rounded-2xl bg-amber-50/80 dark:bg-amber-950/40 hover:bg-amber-100 dark:hover:bg-amber-900/50 text-amber-900 dark:text-amber-200 border border-amber-200/80 dark:border-amber-900/50 transition group flex flex-col justify-between">
