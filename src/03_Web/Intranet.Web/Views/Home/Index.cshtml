@{
    ViewData["Title"] = "Panel Principal";
    var rolPrincipal = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Alumno";
    var esDocenteODirector = User.IsInRole("Docente") || User.IsInRole("Director") || User.IsInRole("Admin") || User.IsInRole("Coordinador");
}

<div class="space-y-6">
    <!-- Header Zen de Bienvenida -->
    <div class="bg-gradient-to-r from-slate-900 via-blue-950 to-indigo-950 text-white rounded-3xl p-6 sm:p-8 border border-white/10 shadow-lg relative overflow-hidden">
        <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div class="space-y-1">
                <div class="flex items-center gap-2">
                    <span class="text-[11px] bg-cyan-400/20 text-cyan-200 border border-cyan-400/30 px-2.5 py-0.5 rounded-full font-bold">Periodo 2026-II</span>
                    <span class="text-xs text-slate-400">• IESTP "Argentina"</span>
                </div>
                <h1 class="text-2xl sm:text-3xl font-black tracking-tight text-white">
                    ¡Hola, @User.Identity?.Name! 👋
                </h1>
                <p class="text-xs sm:text-sm text-slate-300 max-w-xl">
                    Bienvenido al panel central de la Intranet Institucional.
                </p>
            </div>
            
            <div class="flex items-center gap-2 shrink-0">
                <span class="badge badge-primary text-xs font-bold px-3 py-2">
                    Rol: @rolPrincipal
                </span>
                <a href="/Docs" class="btn btn-sm btn-ghost bg-white/10 hover:bg-white/20 text-white rounded-xl text-xs font-semibold">
                    📚 Guías & Videos
                </a>
            </div>
        </div>
        <div class="absolute -right-10 -bottom-10 w-60 h-60 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none"></div>
    </div>

    <!-- Acciones Rápidas -->
    <div class="space-y-3">
        <h2 class="text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider">
            Acciones Frecuentes
        </h2>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
            @if (esDocenteODirector)
            {
                <a href="/Modulo02/TomarAsistencia" class="p-4 rounded-2xl bg-white dark:bg-[#111827] hover:bg-slate-50 dark:hover:bg-slate-800/80 border border-slate-200/80 dark:border-slate-800 shadow-sm transition group">
                    <div class="text-2xl mb-2">📋</div>
                    <p class="font-bold text-xs text-slate-900 dark:text-slate-100 group-hover:text-blue-600 dark:group-hover:text-cyan-400 transition">Tomar Asistencia</p>
                    <p class="text-[11px] text-slate-400 dark:text-slate-500 mt-0.5">Registro en 1 clic</p>
                </a>

                <a href="/Modulo02/Matriz" class="p-4 rounded-2xl bg-white dark:bg-[#111827] hover:bg-slate-50 dark:hover:bg-slate-800/80 border border-slate-200/80 dark:border-slate-800 shadow-sm transition group">
                    <div class="text-2xl mb-2">📊</div>
                    <p class="font-bold text-xs text-slate-900 dark:text-slate-100 group-hover:text-blue-600 dark:group-hover:text-cyan-400 transition">Matriz 18 Semanas</p>
                    <p class="text-[11px] text-slate-400 dark:text-slate-500 mt-0.5">Sábana de asistencia</p>
                </a>

                <a href="/Modulo02/ReportesDpi" class="p-4 rounded-2xl bg-white dark:bg-[#111827] hover:bg-slate-50 dark:hover:bg-slate-800/80 border border-slate-200/80 dark:border-slate-800 shadow-sm transition group">
                    <div class="text-2xl mb-2">⚠️</div>
                    <p class="font-bold text-xs text-slate-900 dark:text-slate-100 group-hover:text-blue-600 dark:group-hover:text-cyan-400 transition">Alertas DPI 30%</p>
                    <p class="text-[11px] text-slate-400 dark:text-slate-500 mt-0.5">Control de inasistencias</p>
                </a>

                <a href="/Modulo02/Justificaciones" class="p-4 rounded-2xl bg-white dark:bg-[#111827] hover:bg-slate-50 dark:hover:bg-slate-800/80 border border-slate-200/80 dark:border-slate-800 shadow-sm transition group">
                    <div class="text-2xl mb-2">📝</div>
                    <p class="font-bold text-xs text-slate-900 dark:text-slate-100 group-hover:text-blue-600 dark:group-hover:text-cyan-400 transition">Justificaciones</p>
                    <p class="text-[11px] text-slate-400 dark:text-slate-500 mt-0.5">Bandeja de solicitudes</p>
                </a>
            }
            else
            {
                <a href="/Modulo02/MiAsistencia" class="p-4 rounded-2xl bg-white dark:bg-[#111827] hover:bg-slate-50 dark:hover:bg-slate-800/80 border border-slate-200/80 dark:border-slate-800 shadow-sm transition group">
                    <div class="text-2xl mb-2">🎓</div>
                    <p class="font-bold text-xs text-slate-900 dark:text-slate-100 group-hover:text-blue-600 dark:group-hover:text-cyan-400 transition">Mi Asistencia</p>
                    <p class="text-[11px] text-slate-400 dark:text-slate-500 mt-0.5">Ver récord y faltas</p>
                </a>

                <a href="/Modulo01" class="p-4 rounded-2xl bg-white dark:bg-[#111827] hover:bg-slate-50 dark:hover:bg-slate-800/80 border border-slate-200/80 dark:border-slate-800 shadow-sm transition group">
                    <div class="text-2xl mb-2">📚</div>
                    <p class="font-bold text-xs text-slate-900 dark:text-slate-100 group-hover:text-blue-600 dark:group-hover:text-cyan-400 transition">Mi Matrícula</p>
                    <p class="text-[11px] text-slate-400 dark:text-slate-500 mt-0.5">Cursos inscritos</p>
                </a>

                <a href="/Modulo08" class="p-4 rounded-2xl bg-white dark:bg-[#111827] hover:bg-slate-50 dark:hover:bg-slate-800/80 border border-slate-200/80 dark:border-slate-800 shadow-sm transition group">
                    <div class="text-2xl mb-2">📋</div>
                    <p class="font-bold text-xs text-slate-900 dark:text-slate-100 group-hover:text-blue-600 dark:group-hover:text-cyan-400 transition">Encuestas</p>
                    <p class="text-[11px] text-slate-400 dark:text-slate-500 mt-0.5">Evaluación docente</p>
                </a>

                <a href="/Modulo09" class="p-4 rounded-2xl bg-white dark:bg-[#111827] hover:bg-slate-50 dark:hover:bg-slate-800/80 border border-slate-200/80 dark:border-slate-800 shadow-sm transition group">
                    <div class="text-2xl mb-2">💳</div>
                    <p class="font-bold text-xs text-slate-900 dark:text-slate-100 group-hover:text-blue-600 dark:group-hover:text-cyan-400 transition">Trámites TUPA</p>
                    <p class="text-[11px] text-slate-400 dark:text-slate-500 mt-0.5">Certificados y constancias</p>
                </a>
            }
        </div>
    </div>

    <!-- Módulos de la Plataforma -->
    <div class="space-y-3">
        <h2 class="text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider">
            Módulos del Sistema
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            <!-- Módulo 00 -->
            <a href="/Modulo00" class="p-5 rounded-2xl bg-white dark:bg-[#111827] hover:bg-slate-50 dark:hover:bg-slate-800/80 border border-slate-200/80 dark:border-slate-800 shadow-sm transition group flex flex-col justify-between">
                <div>
                    <div class="flex items-center justify-between mb-3">
                        <span class="text-xl">🛡️</span>
                        <span class="text-[10px] font-mono text-slate-400 font-semibold">00</span>
                    </div>
                    <h3 class="font-bold text-xs text-slate-900 dark:text-slate-100 group-hover:text-blue-600 dark:group-hover:text-cyan-400 transition">
                        00. Seguridad & Accesos
                    </h3>
                    <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-1">
                        Control central de credenciales, roles y auditoría.
                    </p>
                </div>
                <div class="mt-4 pt-2 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between text-[11px] text-slate-400 group-hover:text-blue-600 dark:group-hover:text-cyan-400">
                    <span>Ingresar</span>
                    <span>→</span>
                </div>
            </a>

            <!-- Módulo 01 -->
            <a href="/Modulo01" class="p-5 rounded-2xl bg-white dark:bg-[#111827] hover:bg-slate-50 dark:hover:bg-slate-800/80 border border-slate-200/80 dark:border-slate-800 shadow-sm transition group flex flex-col justify-between">
                <div>
                    <div class="flex items-center justify-between mb-3">
                        <span class="text-xl">📝</span>
                        <span class="text-[10px] font-mono text-slate-400 font-semibold">01</span>
                    </div>
                    <h3 class="font-bold text-xs text-slate-900 dark:text-slate-100 group-hover:text-blue-600 dark:group-hover:text-cyan-400 transition">
                        01. Matrícula Académica
                    </h3>
                    <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-1">
                        Matrícula regular, convalidaciones y reserva de vacantes.
                    </p>
                </div>
                <div class="mt-4 pt-2 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between text-[11px] text-slate-400 group-hover:text-blue-600 dark:group-hover:text-cyan-400">
                    <span>Ingresar</span>
                    <span>→</span>
                </div>
            </a>

            <!-- Módulo 02 (Destacado) -->
            <a href="/Modulo02" class="p-5 rounded-2xl bg-indigo-50/40 dark:bg-indigo-950/20 hover:bg-indigo-50/80 dark:hover:bg-indigo-950/40 border border-indigo-200/80 dark:border-indigo-900/50 shadow-sm transition group flex flex-col justify-between">
                <div>
                    <div class="flex items-center justify-between mb-3">
                        <span class="text-xl">📅</span>
                        <span class="text-[10px] bg-indigo-100 dark:bg-indigo-900 text-indigo-700 dark:text-indigo-300 font-bold px-1.5 py-0.5 rounded">PRO</span>
                    </div>
                    <h3 class="font-bold text-xs text-slate-900 dark:text-slate-100 group-hover:text-indigo-600 dark:group-hover:text-indigo-300 transition">
                        02. Asistencia & DPI
                    </h3>
                    <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-1">
                        Toma de lista en 1 clic, sábana de 18 semanas y control de 30% DPI.
                    </p>
                </div>
                <div class="mt-4 pt-2 border-t border-indigo-100 dark:border-indigo-900/50 flex items-center justify-between text-[11px] font-semibold text-indigo-600 dark:text-indigo-300">
                    <span>Ingresar</span>
                    <span>→</span>
                </div>
            </a>

            <!-- Módulo 03 -->
            <a href="/Modulo03" class="p-5 rounded-2xl bg-white dark:bg-[#111827] hover:bg-slate-50 dark:hover:bg-slate-800/80 border border-slate-200/80 dark:border-slate-800 shadow-sm transition group flex flex-col justify-between">
                <div>
                    <div class="flex items-center justify-between mb-3">
                        <span class="text-xl">📊</span>
                        <span class="text-[10px] font-mono text-slate-400 font-semibold">03</span>
                    </div>
                    <h3 class="font-bold text-xs text-slate-900 dark:text-slate-100 group-hover:text-blue-600 dark:group-hover:text-cyan-400 transition">
                        03. Calificaciones & Actas
                    </h3>
                    <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-1">
                        Notas vigesimales, actas finales y ponderados académicos.
                    </p>
                </div>
                <div class="mt-4 pt-2 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between text-[11px] text-slate-400 group-hover:text-blue-600 dark:group-hover:text-cyan-400">
                    <span>Ingresar</span>
                    <span>→</span>
                </div>
            </a>

            <!-- Módulo 04 -->
            <a href="/Modulo04" class="p-5 rounded-2xl bg-white dark:bg-[#111827] hover:bg-slate-50 dark:hover:bg-slate-800/80 border border-slate-200/80 dark:border-slate-800 shadow-sm transition group flex flex-col justify-between">
                <div>
                    <div class="flex items-center justify-between mb-3">
                        <span class="text-xl">⏰</span>
                        <span class="text-[10px] font-mono text-slate-400 font-semibold">04</span>
                    </div>
                    <h3 class="font-bold text-xs text-slate-900 dark:text-slate-100 group-hover:text-blue-600 dark:group-hover:text-cyan-400 transition">
                        04. Horarios & Aulas
                    </h3>
                    <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-1">
                        Distribución de aulas, turnos y disponibilidad horaria.
                    </p>
                </div>
                <div class="mt-4 pt-2 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between text-[11px] text-slate-400 group-hover:text-blue-600 dark:group-hover:text-cyan-400">
                    <span>Ingresar</span>
                    <span>→</span>
                </div>
            </a>

            <!-- Módulo 05 -->
            <a href="/Modulo05" class="p-5 rounded-2xl bg-white dark:bg-[#111827] hover:bg-slate-50 dark:hover:bg-slate-800/80 border border-slate-200/80 dark:border-slate-800 shadow-sm transition group flex flex-col justify-between">
                <div>
                    <div class="flex items-center justify-between mb-3">
                        <span class="text-xl">👨‍🏫</span>
                        <span class="text-[10px] font-mono text-slate-400 font-semibold">05</span>
                    </div>
                    <h3 class="font-bold text-xs text-slate-900 dark:text-slate-100 group-hover:text-blue-600 dark:group-hover:text-cyan-400 transition">
                        05. Carga Docente
                    </h3>
                    <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-1">
                        Asignación de unidades didácticas y horas lectivas.
                    </p>
                </div>
                <div class="mt-4 pt-2 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between text-[11px] text-slate-400 group-hover:text-blue-600 dark:group-hover:text-cyan-400">
                    <span>Ingresar</span>
                    <span>→</span>
                </div>
            </a>

            <!-- Módulo 06 -->
            <a href="/Modulo06" class="p-5 rounded-2xl bg-white dark:bg-[#111827] hover:bg-slate-50 dark:hover:bg-slate-800/80 border border-slate-200/80 dark:border-slate-800 shadow-sm transition group flex flex-col justify-between">
                <div>
                    <div class="flex items-center justify-between mb-3">
                        <span class="text-xl">📋</span>
                        <span class="text-[10px] font-mono text-slate-400 font-semibold">06</span>
                    </div>
                    <h3 class="font-bold text-xs text-slate-900 dark:text-slate-100 group-hover:text-blue-600 dark:group-hover:text-cyan-400 transition">
                        06. Mesa de Partes & Trámites
                    </h3>
                    <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-1">
                        Recepción de expedientes, solicitudes y trámites digitales.
                    </p>
                </div>
                <div class="mt-4 pt-2 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between text-[11px] text-slate-400 group-hover:text-blue-600 dark:group-hover:text-cyan-400">
                    <span>Ingresar</span>
                    <span>→</span>
                </div>
            </a>

            <!-- Módulo 07 -->
            <a href="/Modulo07" class="p-5 rounded-2xl bg-white dark:bg-[#111827] hover:bg-slate-50 dark:hover:bg-slate-800/80 border border-slate-200/80 dark:border-slate-800 shadow-sm transition group flex flex-col justify-between">
                <div>
                    <div class="flex items-center justify-between mb-3">
                        <span class="text-xl">💼</span>
                        <span class="text-[10px] font-mono text-slate-400 font-semibold">07</span>
                    </div>
                    <h3 class="font-bold text-xs text-slate-900 dark:text-slate-100 group-hover:text-blue-600 dark:group-hover:text-cyan-400 transition">
                        07. Bolsa de Trabajo & Prácticas
                    </h3>
                    <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-1">
                        Ofertas laborales, prácticas pre-profesionales y convenios.
                    </p>
                </div>
                <div class="mt-4 pt-2 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between text-[11px] text-slate-400 group-hover:text-blue-600 dark:group-hover:text-cyan-400">
                    <span>Ingresar</span>
                    <span>→</span>
                </div>
            </a>

            <!-- Módulo 08 -->
            <a href="/Modulo08" class="p-5 rounded-2xl bg-white dark:bg-[#111827] hover:bg-slate-50 dark:hover:bg-slate-800/80 border border-slate-200/80 dark:border-slate-800 shadow-sm transition group flex flex-col justify-between">
                <div>
                    <div class="flex items-center justify-between mb-3">
                        <span class="text-xl">📋</span>
                        <span class="text-[10px] font-mono text-slate-400 font-semibold">08</span>
                    </div>
                    <h3 class="font-bold text-xs text-slate-900 dark:text-slate-100 group-hover:text-blue-600 dark:group-hover:text-cyan-400 transition">
                        08. Encuestas & Evaluación
                    </h3>
                    <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-1">
                        Encuestas de satisfacción y evaluación docente.
                    </p>
                </div>
                <div class="mt-4 pt-2 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between text-[11px] text-slate-400 group-hover:text-blue-600 dark:group-hover:text-cyan-400">
                    <span>Ingresar</span>
                    <span>→</span>
                </div>
            </a>

            <!-- Módulo 09 -->
            <a href="/Modulo09" class="p-5 rounded-2xl bg-white dark:bg-[#111827] hover:bg-slate-50 dark:hover:bg-slate-800/80 border border-slate-200/80 dark:border-slate-800 shadow-sm transition group flex flex-col justify-between">
                <div>
                    <div class="flex items-center justify-between mb-3">
                        <span class="text-xl">💳</span>
                        <span class="text-[10px] font-mono text-slate-400 font-semibold">09</span>
                    </div>
                    <h3 class="font-bold text-xs text-slate-900 dark:text-slate-100 group-hover:text-blue-600 dark:group-hover:text-cyan-400 transition">
                        09. Tesorería & Pagos
                    </h3>
                    <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-1">
                        Pagos de tasas TUPA, certificados y constancias.
                    </p>
                </div>
                <div class="mt-4 pt-2 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between text-[11px] text-slate-400 group-hover:text-blue-600 dark:group-hover:text-cyan-400">
                    <span>Ingresar</span>
                    <span>→</span>
                </div>
            </a>
        </div>
    </div>
</div>
