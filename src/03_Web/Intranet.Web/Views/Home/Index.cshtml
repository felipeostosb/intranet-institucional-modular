@{
    ViewData["Title"] = "Panel Principal";
    var rolPrincipal = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Alumno";
    var esDocenteODirector = User.IsInRole("Docente") || User.IsInRole("Director") || User.IsInRole("Admin") || User.IsInRole("Coordinador");
}

<div class="space-y-6 transition-colors">
    <!-- Banner Principal Personalizado con Bienvenida según Rol -->
    <div class="bg-gradient-to-r from-blue-800 via-blue-700 to-indigo-800 dark:from-[#0b132b] dark:via-[#131f3e] dark:to-[#0f172a] rounded-3xl p-6 sm:p-8 text-white shadow-xl shadow-blue-900/10 dark:shadow-none border border-blue-600/30 dark:border-slate-800 flex flex-col md:flex-row justify-between items-start md:items-center gap-6 relative overflow-hidden transition-colors">
        <div class="relative z-10 space-y-2.5">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/15 dark:bg-slate-800/60 backdrop-blur-md text-xs font-semibold text-blue-100 dark:text-cyan-300 border border-white/20 dark:border-slate-700">
                <span>🏛️ Intranet Institucional • IESTP Argentina</span>
                <span>•</span>
                <span>AQUILA A-ERP 2026-II</span>
            </div>
            
            <h1 class="text-2xl sm:text-3xl font-black tracking-tight text-white flex items-center gap-2.5">
                <span>¡Hola, @User.Identity?.Name!</span>
                <span class="text-2xl">👋</span>
            </h1>

            <p class="text-xs sm:text-sm text-blue-100/90 dark:text-slate-300 max-w-2xl font-normal leading-relaxed">
                Bienvenido al panel principal de la <strong>Intranet Institucional</strong> impulsada por <strong>AQUILA A-ERP</strong>. Tienes acceso al ecosistema de <strong>10 módulos independientes</strong> desacoplados bajo arquitectura <strong>Zero-Blast-Radius</strong> en <strong>.NET 10 LTS</strong>.
            </p>

            <div class="flex flex-wrap items-center gap-2 pt-1">
                <span class="badge bg-white dark:bg-slate-800 text-blue-900 dark:text-cyan-300 font-extrabold text-[11px] px-3 py-2 border-0 shadow-sm">
                    Rol: @rolPrincipal.ToUpper()
                </span>
                <span class="badge bg-white/20 dark:bg-slate-800/80 text-white dark:text-slate-300 font-semibold text-[11px] px-3 py-2 border border-white/30 dark:border-slate-700">
