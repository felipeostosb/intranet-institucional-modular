                            <span>🗄️ 2. PostgreSQL 16</span>
                        </div>
                        <div class="space-y-0.5 mt-1">
                            <a href="#database" class="flex items-center gap-2.5 px-3 py-1.5 rounded-xl text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 font-medium transition">
                                <span class="text-emerald-500 font-bold">•</span> Esquemas (<code>mod00..09</code>)
                            </a>
                            <a href="http://35.206.81.32:8080" target="_blank" class="flex items-center justify-between px-3 py-1.5 rounded-xl text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 font-medium transition">
                                <span class="flex items-center gap-2.5"><span class="text-emerald-500 font-bold">•</span> Panel Adminer Web</span>
                                <span class="text-[9px] badge badge-xs badge-ghost font-mono">:8080</span>
                            </a>
                            <a href="#database" class="flex items-center gap-2.5 px-3 py-1.5 rounded-xl text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 font-medium transition">
                                <span class="text-emerald-500 font-bold">•</span> Eje Temporal (Periodos)
                            </a>
                        </div>
                    </div>

                    <!-- 3. Videotutoriales por Módulo -->
                    <div>
                        <div class="px-3 py-1 text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider flex items-center justify-between">
                            <span>🎬 3. Videos por Módulo</span>
                        </div>
                        <div class="space-y-0.5 mt-1">
                            <a href="/Docs?modulo=General" class="flex items-center justify-between px-3 py-1.5 rounded-xl text-slate-700 dark:text-slate-300 hover:bg-cyan-50 dark:hover:bg-slate-800 hover:text-cyan-700 dark:hover:text-cyan-300 font-medium transition">
                                <span>🌐 General / Inducción</span>
                                <span class="badge badge-ghost badge-xs text-[9px]">Base</span>
                            </a>
                            <a href="/Docs?modulo=Modulo00" class="flex items-center justify-between px-3 py-1.5 rounded-xl text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 font-medium transition">
                                <span>🛡️ Mód 00: Seguridad (Toro)</span>
                                <span class="badge badge-ghost badge-xs text-[9px]">00</span>
                            </a>
                            <a href="/Docs?modulo=Modulo01" class="flex items-center justify-between px-3 py-1.5 rounded-xl text-slate-700 dark:text-slate-300 hover:bg-sky-50 dark:hover:bg-slate-800 font-medium transition">
                                <span>📝 Mód 01: Matrícula (Mendoza)</span>
                                <span class="badge badge-ghost badge-xs text-[9px]">01</span>
                            </a>
                            <a href="/Docs?modulo=Modulo02" class="flex items-center justify-between px-3 py-1.5 rounded-xl text-slate-700 dark:text-slate-300 hover:bg-indigo-50 dark:hover:bg-slate-800 font-medium transition">
                                <span>📅 Mód 02: Asistencia (Sheyla)</span>
                                <span class="badge badge-ghost badge-xs text-[9px]">02</span>
                            </a>
                            <a href="/Docs?modulo=Modulo03" class="flex items-center justify-between px-3 py-1.5 rounded-xl text-slate-700 dark:text-slate-300 hover:bg-emerald-50 dark:hover:bg-slate-800 font-medium transition">
                                <span>📊 Mód 03: Calificaciones</span>
                                <span class="badge badge-ghost badge-xs text-[9px]">03</span>
                            </a>
                            <a href="/Docs?modulo=Modulo04" class="flex items-center justify-between px-3 py-1.5 rounded-xl text-slate-700 dark:text-slate-300 hover:bg-amber-50 dark:hover:bg-slate-800 font-medium transition">
                                <span>⏰ Mód 04: Horarios & Aulas</span>
                                <span class="badge badge-ghost badge-xs text-[9px]">04</span>
                            </a>
                            <a href="/Docs?modulo=Modulo05" class="flex items-center justify-between px-3 py-1.5 rounded-xl text-slate-700 dark:text-slate-300 hover:bg-purple-50 dark:hover:bg-slate-800 font-medium transition">
