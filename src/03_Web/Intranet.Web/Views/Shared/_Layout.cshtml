                            <div>
                                <span class="truncate block font-bold text-xs">Módulo 01</span>
                                <span class="text-[10px] text-sky-600 dark:text-sky-400 block -mt-0.5">Matrícula (Ismael)</span>
                            </div>
                        </div>
                        <span class="text-[10px] font-bold bg-sky-100 dark:bg-sky-950 text-sky-700 dark:text-sky-300 px-2 py-0.5 rounded-lg border border-sky-200 dark:border-sky-800">Eq 01</span>
                    </a>

                    <!-- Módulo 02 (Indigo Pastel) - Asistencia (Sheyla) -->
                    <div class="space-y-1">
                        <a href="/Modulo02" class="flex items-center justify-between px-3 py-2 rounded-2xl text-indigo-900 dark:text-indigo-200 bg-indigo-50/70 dark:bg-indigo-950/40 hover:bg-indigo-100 dark:hover:bg-indigo-900/60 hover:text-indigo-950 transition text-xs font-semibold group border border-indigo-100 dark:border-indigo-900/50">
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded-xl bg-indigo-600 text-white flex items-center justify-center shrink-0 group-hover:scale-105 transition shadow-sm">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>
                                </div>
                                <div>
                                    <span class="truncate block font-bold text-xs">Módulo 02</span>
                                    <span class="text-[10px] text-indigo-600 dark:text-indigo-300 block -mt-0.5">Asistencia & DPI (Sheyla)</span>
                                </div>
                            </div>
                            <span class="text-[9px] font-extrabold bg-indigo-200 dark:bg-indigo-800 text-indigo-900 dark:text-indigo-100 px-1.5 py-0.5 rounded-md">PRO</span>
                        </a>
                    </div>

                    <!-- Módulo 03 (Emerald Pastel) - Inventario (Brenda) -->
                    <a href="/Modulo03" class="flex items-center justify-between px-3 py-2 rounded-2xl text-slate-700 dark:text-slate-300 hover:bg-emerald-50 dark:hover:bg-emerald-950/50 hover:text-emerald-800 dark:hover:text-emerald-300 transition text-xs font-medium group">
                        <div class="flex items-center gap-3">
                            <div class="w-8 h-8 rounded-xl bg-emerald-100 dark:bg-emerald-950 text-emerald-700 dark:text-emerald-300 flex items-center justify-center shrink-0 group-hover:scale-105 transition">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" /></svg>
                            </div>
                            <div>
                                <span class="truncate block font-bold text-xs">Módulo 03</span>
                                <span class="text-[10px] text-emerald-600 dark:text-emerald-400 block -mt-0.5">Inventario & Equipos (Brenda)</span>
                            </div>
                        </div>
