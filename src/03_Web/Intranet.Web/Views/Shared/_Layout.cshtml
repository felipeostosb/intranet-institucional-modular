                                <span class="badge badge-ghost badge-xs text-[9px]">07</span>
                            </a>
                            <a href="/Docs?modulo=Modulo08" class="flex items-center justify-between px-3 py-1.5 rounded-xl text-slate-700 dark:text-slate-300 hover:bg-orange-50 dark:hover:bg-slate-800 font-medium transition">
                                <span>📋 Mód 08: Encuestas (Brayan)</span>
                                <span class="badge badge-ghost badge-xs text-[9px]">08</span>
                            </a>
                            <a href="/Docs?modulo=Modulo09" class="flex items-center justify-between px-3 py-1.5 rounded-xl text-slate-700 dark:text-slate-300 hover:bg-cyan-50 dark:hover:bg-slate-800 font-medium transition">
                                <span>💳 Mód 09: Tesorería & Pagos</span>
                                <span class="badge badge-ghost badge-xs text-[9px]">09</span>
                            </a>
                        </div>
                    </div>

                    <!-- 4. Normativa Académica MINEDU -->
                    <div>
                        <div class="px-3 py-1 text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider flex items-center gap-1.5">
                            <span>⚖️ 4. Normativa MINEDU</span>
                        </div>
                        <div class="space-y-0.5 mt-1">
                            <a href="#minedu" class="flex items-center gap-2.5 px-3 py-1.5 rounded-xl text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 font-medium transition">
                                <span class="text-amber-500 font-bold">•</span> Semestre 18 Semanas
                            </a>
                            <a href="#minedu" class="flex items-center gap-2.5 px-3 py-1.5 rounded-xl text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 font-medium transition">
                                <span class="text-amber-500 font-bold">•</span> Condición DPI (&gt;30% Faltas)
                            </a>
                            <a href="#minedu" class="flex items-center gap-2.5 px-3 py-1.5 rounded-xl text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 font-medium transition">
