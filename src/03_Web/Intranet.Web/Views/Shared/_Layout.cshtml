<!DOCTYPE html>
<html lang="es" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AQUILA A-ERP | IESTP Argentina</title>
    
    <!-- Tipografía Moderna: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    
    <!-- DaisyUI + TailwindCSS -->
    <link href="https://cdn.jsdelivr.net/npm/daisyui@4.7.2/dist/full.min.css" rel="stylesheet" type="text/css" />
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Configuración Personalizada de Tailwind con Paleta de Cuidado Ocular Anti-Fatiga -->
    <script>
        tailwind.config = {
            darkMode: ['class', '[data-theme="dark"]'],
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['"Plus Jakarta Sans"', 'system-ui', 'sans-serif'],
                    },
                    colors: {
                        aquila: {
                            50: '#f0f7ff',
                            100: '#e0effe',
                            200: '#bae0fd',
                            500: '#0ea5e9',
                            700: '#0369a1',
                            900: '#0c4a6e',
                            950: '#082f49',
                        }
                    }
                }
            }
        }
    </script>

    <!-- Script Anti-Parpadeo Inmediato (Carga el tema guardado antes de renderizar) -->
    <script>
        (function() {
            try {
                const savedTheme = localStorage.getItem('aquila-theme') || 'light';
                document.documentElement.setAttribute('data-theme', savedTheme);
                if (savedTheme === 'dark') {
                    document.documentElement.classList.add('dark');
                } else {
                    document.documentElement.classList.remove('dark');
                }
            } catch (e) {}
        })();
    </script>

    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#1d4ed8" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <link rel="icon" type="image/svg+xml" href="/icons/icon.svg" />

    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            transition: background-color 0.25s ease, color 0.25s ease;
        }
        [data-theme="dark"] {
            color-scheme: dark;
        }
        [data-theme="light"] {
            color-scheme: light;
        }
        html {
            scroll-behavior: smooth;
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="bg-slate-50 dark:bg-[#0b0f19] min-h-screen flex flex-col text-slate-800 dark:text-slate-200 selection:bg-blue-500 selection:text-white transition-colors duration-200">
@{
    var path = Context.Request.Path.Value?.ToLowerInvariant() ?? "";
    var isDocsSection = path.StartsWith("/docs") || path.StartsWith("/tutoriales") || path.StartsWith("/documentacion");
    var isAuth = User.Identity?.IsAuthenticated == true;
}

@if (isDocsSection)
{
    <!-- ========================================================================= -->
    <!-- 📚 LAYOUT ESPECIALIZADO: CENTRO DE DOCUMENTACIÓN & ACADEMIA MULTIMEDIA   -->
    <!-- ========================================================================= -->
    <div class="drawer lg:drawer-open flex-1">
        <input id="main-drawer" type="checkbox" class="drawer-toggle" />
        
        <div class="drawer-content flex flex-col">
            <!-- Barra Superior Especializada de Documentación -->
            <div class="navbar bg-gradient-to-r from-[#0b132b] via-[#111c3a] to-[#0d1b2a] text-white shadow-md sticky top-0 z-30 px-4 lg:px-8 h-16 min-h-0 border-b border-white/10 dark:border-slate-800 transition-colors">
                <div class="flex-none lg:hidden">
                    <label for="main-drawer" aria-label="open sidebar" class="btn btn-square btn-ghost btn-sm text-white">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="inline-block w-6 h-6 stroke-current"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
                    </label>
                </div>
                <div class="flex-1 items-center gap-3">
                    <a href="/Docs" class="flex items-center gap-3 group">
                        <!-- Logotipo Águila Minimalista -->
                        <div class="w-10 h-10 rounded-2xl bg-gradient-to-br from-slate-900 via-blue-950 to-indigo-950 border border-cyan-400/40 p-1.5 flex items-center justify-center shadow-md shadow-cyan-500/20 shrink-0">
                            <svg viewBox="0 0 100 100" class="w-full h-full drop-shadow-[0_0_8px_rgba(56,189,248,0.7)]" fill="none">
                                <defs>
                                    <linearGradient id="docNavWingL" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#38bdf8" /><stop offset="100%" stop-color="#1d4ed8" /></linearGradient>
                                    <linearGradient id="docNavWingR" x1="100%" y1="0%" x2="0%" y2="100%"><stop offset="0%" stop-color="#60a5fa" /><stop offset="100%" stop-color="#2563eb" /></linearGradient>
                                    <linearGradient id="docNavCore" x1="0%" y1="0%" x2="0%" y2="100%"><stop offset="0%" stop-color="#ffffff" /><stop offset="100%" stop-color="#93c5fd" /></linearGradient>
                                </defs>
                                <polygon points="48,10 4,68 32,60 46,38" fill="url(#docNavWingL)" />
                                <polygon points="52,10 96,68 68,60 54,38" fill="url(#docNavWingR)" />
                                <polygon points="50,6 43,44 50,88 57,44" fill="url(#docNavCore)" />
                                <polygon points="50,22 46,44 50,70 54,44" fill="#0284c7" />
                            </svg>
                        </div>
                        <div>
                            <div class="flex items-center gap-2">
                                <span class="text-base sm:text-lg font-black tracking-tight text-white flex items-center gap-1.5">
                                    AQUILA
                                </span>
                                <span class="text-[10px] bg-cyan-400/20 text-cyan-200 px-2 py-0.5 rounded-md font-black border border-cyan-400/30">
                                    DOCS & ACADEMIA
                                </span>
                            </div>
                            <p class="text-[11px] text-blue-100/80 font-medium hidden sm:block">Centro de Documentación & Videotutoriales • IESTP Argentina</p>
                        </div>
                    </a>
                </div>
                
                <div class="flex-none items-center gap-2.5">
                    <!-- Botón Nativo de Modo Oscuro -->
                    <button type="button" onclick="toggleAquilaTheme()" class="btn btn-ghost btn-sm btn-circle text-amber-300 hover:text-amber-200 hover:bg-white/10 transition" title="Alternar Modo Oscuro">
                        <svg class="theme-icon-sun w-5 h-5 hidden text-amber-300 drop-shadow-[0_0_8px_rgba(252,211,77,0.7)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
                        <svg class="theme-icon-moon w-5 h-5 text-cyan-200 drop-shadow-[0_0_6px_rgba(56,189,248,0.5)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" /></svg>
                    </button>

                    <!-- Enlace directo a Volver al ERP / Dashboard -->
                    <a href="/" class="btn btn-primary btn-sm rounded-xl text-xs font-bold gap-1.5 shadow-md">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
                        <span>Volver a la Intranet</span>
                    </a>
                </div>
            </div>

            <!-- Contenido Principal de Docs -->
            <main class="flex-1 p-4 lg:p-8 max-w-7xl w-full mx-auto">
                @if (TempData["AlertaMensaje"] != null)
                {
                    var tipo = TempData["AlertaTipo"]?.ToString() ?? "info";
                    var claseAlerta = tipo switch
                    {
                        "success" => "alert-success bg-emerald-50 dark:bg-emerald-950/40 text-emerald-800 dark:text-emerald-300 border-emerald-200 dark:border-emerald-800",
                        "error" => "alert-error bg-rose-50 dark:bg-rose-950/40 text-rose-800 dark:text-rose-300 border-rose-200 dark:border-rose-800",
                        _ => "alert-info bg-blue-50 dark:bg-blue-950/40 text-blue-800 dark:text-blue-300 border-blue-200 dark:border-blue-800"
                    };

                    <div class="alert @claseAlerta shadow-sm rounded-2xl mb-6 flex items-center justify-between text-xs py-3 px-4">
                        <span>@TempData["AlertaMensaje"]</span>
                        <button class="btn btn-ghost btn-xs" onclick="this.parentElement.remove()">✕</button>
                    </div>
                }

                @RenderBody()
            </main>

            <!-- Footer -->
            <footer class="p-6 bg-white dark:bg-[#0f172a] border-t border-slate-200 dark:border-slate-800 text-center text-xs text-slate-500 dark:text-slate-400 transition-colors">
                <div class="max-w-7xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-3">
                    <p class="font-medium">🦅 <strong>AQUILA A-ERP</strong> — Centro de Documentación & Academia Multimedia</p>
                    <p class="text-slate-400 dark:text-slate-500">IESTP "Argentina" 2026 • .NET 10 LTS • PostgreSQL 16</p>
                </div>
            </footer>
        </div>

        <!-- Barra Lateral Especializada: ÍNDICE DE DOCUMENTACIÓN & TUTORIALES -->
        <div class="drawer-side z-40">
            <label for="main-drawer" aria-label="close sidebar" class="drawer-overlay"></label>
            <aside class="bg-white dark:bg-[#0f172a] w-72 min-h-full border-r border-slate-200 dark:border-slate-800 flex flex-col shadow-sm transition-colors duration-200">
                
