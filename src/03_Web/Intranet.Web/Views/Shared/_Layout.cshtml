<!DOCTYPE html>
<html lang="es" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AQUILA A-ERP (Agentic ERP) | IESTP Argentina</title>
    
    <!-- Script Anti-Parpadeo Inmediato (Theme Loader) -->
    <script>
        (function() {
            const savedTheme = localStorage.getItem('aquila-theme') || 
                (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
            document.documentElement.setAttribute('data-theme', savedTheme);
            if (savedTheme === 'dark') {
                document.documentElement.classList.add('dark');
            } else {
                document.documentElement.classList.remove('dark');
            }
        })();
    </script>

    <!-- Fuente Plus Jakarta Sans (Moderna, Legible y Vistosa) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdn.jsdelivr.net/npm/daisyui@4.12.10/dist/full.min.css" rel="stylesheet" type="text/css" />
    
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['"Plus Jakarta Sans"', 'sans-serif'],
                    },
                    colors: {
                        institucional: {
                            50: '#eff6ff',
                            100: '#dbeafe',
                            500: '#3b82f6',
                            600: '#2563eb',
                            700: '#1d4ed8',
                            800: '#1e40af',
                            900: '#1e3a8a'
                        }
                    }
                }
            }
        }
    </script>

    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#1d4ed8" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <link rel="icon" type="image/svg+xml" href="/icons/icon.svg" />

    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            transition: background-color 0.25s ease, color 0.25s ease;
        }
        /* Cuidado Visual Anti-Luz Azul & Confort Ocular */
        [data-theme="dark"] {
            color-scheme: dark;
        }
        [data-theme="light"] {
            color-scheme: light;
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="bg-slate-50 dark:bg-[#0b0f19] min-h-screen flex flex-col text-slate-800 dark:text-slate-200 selection:bg-blue-500 selection:text-white transition-colors duration-200">
@if (User.Identity?.IsAuthenticated == true)
{
    <div class="drawer lg:drawer-open flex-1">
        <input id="main-drawer" type="checkbox" class="drawer-toggle" />
        
        <div class="drawer-content flex flex-col">
            <!-- Barra Superior Azul Institucional con Logotipo Minimalista Águila & Toggle Dark Mode -->
            <div class="navbar bg-gradient-to-r from-[#0b132b] via-[#111c3a] to-[#0d1b2a] text-white shadow-md sticky top-0 z-30 px-4 lg:px-8 h-16 min-h-0 border-b border-white/10 dark:border-slate-800 transition-colors">
                <div class="flex-none lg:hidden">
                    <label for="main-drawer" aria-label="open sidebar" class="btn btn-square btn-ghost btn-sm text-white">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="inline-block w-6 h-6 stroke-current"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
                    </label>
                </div>
                <div class="flex-1 items-center gap-3">
                    <a href="/" class="flex items-center gap-3 group">
                        <!-- Logotipo Águila Minimalista: Alas Delta / Caza Supersónico Afilado -->
                        <div class="w-10 h-10 rounded-2xl bg-gradient-to-br from-slate-900 via-blue-950 to-indigo-950 border border-cyan-400/40 p-1.5 flex items-center justify-center shadow-md shadow-cyan-500/20 group-hover:scale-105 group-hover:border-cyan-300 transition shrink-0">
                            <svg viewBox="0 0 100 100" class="w-full h-full drop-shadow-[0_0_8px_rgba(56,189,248,0.7)]" fill="none">
                                <defs>
                                    <linearGradient id="navWingL" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#38bdf8" /><stop offset="100%" stop-color="#1d4ed8" /></linearGradient>
                                    <linearGradient id="navWingR" x1="100%" y1="0%" x2="0%" y2="100%"><stop offset="0%" stop-color="#60a5fa" /><stop offset="100%" stop-color="#2563eb" /></linearGradient>
                                    <linearGradient id="navCore" x1="0%" y1="0%" x2="0%" y2="100%"><stop offset="0%" stop-color="#ffffff" /><stop offset="100%" stop-color="#93c5fd" /></linearGradient>
                                </defs>
                                <polygon points="48,10 4,68 32,60 46,38" fill="url(#navWingL)" />
                                <polygon points="52,10 96,68 68,60 54,38" fill="url(#navWingR)" />
                                <polygon points="50,6 43,44 50,88 57,44" fill="url(#navCore)" />
                                <polygon points="50,22 46,44 50,70 54,44" fill="#0284c7" />
                            </svg>
                        </div>
                        <div>
                            <div class="flex items-center gap-2">
                                <span class="text-base sm:text-lg font-black tracking-tight text-white flex items-center gap-1.5">
                                    AQUILA
                                </span>
                                <span class="text-[10px] bg-cyan-400/20 text-cyan-200 px-2 py-0.5 rounded-md font-black border border-cyan-400/30">
                                    A-ERP
                                </span>
                                <span class="text-[10px] bg-white/20 text-blue-100 px-2 py-0.5 rounded-full font-bold border border-white/20 hidden sm:inline">
                                    INTRANET INSTITUCIONAL
                                </span>
                            </div>
                            <p class="text-[11px] text-blue-100/80 font-medium hidden sm:block">IESTP "Argentina" — Plataforma Modular 2026</p>
                        </div>
                    </a>
                </div>
                
                <div class="flex-none items-center gap-2.5">
                    <!-- Botón Nativo de Modo Oscuro / Cuidado Visual -->
                    <button type="button" onclick="toggleAquilaTheme()" class="btn btn-ghost btn-sm btn-circle text-amber-300 hover:text-amber-200 hover:bg-white/10 transition" title="Alternar Modo Oscuro / Descanso Ocular">
                        <!-- Icono Sol (visible en modo oscuro) -->
                        <svg class="theme-icon-sun w-5 h-5 hidden text-amber-300 drop-shadow-[0_0_8px_rgba(252,211,77,0.7)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
                        </svg>
                        <!-- Icono Luna (visible en modo claro) -->
                        <svg class="theme-icon-moon w-5 h-5 text-cyan-200 drop-shadow-[0_0_6px_rgba(56,189,248,0.5)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
                        </svg>
                    </button>

                    <a href="http://35.206.81.32:8080" target="_blank" class="badge bg-white/15 hover:bg-white/25 text-white border-white/20 text-xs font-semibold px-3 py-2 hidden md:flex items-center gap-1.5 transition">
                        <span>🗄️ Adminer BD</span>
                    </a>
                    
                    <div class="badge bg-white/15 text-white border-white/20 text-xs font-semibold px-3 py-2 hidden sm:flex items-center gap-1.5">
                        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                        <span>.NET 10 LTS</span>
                    </div>
                    
                    <div class="dropdown dropdown-end">
                        <div tabindex="0" role="button" class="btn btn-ghost btn-sm flex items-center gap-2.5 normal-case rounded-xl px-2.5 py-1.5 h-auto hover:bg-white/10 text-white">
                            <div class="w-8 h-8 rounded-xl bg-gradient-to-tr from-blue-600 to-indigo-600 text-white flex items-center justify-center text-xs font-bold shadow-inner border border-white/20">
                                @(User.Identity?.Name?[..Math.Min(2, User.Identity.Name.Length)].ToUpper() ?? "US")
                            </div>
                            <div class="text-left hidden md:block leading-tight">
                                <p class="text-xs font-bold text-white">@User.Identity?.Name</p>
                                <p class="text-[10px] text-cyan-200">@(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Alumno")</p>
                            </div>
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-blue-200" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
                        </div>
                        <ul tabindex="0" class="dropdown-content z-[1] menu p-2 shadow-2xl bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-200 rounded-2xl w-56 border border-slate-200 dark:border-slate-700 mt-2 text-xs transition-colors">
                            <li class="px-3 py-1.5 text-[11px] text-slate-400 font-semibold uppercase">Sesión Iniciada</li>
                            <li class="px-3 py-0.5 text-xs font-bold text-blue-900 dark:text-cyan-300">@User.Identity?.Name</li>
                            <li class="px-3 py-0.5 text-[11px] text-slate-500 dark:text-slate-400 flex flex-wrap gap-1 items-center">
                                <span>Roles:</span>
                                @foreach (var rolClaim in User.FindAll(System.Security.Claims.ClaimTypes.Role))
                                {
                                    <span class="badge badge-xs badge-outline badge-primary font-semibold">@rolClaim.Value</span>
                                }
                            </li>
                            <li class="divider my-1 border-slate-200 dark:border-slate-700"></li>
                            <li>
                                <button type="button" onclick="toggleAquilaTheme()" class="flex items-center justify-between py-2 rounded-xl text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700">
                                    <span class="flex items-center gap-2">
                                        <span class="theme-icon-sun hidden">☀️ Modo Claro</span>
                                        <span class="theme-icon-moon">🌙 Modo Oscuro</span>
                                    </span>
                                </button>
                            </li>
                            <li class="divider my-1 border-slate-200 dark:border-slate-700"></li>
                            <li>
                                <a href="/Account/Logout" class="text-rose-600 hover:bg-rose-50 dark:hover:bg-rose-950/40 font-semibold flex items-center gap-2 rounded-xl py-2">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" /></svg>
                                    <span>Cerrar Sesión</span>
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Contenido Principal -->
            <main class="flex-1 p-4 lg:p-8 max-w-7xl w-full mx-auto">
                @if (TempData["AlertaMensaje"] != null)
                {
                    var tipo = TempData["AlertaTipo"]?.ToString() ?? "info";
                    var claseAlerta = tipo switch
                    {
                        "success" => "alert-success bg-emerald-50 dark:bg-emerald-950/40 text-emerald-800 dark:text-emerald-300 border-emerald-200 dark:border-emerald-800",
                        "error" => "alert-error bg-rose-50 dark:bg-rose-950/40 text-rose-800 dark:text-rose-300 border-rose-200 dark:border-rose-800",
                        _ => "alert-info bg-blue-50 dark:bg-blue-950/40 text-blue-800 dark:text-blue-300 border-blue-200 dark:border-blue-800"
                    };

                    <div class="alert @claseAlerta shadow-sm rounded-2xl mb-6 flex items-center justify-between text-xs py-3 px-4">
                        <span>@TempData["AlertaMensaje"]</span>
                        <button class="btn btn-ghost btn-xs" onclick="this.parentElement.remove()">✕</button>
                    </div>
                }

                @RenderBody()
            </main>

            <!-- Footer Institucional -->
            <footer class="p-6 bg-white dark:bg-[#0f172a] border-t border-slate-200 dark:border-slate-800 text-center text-xs text-slate-500 dark:text-slate-400 transition-colors duration-200">
                <div class="max-w-7xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-3">
                    <p class="font-medium">🦅 <strong>AQUILA A-ERP</strong> — Intranet Institucional del IESTP Público "Argentina" 2026</p>
                    <p class="text-slate-400 dark:text-slate-500">10 Módulos Desacoplados • .NET 10 LTS • Cuidado Ocular Anti-Fatiga</p>
                </div>
            </footer>
        </div>

        <!-- Barra Lateral (Sidebar) con Tonos Suaves e Iconos Claros -->
