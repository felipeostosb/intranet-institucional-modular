                                <span class="badge badge-ghost badge-xs text-[9px]">05</span>
                            </a>
                            <a href="/Docs?modulo=Modulo06" class="flex items-center justify-between px-3 py-1.5 rounded-xl text-slate-700 dark:text-slate-300 hover:bg-rose-50 dark:hover:bg-slate-800 font-medium transition">
                                <span>📋 Mód 06: Mesa de Partes</span>
                                <span class="badge badge-ghost badge-xs text-[9px]">06</span>
                            </a>
                            <a href="/Docs?modulo=Modulo07" class="flex items-center justify-between px-3 py-1.5 rounded-xl text-slate-700 dark:text-slate-300 hover:bg-teal-50 dark:hover:bg-slate-800 font-medium transition">
