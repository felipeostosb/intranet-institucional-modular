<!DOCTYPE html>
<html lang="es" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Intranet Institucional IESTP Argentina</title>
    
    <!-- Fuente Plus Jakarta Sans (Moderna, Legible y Vistosa) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdn.jsdelivr.net/npm/daisyui@4.12.10/dist/full.min.css" rel="stylesheet" type="text/css" />
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['"Plus Jakarta Sans"', 'sans-serif'],
                    },
                    colors: {
                        institucional: {
                            50: '#eff6ff',
                            100: '#dbeafe',
                            500: '#3b82f6',
                            600: '#2563eb',
                            700: '#1d4ed8',
                            800: '#1e40af',
                            900: '#1e3a8a'
                        }
                    }
                }
            }
        }
    </script>

    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#1d4ed8" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <link rel="icon" type="image/svg+xml" href="/icons/icon.svg" />

    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
        }
    </style>
</head>
<body class="bg-slate-50/80 min-h-screen flex flex-col text-slate-800 selection:bg-blue-500 selection:text-white">
    <div class="drawer lg:drawer-open flex-1">
        <input id="main-drawer" type="checkbox" class="drawer-toggle" />
        
        <div class="drawer-content flex flex-col">
            <!-- Barra Superior Azul Institucional Vistosa -->
            <div class="navbar bg-gradient-to-r from-blue-800 via-blue-700 to-indigo-800 text-white shadow-md sticky top-0 z-30 px-4 lg:px-8 h-16 min-h-0">
                <div class="flex-none lg:hidden">
                    <label for="main-drawer" aria-label="open sidebar" class="btn btn-square btn-ghost btn-sm text-white">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="inline-block w-6 h-6 stroke-current"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
                    </label>
                </div>
                <div class="flex-1 items-center gap-3">
                    <a href="/" class="flex items-center gap-3 group">
                        <div class="w-9 h-9 rounded-xl bg-white/10 backdrop-blur-md border border-white/20 text-white flex items-center justify-center font-bold text-sm shadow-sm group-hover:bg-white/20 transition">
                            🏛️
                        </div>
                        <div>
                            <div class="flex items-center gap-2">
                                <span class="text-sm sm:text-base font-bold tracking-tight text-white">
                                    IESTP "ARGENTINA"
                                </span>
                                <span class="text-[10px] bg-white/20 text-blue-100 px-2 py-0.5 rounded-full font-semibold border border-white/20 hidden sm:inline">
                                    INTRANET
                                </span>
                            </div>
                            <p class="text-[11px] text-blue-100/80 font-normal hidden sm:block">Plataforma Modular Institucional 2026</p>
                        </div>
                    </a>
                </div>
                
                <div class="flex-none gap-3">
                    <div class="badge bg-white/15 text-white border-white/20 text-xs font-semibold px-3 py-2 hidden md:flex items-center gap-1.5">
                        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                        <span>.NET 10 LTS</span>
                    </div>
                    
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="dropdown dropdown-end">
                            <div tabindex="0" role="button" class="btn btn-ghost btn-sm flex items-center gap-2.5 normal-case rounded-xl px-2.5 py-1.5 h-auto hover:bg-white/10 text-white">
                                <div class="w-8 h-8 rounded-xl bg-blue-500 text-white flex items-center justify-center text-xs font-bold shadow-inner">
                                    @(User.Identity.Name?[..Math.Min(2, User.Identity.Name.Length)].ToUpper() ?? "US")
                                </div>
                                <div class="text-left hidden md:block leading-tight">
                                    <p class="text-xs font-bold text-white">@User.Identity.Name</p>
                                    <p class="text-[10px] text-blue-200">@(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Alumno")</p>
                                </div>
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-blue-200" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
                            </div>
                            <ul tabindex="0" class="dropdown-content z-[1] menu p-2 shadow-2xl bg-white text-slate-800 rounded-2xl w-56 border border-slate-200 mt-2 text-xs">
                                <li class="px-3 py-1.5 text-[11px] text-slate-400 font-semibold uppercase">Sesión Iniciada</li>
                                <li class="px-3 py-0.5 text-xs font-bold text-blue-900">@User.Identity.Name</li>
                                <li class="px-3 py-0.5 text-[11px] text-slate-500">Rol: <span class="badge badge-sm badge-outline badge-primary font-semibold">@(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Alumno")</span></li>
                                <li class="divider my-1"></li>
                                <li>
                                    <a href="/Account/Logout" class="text-rose-600 hover:bg-rose-50 font-semibold flex items-center gap-2 rounded-xl py-2">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" /></svg>
                                        <span>Cerrar Sesión</span>
                                    </a>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a href="/Account/Login" class="btn bg-white hover:bg-blue-50 text-blue-800 btn-sm rounded-xl font-bold border-0 shadow-sm text-xs px-4">
                            Iniciar Sesión
                        </a>
                    }
                </div>
            </div>

            <!-- Contenido Principal -->
            <main class="flex-1 p-4 lg:p-8 max-w-7xl w-full mx-auto">
                @if (TempData["AlertaMensaje"] != null)
                {
                    var tipo = TempData["AlertaTipo"]?.ToString() ?? "info";
                    var claseAlerta = tipo switch
                    {
                        "success" => "alert-success bg-emerald-50 text-emerald-800 border-emerald-200",
                        "error" => "alert-error bg-rose-50 text-rose-800 border-rose-200",
                        _ => "alert-info bg-blue-50 text-blue-800 border-blue-200"
                    };

                    <div class="alert @claseAlerta shadow-sm rounded-2xl mb-6 flex items-center justify-between text-xs py-3 px-4">
                        <span>@TempData["AlertaMensaje"]</span>
                        <button class="btn btn-ghost btn-xs" onclick="this.parentElement.remove()">✕</button>
                    </div>
                }

                @RenderBody()
            </main>

            <!-- Footer Institucional -->
            <footer class="p-6 bg-white border-t border-slate-200 text-center text-xs text-slate-500">
                <div class="max-w-7xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-3">
                    <p class="font-medium">🏛️ Instituto de Educación Superior Tecnológico Público "Argentina" — Intranet 2026</p>
                    <p class="text-slate-400">9 Módulos Desacoplados • .NET 10 LTS • MariaDB 10.11</p>
                </div>
            </footer>
        </div>

        <!-- Barra Lateral (Sidebar) con Tonos Pasteles e Iconos Llamativos -->
        <div class="drawer-side z-40">
            <label for="main-drawer" aria-label="close sidebar" class="drawer-overlay"></label>
            <aside class="bg-white w-72 min-h-full border-r border-slate-200 flex flex-col shadow-sm">
                <!-- Encabezado Sidebar -->
                <div class="p-5 border-b border-slate-100 flex items-center gap-3 bg-slate-50/50">
                    <div class="w-10 h-10 rounded-2xl bg-blue-600 text-white flex items-center justify-center font-bold shadow-md shadow-blue-500/20 text-base">
                        AR
                    </div>
                    <div>
                        <h2 class="font-bold text-slate-900 text-sm">IESTP Argentina</h2>
                        <span class="text-[11px] text-blue-600 font-semibold bg-blue-50 px-2 py-0.5 rounded-full border border-blue-200">
                            Intranet Modular
                        </span>
                    </div>
                </div>

                <!-- Menú de Navegación -->
                <nav class="flex-1 p-3 space-y-1.5 overflow-y-auto">
                    <!-- Dashboard Principal -->
                    <a href="/" class="flex items-center gap-3 px-3.5 py-2.5 rounded-2xl text-slate-700 hover:bg-blue-50 hover:text-blue-700 transition font-medium text-xs group">
                        <div class="w-8 h-8 rounded-xl bg-blue-100/80 text-blue-700 flex items-center justify-center shrink-0 group-hover:scale-105 transition">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" /></svg>
                        </div>
                        <span>Panel Principal</span>
                    </a>

                    <div class="pt-3 pb-1 px-3.5">
                        <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Módulos del Sistema</span>
                    </div>

                    <!-- Módulo 01 (Sky Pastel) -->
                    <a href="/Modulo01" class="flex items-center justify-between px-3 py-2 rounded-2xl text-slate-700 hover:bg-sky-50 hover:text-sky-800 transition text-xs font-medium group">
                        <div class="flex items-center gap-3">
                            <div class="w-8 h-8 rounded-xl bg-sky-100 text-sky-700 flex items-center justify-center shrink-0 group-hover:scale-105 transition">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" /></svg>
                            </div>
                            <span class="truncate font-semibold">Módulo 01</span>
                        </div>
                        <span class="text-[10px] font-bold bg-sky-100 text-sky-700 px-2 py-0.5 rounded-lg border border-sky-200">Eq 01</span>
                    </a>

                    <!-- Módulo 02 (Indigo Pastel) -->
                    <a href="/Modulo02" class="flex items-center justify-between px-3 py-2 rounded-2xl text-slate-700 hover:bg-indigo-50 hover:text-indigo-800 transition text-xs font-medium group">
                        <div class="flex items-center gap-3">
                            <div class="w-8 h-8 rounded-xl bg-indigo-100 text-indigo-700 flex items-center justify-center shrink-0 group-hover:scale-105 transition">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>
                            </div>
                            <span class="truncate font-semibold">Módulo 02</span>
                        </div>
                        <span class="text-[10px] font-bold bg-indigo-100 text-indigo-700 px-2 py-0.5 rounded-lg border border-indigo-200">Eq 02</span>
                    </a>

                    <!-- Módulo 03 (Emerald Pastel) -->
                    <a href="/Modulo03" class="flex items-center justify-between px-3 py-2 rounded-2xl text-slate-700 hover:bg-emerald-50 hover:text-emerald-800 transition text-xs font-medium group">
                        <div class="flex items-center gap-3">
                            <div class="w-8 h-8 rounded-xl bg-emerald-100 text-emerald-700 flex items-center justify-center shrink-0 group-hover:scale-105 transition">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" /></svg>
                            </div>
                            <span class="truncate font-semibold">Módulo 03</span>
                        </div>
                        <span class="text-[10px] font-bold bg-emerald-100 text-emerald-700 px-2 py-0.5 rounded-lg border border-emerald-200">Eq 03</span>
                    </a>

                    <!-- Módulo 04 (Amber Pastel) -->
                    <a href="/Modulo04" class="flex items-center justify-between px-3 py-2 rounded-2xl text-slate-700 hover:bg-amber-50 hover:text-amber-800 transition text-xs font-medium group">
                        <div class="flex items-center gap-3">
                            <div class="w-8 h-8 rounded-xl bg-amber-100 text-amber-700 flex items-center justify-center shrink-0 group-hover:scale-105 transition">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 3.055A9.001 9.001 0 1020.945 13H11V3.055z" /></svg>
                            </div>
                            <span class="truncate font-semibold">Módulo 04</span>
                        </div>
                        <span class="text-[10px] font-bold bg-amber-100 text-amber-700 px-2 py-0.5 rounded-lg border border-amber-200">Eq 04</span>
                    </a>

                    <!-- Módulo 05 (Purple Pastel) -->
                    <a href="/Modulo05" class="flex items-center justify-between px-3 py-2 rounded-2xl text-slate-700 hover:bg-purple-50 hover:text-purple-800 transition text-xs font-medium group">
                        <div class="flex items-center gap-3">
                            <div class="w-8 h-8 rounded-xl bg-purple-100 text-purple-700 flex items-center justify-center shrink-0 group-hover:scale-105 transition">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" /></svg>
                            </div>
                            <span class="truncate font-semibold">Módulo 05</span>
                        </div>
                        <span class="text-[10px] font-bold bg-purple-100 text-purple-700 px-2 py-0.5 rounded-lg border border-purple-200">Eq 05</span>
                    </a>

                    <!-- Módulo 06 (Rose Pastel) -->
                    <a href="/Modulo06" class="flex items-center justify-between px-3 py-2 rounded-2xl text-slate-700 hover:bg-rose-50 hover:text-rose-800 transition text-xs font-medium group">
                        <div class="flex items-center gap-3">
                            <div class="w-8 h-8 rounded-xl bg-rose-100 text-rose-700 flex items-center justify-center shrink-0 group-hover:scale-105 transition">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
                            </div>
                            <span class="truncate font-semibold">Módulo 06</span>
                        </div>
                        <span class="text-[10px] font-bold bg-rose-100 text-rose-700 px-2 py-0.5 rounded-lg border border-rose-200">Eq 06</span>
                    </a>

                    <!-- Módulo 07 (Teal Pastel) -->
                    <a href="/Modulo07" class="flex items-center justify-between px-3 py-2 rounded-2xl text-slate-700 hover:bg-teal-50 hover:text-teal-800 transition text-xs font-medium group">
                        <div class="flex items-center gap-3">
                            <div class="w-8 h-8 rounded-xl bg-teal-100 text-teal-700 flex items-center justify-center shrink-0 group-hover:scale-105 transition">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>
                            </div>
                            <span class="truncate font-semibold">Módulo 07</span>
                        </div>
                        <span class="text-[10px] font-bold bg-teal-100 text-teal-700 px-2 py-0.5 rounded-lg border border-teal-200">Eq 07</span>
                    </a>

                    <!-- Módulo 08 (Orange Pastel) -->
                    <a href="/Modulo08" class="flex items-center justify-between px-3 py-2 rounded-2xl text-slate-700 hover:bg-orange-50 hover:text-orange-800 transition text-xs font-medium group">
                        <div class="flex items-center gap-3">
                            <div class="w-8 h-8 rounded-xl bg-orange-100 text-orange-700 flex items-center justify-center shrink-0 group-hover:scale-105 transition">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
                            </div>
                            <span class="truncate font-semibold">Módulo 08</span>
                        </div>
                        <span class="text-[10px] font-bold bg-orange-100 text-orange-700 px-2 py-0.5 rounded-lg border border-orange-200">Eq 08</span>
                    </a>

                    <!-- Módulo 09 (Cyan Pastel) -->
                    <a href="/Modulo09" class="flex items-center justify-between px-3 py-2 rounded-2xl text-slate-700 hover:bg-cyan-50 hover:text-cyan-800 transition text-xs font-medium group">
                        <div class="flex items-center gap-3">
                            <div class="w-8 h-8 rounded-xl bg-cyan-100 text-cyan-700 flex items-center justify-center shrink-0 group-hover:scale-105 transition">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                            </div>
                            <span class="truncate font-semibold">Módulo 09</span>
                        </div>
                        <span class="text-[10px] font-bold bg-cyan-100 text-cyan-700 px-2 py-0.5 rounded-lg border border-cyan-200">Eq 09</span>
                    </a>
                </nav>
            </aside>
        </div>
    </div>
</body>
</html>
