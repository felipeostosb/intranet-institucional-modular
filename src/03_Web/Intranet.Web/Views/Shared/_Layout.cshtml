<!DOCTYPE html>
<html lang="es" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AQUILA A-ERP | IESTP Argentina</title>
    
    <!-- Tipografía Moderna: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    
    <!-- DaisyUI + TailwindCSS -->
    <link href="https://cdn.jsdelivr.net/npm/daisyui@4.7.2/dist/full.min.css" rel="stylesheet" type="text/css" />
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Configuración Personalizada de Tailwind con Paleta Cuidado Ocular Anti-Fatiga -->
    <script>
        tailwind.config = {
            darkMode: ['class', '[data-theme="dark"]'],
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['"Plus Jakarta Sans"', 'system-ui', 'sans-serif'],
                    },
                    colors: {
                        aquila: {
                            50: '#f0f7ff',
                            100: '#e0effe',
                            200: '#bae0fd',
                            500: '#0ea5e9',
                            700: '#0369a1',
                            900: '#0c4a6e',
                            950: '#082f49',
                        }
                    }
                }
            }
        }
    </script>

    <!-- Script Anti-Parpadeo Inmediato (Carga el tema guardado antes de renderizar) -->
    <script>
        (function() {
            try {
                const savedTheme = localStorage.getItem('aquila-theme') || 'light';
                document.documentElement.setAttribute('data-theme', savedTheme);
                if (savedTheme === 'dark') {
                    document.documentElement.classList.add('dark');
                } else {
                    document.documentElement.classList.remove('dark');
                }
            } catch (e) {}
        })();
    </script>

    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#0b132b" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <link rel="icon" type="image/svg+xml" href="/icons/icon.svg" />

    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            transition: background-color 0.2s ease, color 0.2s ease;
        }
        [data-theme="dark"] {
            color-scheme: dark;
        }
        [data-theme="light"] {
            color-scheme: light;
        }
        html {
            scroll-behavior: smooth;
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="bg-slate-50 dark:bg-[#0b0f19] min-h-screen flex flex-col text-slate-800 dark:text-slate-200 selection:bg-blue-600 selection:text-white transition-colors duration-200">
@{
    var path = Context.Request.Path.Value?.ToLowerInvariant() ?? "";
    var isDocsSection = path.StartsWith("/docs") || path.StartsWith("/tutoriales") || path.StartsWith("/documentacion");
    var isAuth = User.Identity?.IsAuthenticated == true;
    var rawRol = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Alumno";
    var activeRole = User.FindFirst("ActiveRole")?.Value ?? rawRol;
    var userRoles = User.FindAll(System.Security.Claims.ClaimTypes.Role).Select(r => r.Value).Distinct().ToList();
    if (User.IsInRole("Director") || User.IsInRole("Admin"))
    {
        userRoles = new List<string> { "Director", "Docente", "Alumno", "Coordinador" };
    }
}

@if (isDocsSection)
{
    <!-- ========================================================================= -->
    <!-- 📚 LAYOUT ESPECIALIZADO: CENTRO DE DOCUMENTACIÓN & ACADEMIA MULTIMEDIA   -->
    <!-- ========================================================================= -->
    <div class="drawer lg:drawer-open flex-1">
        <input id="main-drawer" type="checkbox" class="drawer-toggle" />
        
        <div class="drawer-content flex flex-col">
            <!-- Barra Superior Minimalista de Documentación -->
            <header class="navbar bg-slate-900/95 dark:bg-[#0f172a]/95 backdrop-blur-md text-white shadow-sm sticky top-0 z-30 px-4 lg:px-8 h-16 min-h-0 border-b border-slate-800 transition-colors">
                <div class="flex-none lg:hidden">
                    <label for="main-drawer" aria-label="Abrir menú" class="btn btn-square btn-ghost btn-sm text-white">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="w-5 h-5 stroke-current"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
                    </label>
                </div>
                <div class="flex-1 items-center gap-3">
                    <a href="/Docs" class="flex items-center gap-2.5 group">
                        <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-slate-900 to-blue-950 border border-cyan-400/40 p-1.5 flex items-center justify-center shadow-sm shrink-0">
                            <svg viewBox="0 0 100 100" class="w-full h-full drop-shadow-[0_0_6px_rgba(56,189,248,0.7)]" fill="none">
                                <defs>
                                    <linearGradient id="docNavWingL" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#38bdf8" /><stop offset="100%" stop-color="#1d4ed8" /></linearGradient>
                                    <linearGradient id="docNavWingR" x1="100%" y1="0%" x2="0%" y2="100%"><stop offset="0%" stop-color="#60a5fa" /><stop offset="100%" stop-color="#2563eb" /></linearGradient>
                                    <linearGradient id="docNavCore" x1="0%" y1="0%" x2="0%" y2="100%"><stop offset="0%" stop-color="#ffffff" /><stop offset="100%" stop-color="#93c5fd" /></linearGradient>
                                </defs>
                                <polygon points="48,10 4,68 32,60 46,38" fill="url(#docNavWingL)" />
                                <polygon points="52,10 96,68 68,60 54,38" fill="url(#docNavWingR)" />
                                <polygon points="50,6 43,44 50,88 57,44" fill="url(#docNavCore)" />
                                <polygon points="50,22 46,44 50,70 54,44" fill="#0284c7" />
                            </svg>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="text-base font-black tracking-tight text-white">AQUILA</span>
                            <span class="text-[10px] bg-cyan-500/20 text-cyan-300 px-2 py-0.5 rounded font-bold border border-cyan-500/30">DOCS</span>
                        </div>
                    </a>
                </div>
                
                <div class="flex-none items-center gap-2">
                    <!-- Botón Modo Oscuro -->
                    <button type="button" onclick="toggleAquilaTheme()" class="btn btn-ghost btn-sm btn-circle text-amber-300 hover:bg-white/10 transition" title="Alternar Modo Oscuro">
                        <svg class="theme-icon-sun w-5 h-5 hidden text-amber-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
                        <svg class="theme-icon-moon w-5 h-5 text-cyan-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" /></svg>
                    </button>

                    <!-- Botón Volver a la Intranet -->
                    <a href="/" class="btn btn-sm btn-primary rounded-xl text-xs font-semibold gap-1.5 shadow-sm">
                        <span>← Volver a la Intranet</span>
                    </a>
                </div>
            </header>

            <!-- Contenido Principal de Docs -->
            <main class="flex-1 p-4 lg:p-8 max-w-7xl w-full mx-auto">
                @if (TempData["AlertaMensaje"] != null)
                {
                    var tipo = TempData["AlertaTipo"]?.ToString() ?? "info";
                    var claseAlerta = tipo switch
                    {
                        "success" => "alert-success bg-emerald-50 dark:bg-emerald-950/40 text-emerald-800 dark:text-emerald-300 border-emerald-200 dark:border-emerald-800",
                        "error" => "alert-error bg-rose-50 dark:bg-rose-950/40 text-rose-800 dark:text-rose-300 border-rose-200 dark:border-rose-800",
                        _ => "alert-info bg-blue-50 dark:bg-blue-950/40 text-blue-800 dark:text-blue-300 border-blue-200 dark:border-blue-800"
                    };

                    <div class="alert @claseAlerta shadow-sm rounded-2xl mb-6 flex items-center justify-between text-xs py-3 px-4">
                        <span>@TempData["AlertaMensaje"]</span>
                        <button class="btn btn-ghost btn-xs" onclick="this.parentElement.remove()">✕</button>
                    </div>
                }

                @RenderBody()
            </main>

            <!-- Footer Minimalista -->
            <footer class="p-5 bg-white dark:bg-[#0f172a] border-t border-slate-200 dark:border-slate-800 text-center text-xs text-slate-500 dark:text-slate-400">
                <div class="max-w-7xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-2">
                    <p class="font-medium">AQUILA A-ERP • Centro de Documentación</p>
                    <p class="text-slate-400 dark:text-slate-500">IESTP "Argentina" 2026</p>
                </div>
            </footer>
        </div>

        <!-- Barra Lateral de Documentación (Zen, Completa & Funcional) -->
        <div class="drawer-side z-40">
            <label for="main-drawer" aria-label="Cerrar menú" class="drawer-overlay"></label>
            <aside class="bg-white dark:bg-[#0f172a] w-64 min-h-full border-r border-slate-200 dark:border-slate-800 flex flex-col shadow-sm">
                
                <div class="p-4 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <span class="text-xs font-black text-slate-900 dark:text-slate-100 uppercase tracking-wider">📚 Manuales & Guías</span>
                    </div>
                    <a href="/" class="text-xs text-blue-600 dark:text-cyan-400 font-semibold hover:underline" title="Regresar al ERP">← Salir</a>
                </div>

                <nav class="flex-1 p-3 space-y-3 overflow-y-auto text-xs font-medium">
                    <!-- 1. Setup & Clonación -->
                    <div>
                        <span class="px-2.5 py-1 text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider block">1. Setup & Onboarding</span>
                        <div class="space-y-0.5 mt-1">
                            <a href="#onboarding" class="docs-nav-link flex items-center gap-2 px-2.5 py-1.5 rounded-xl text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800/60 transition">
                                <span>⚡</span>
                                <span>Clonar & CLI dev.sh</span>
                            </a>
                        </div>
                    </div>

                    <!-- 2. Manuales por Rol -->
                    <div>
                        <span class="px-2.5 py-1 text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider block">2. Manuales por Rol</span>
                        <div class="space-y-0.5 mt-1">
                            <a href="#product-owner" class="docs-nav-link flex items-center gap-2 px-2.5 py-1.5 rounded-xl text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800/60 transition">
                                <span>👑</span>
                                <span>Product Owner (PO)</span>
                            </a>
                            <a href="#scrum-master" class="docs-nav-link flex items-center gap-2 px-2.5 py-1.5 rounded-xl text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800/60 transition">
                                <span>🏃</span>
                                <span>Scrum Master (SM)</span>
                            </a>
                            <a href="#database" class="docs-nav-link flex items-center gap-2 px-2.5 py-1.5 rounded-xl text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800/60 transition">
                                <span>🗄️</span>
                                <span>Especialista BD (DBA)</span>
                            </a>
                            <a href="#qa-tester" class="docs-nav-link flex items-center gap-2 px-2.5 py-1.5 rounded-xl text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800/60 transition">
                                <span>🧪</span>
                                <span>Especialista QA (Tester)</span>
                            </a>
                        </div>
                    </div>

                    <!-- 3. Protocolo de Trabajo Conjunto -->
                    <div>
                        <span class="px-2.5 py-1 text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider block">3. Flujo en Equipo</span>
                        <div class="space-y-0.5 mt-1">
                            <a href="#sinergia" class="docs-nav-link flex items-center gap-2 px-2.5 py-1.5 rounded-xl text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800/60 transition">
                                <span>🤝</span>
                                <span>Ciclo de 4 Pasos (Sinergia)</span>
                            </a>
                            <a href="#modulos" class="docs-nav-link flex items-center gap-2 px-2.5 py-1.5 rounded-xl text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800/60 transition">
                                <span>🏢</span>
                                <span>Directorio 10 Módulos</span>
                            </a>
                        </div>
                    </div>

                    <!-- 4. Videos & Demos -->
                    <div>
                        <span class="px-2.5 py-1 text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider block">4. Academia Multimedia</span>
                        <div class="space-y-0.5 mt-1">
                            <a href="#videos" class="docs-nav-link flex items-center gap-2 px-2.5 py-1.5 rounded-xl text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800/60 transition">
                                <span>📹</span>
                                <span>Videotutoriales HD</span>
                            </a>
                        </div>
                    </div>
                </nav>

                <div class="p-3 border-t border-slate-100 dark:border-slate-800 space-y-2">
                    <button type="button" onclick="modal_nuevo_tutorial.showModal()" class="btn btn-primary btn-sm w-full rounded-xl text-xs font-bold gap-1.5 shadow-sm">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                        + Publicar Video
                    </button>
                    <a href="http://35.206.81.32:8080" target="_blank" class="btn btn-ghost btn-xs w-full text-slate-500 hover:text-slate-800 dark:hover:text-slate-200 text-[11px] gap-1">
                        <span>Adminer PostgreSQL</span>
                        <span class="text-[10px]">↗</span>
                    </a>
                </div>
            </aside>
        </div>
    </div>
}
else if (isAuth)
{
    <!-- ========================================================================= -->
    <!-- 🏢 LAYOUT OPERATIVO ERP: ZEN & MINIMALISTA CON SELECTOR INTELIGENTE       -->
    <!-- ========================================================================= -->
    <div class="drawer lg:drawer-open flex-1">
        <input id="main-drawer" type="checkbox" class="drawer-toggle" />
        
        <div class="drawer-content flex flex-col">
            <!-- Barra Superior Zen: Limpia con Selector de Contexto -->
            <header class="navbar bg-slate-900/95 dark:bg-[#0f172a]/95 backdrop-blur-md text-white shadow-sm sticky top-0 z-30 px-4 lg:px-8 h-16 min-h-0 border-b border-slate-800 transition-colors">
                <div class="flex-none lg:hidden">
                    <label for="main-drawer" aria-label="Abrir menú" class="btn btn-square btn-ghost btn-sm text-white">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="w-5 h-5 stroke-current"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
                    </label>
                </div>
                <div class="flex-1 items-center gap-3">
                    <a href="/" class="flex items-center gap-2.5 group">
                        <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-slate-900 to-blue-950 border border-cyan-400/40 p-1.5 flex items-center justify-center shadow-sm shrink-0">
                            <svg viewBox="0 0 100 100" class="w-full h-full drop-shadow-[0_0_6px_rgba(56,189,248,0.7)]" fill="none">
                                <defs>
                                    <linearGradient id="navWingL" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#38bdf8" /><stop offset="100%" stop-color="#1d4ed8" /></linearGradient>
                                    <linearGradient id="navWingR" x1="100%" y1="0%" x2="0%" y2="100%"><stop offset="0%" stop-color="#60a5fa" /><stop offset="100%" stop-color="#2563eb" /></linearGradient>
                                    <linearGradient id="navCore" x1="0%" y1="0%" x2="0%" y2="100%"><stop offset="0%" stop-color="#ffffff" /><stop offset="100%" stop-color="#93c5fd" /></linearGradient>
                                </defs>
                                <polygon points="48,10 4,68 32,60 46,38" fill="url(#navWingL)" />
                                <polygon points="52,10 96,68 68,60 54,38" fill="url(#navWingR)" />
                                <polygon points="50,6 43,44 50,88 57,44" fill="url(#navCore)" />
                                <polygon points="50,22 46,44 50,70 54,44" fill="#0284c7" />
                            </svg>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="text-base font-black tracking-tight text-white">AQUILA</span>
                            <span class="text-[10px] bg-cyan-500/20 text-cyan-300 px-2 py-0.5 rounded font-bold border border-cyan-500/30">A-ERP</span>
                        </div>
                    </a>
                </div>
                
                <div class="flex-none items-center gap-2.5">
                    <!-- 🎭 SELECTOR INTELIGENTE DE ROL ACTIVO ("UN SOLO SOMBRERO A LA VEZ") -->
                    @if (userRoles.Count > 1)
                    {
                        <div class="dropdown dropdown-end">
                            <div tabindex="0" role="button" class="btn btn-ghost btn-xs rounded-xl bg-slate-800/90 hover:bg-slate-700/90 text-cyan-300 border border-slate-700/80 font-bold gap-1.5 px-3 py-1 h-8 shadow-sm transition" title="Cambiar sombrero o vista contextual">
                                <span class="text-xs">
                                    @(activeRole switch
                                    {
                                        "Director" => "🏛️",
                                        "Docente" => "👨‍🏫",
                                        "Alumno" or "Estudiante" => "🎓",
                                        "Coordinador" => "📋",
                                        _ => "🎭"
                                    })
                                </span>
                                <span class="text-[11px] font-bold tracking-tight">Modo @activeRole</span>
                                <svg class="w-3 h-3 text-slate-400 ml-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                            </div>
                            <ul tabindex="0" class="dropdown-content z-[20] menu p-1.5 shadow-2xl bg-white dark:bg-slate-900 text-slate-800 dark:text-slate-200 rounded-2xl w-48 border border-slate-200 dark:border-slate-800 mt-1 text-xs">
                                <li class="px-2.5 py-1 text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Cambiar Contexto</li>
                                @foreach (var r in userRoles)
                                {
                                    var isCurrent = r.Equals(activeRole, StringComparison.OrdinalIgnoreCase);
                                    <li>
                                        <a href="/Account/CambiarRol?rol=@r&returnUrl=@Context.Request.Path" class="flex items-center justify-between py-2 rounded-xl @(isCurrent ? "font-bold text-cyan-600 dark:text-cyan-400 bg-cyan-50 dark:bg-cyan-950/40" : "text-slate-700 dark:text-slate-300")">
                                            <span>
                                                @(r switch
                                                {
                                                    "Director" => "🏛️ Director",
                                                    "Docente" => "👨‍🏫 Docente",
                                                    "Alumno" or "Estudiante" => "🎓 Estudiante",
                                                    "Coordinador" => "📋 Coordinador",
                                                    _ => r
                                                })
                                            </span>
                                            @if (isCurrent)
                                            {
                                                <span class="text-xs text-cyan-500 font-bold">✓</span>
                                            }
                                        </a>
                                    </li>
                                }
                            </ul>
                        </div>
                    }

                    <!-- Enlace directo a Documentación & Tutoriales -->
                    <a href="/Docs" class="btn btn-ghost btn-sm text-slate-300 hover:text-white rounded-xl text-xs font-medium gap-1.5">
                        <svg class="w-4 h-4 text-cyan-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
                        <span class="hidden sm:inline">Guías & Videos</span>
                    </a>

                    <!-- Botón Modo Oscuro -->
                    <button type="button" onclick="toggleAquilaTheme()" class="btn btn-ghost btn-sm btn-circle text-amber-300 hover:bg-white/10 transition" title="Alternar Modo Oscuro">
                        <svg class="theme-icon-sun w-5 h-5 hidden text-amber-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
                        <svg class="theme-icon-moon w-5 h-5 text-cyan-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" /></svg>
                    </button>
                    
                    <!-- Menú de Usuario Compacto -->
                    <div class="dropdown dropdown-end">
                        <div tabindex="0" role="button" class="btn btn-ghost btn-sm flex items-center gap-2 normal-case rounded-xl px-2 py-1.5 h-auto hover:bg-white/10 text-white">
                            <div class="w-7 h-7 rounded-lg bg-gradient-to-tr from-blue-600 to-indigo-600 text-white flex items-center justify-center text-xs font-bold shadow-inner">
                                @(User.Identity?.Name?[..Math.Min(2, User.Identity.Name.Length)].ToUpper() ?? "US")
                            </div>
                            <span class="text-xs font-semibold hidden md:inline">@User.Identity?.Name</span>
                            <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
                        </div>
                        <ul tabindex="0" class="dropdown-content z-[20] menu p-2 shadow-xl bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-200 rounded-2xl w-52 border border-slate-200 dark:border-slate-700 mt-2 text-xs">
                            <li class="px-3 py-1 text-[11px] text-slate-400 font-semibold uppercase">Rol Activo: @activeRole</li>
                            <li>
