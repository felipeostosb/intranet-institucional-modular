                        <svg viewBox="0 0 100 100" class="w-full h-full drop-shadow-[0_0_6px_rgba(56,189,248,0.6)]" fill="none">
                            <defs>
                                <linearGradient id="sideWingL" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#38bdf8" /><stop offset="100%" stop-color="#1d4ed8" /></linearGradient>
                                <linearGradient id="sideWingR" x1="100%" y1="0%" x2="0%" y2="100%"><stop offset="0%" stop-color="#60a5fa" /><stop offset="100%" stop-color="#2563eb" /></linearGradient>
                                <linearGradient id="sideCore" x1="0%" y1="0%" x2="0%" y2="100%"><stop offset="0%" stop-color="#ffffff" /><stop offset="100%" stop-color="#93c5fd" /></linearGradient>
                            </defs>
                            <polygon points="48,10 4,68 32,60 46,38" fill="url(#sideWingL)" />
                            <polygon points="52,10 96,68 68,60 54,38" fill="url(#sideWingR)" />
                            <polygon points="50,6 43,44 50,88 57,44" fill="url(#sideCore)" />
                            <polygon points="50,22 46,44 50,70 54,44" fill="#0284c7" />
                        </svg>
                    </div>
                    <div>
                        <div class="flex items-center gap-1.5">
                            <h2 class="font-black text-slate-900 dark:text-slate-100 text-sm tracking-tight">AQUILA</h2>
                            <span class="text-[9px] bg-blue-100 dark:bg-blue-950 text-blue-800 dark:text-cyan-300 font-extrabold px-1.5 py-0.5 rounded border border-blue-200 dark:border-blue-800">A-ERP</span>
                        </div>
                        <span class="text-[10px] text-blue-700 dark:text-cyan-400 font-semibold block -mt-0.5">
                            Intranet Institucional
                        </span>
                    </div>
                </div>

                <!-- Menú de Navegación -->
                <nav class="flex-1 p-3 space-y-1.5 overflow-y-auto">
                    <!-- Dashboard Principal -->
                    <a href="/" class="flex items-center gap-3 px-3.5 py-2.5 rounded-2xl text-slate-700 dark:text-slate-300 hover:bg-blue-50 dark:hover:bg-slate-800 hover:text-blue-700 dark:hover:text-cyan-300 transition font-medium text-xs group">
                        <div class="w-8 h-8 rounded-xl bg-blue-100/80 dark:bg-blue-950 text-blue-700 dark:text-cyan-300 flex items-center justify-center shrink-0 group-hover:scale-105 transition">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" /></svg>
                        </div>
