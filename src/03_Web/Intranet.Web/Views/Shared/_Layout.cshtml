                    <div class="pt-3 pb-1 px-3.5">
                        <span class="text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Módulos del Sistema</span>
                    </div>

                    <!-- Módulo 00 (Slate) - Seguridad & Login (Toro) -->
                    <a href="/Modulo00" class="flex items-center justify-between px-3 py-2 rounded-2xl text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-slate-100 transition text-xs font-medium group">
                        <div class="flex items-center gap-3">
