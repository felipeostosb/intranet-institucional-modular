<!DOCTYPE html>
<html lang="es" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - IESTP Argentina</title>
    
    <!-- Fuente Montserrat Oficial (Pesos Finos y Elegantes 300, 400, 500, 600) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600&display=swap" rel="stylesheet">

    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdn.jsdelivr.net/npm/daisyui@4.12.10/dist/full.min.css" rel="stylesheet" type="text/css" />
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Montserrat', '-apple-system', 'BlinkMacSystemFont', 'sans-serif'],
                    },
                    colors: {
                        apple: {
                            blue: '#0071e3',
                            hover: '#0077ed',
                            bg: '#fbfbfd',
                            sidebar: '#f5f5f7',
                            border: '#e5e5e7',
                            subtext: '#86868b',
                            card: '#ffffff'
                        }
                    }
                }
            }
        }
    </script>

    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <link rel="icon" type="image/svg+xml" href="/icons/icon.svg" />

    <style>
        body {
            font-family: 'Montserrat', -apple-system, BlinkMacSystemFont, sans-serif;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            letter-spacing: -0.015em;
        }
    </style>
</head>
<body class="bg-[#fbfbfd] min-h-screen flex flex-col text-slate-800 font-light selection:bg-slate-200">
    <div class="drawer lg:drawer-open flex-1">
        <input id="main-drawer" type="checkbox" class="drawer-toggle" />
        
        <div class="drawer-content flex flex-col">
            <!-- Barra Superior (Apple Glass Navbar) -->
            <div class="navbar bg-white/80 backdrop-blur-xl sticky top-0 z-30 px-4 lg:px-8 border-b border-[#e5e5e7]/80 h-14 min-h-0">
                <div class="flex-none lg:hidden">
                    <label for="main-drawer" aria-label="open sidebar" class="btn btn-square btn-ghost btn-sm text-slate-500">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="inline-block w-5 h-5 stroke-current"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16"></path></svg>
                    </label>
                </div>
                <div class="flex-1 items-center gap-2.5">
                    <a href="/" class="flex items-center gap-2">
                        <div class="w-6 h-6 rounded-lg bg-slate-900 text-white flex items-center justify-center font-medium text-[11px]">
                            AR
                        </div>
                        <span class="text-xs sm:text-sm font-medium tracking-tight text-slate-900">
                            IESTP Argentina
                        </span>
                        <span class="text-[11px] text-slate-400 font-light hidden sm:inline">| Intranet</span>
                    </a>
                </div>
                
                <div class="flex-none gap-2.5">
                    <span class="text-[11px] font-normal text-slate-400 bg-[#f5f5f7] px-2.5 py-1 rounded-full border border-slate-200/60 hidden sm:inline">
                        2026-II
                    </span>
                    
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="dropdown dropdown-end">
                            <div tabindex="0" role="button" class="btn btn-ghost btn-xs flex items-center gap-2 normal-case rounded-full px-2 py-1 h-auto hover:bg-slate-100">
                                <div class="w-6 h-6 rounded-full bg-slate-200 text-slate-700 flex items-center justify-center text-[10px] font-medium">
                                    @(User.Identity.Name?[..Math.Min(2, User.Identity.Name.Length)].ToUpper() ?? "US")
                                </div>
                                <div class="text-left hidden md:block leading-tight">
                                    <p class="text-xs font-normal text-slate-900">@User.Identity.Name</p>
                                </div>
                                <span class="text-[10px] text-slate-400 font-light">▾</span>
                            </div>
                            <ul tabindex="0" class="dropdown-content z-[1] menu p-1.5 shadow-[0_10px_30px_rgba(0,0,0,0.08)] bg-white rounded-2xl w-52 border border-slate-200/80 mt-2 text-xs">
                                <li class="px-3 py-1.5 text-[11px] text-slate-400 font-normal">Cuenta activa</li>
                                <li class="px-3 py-0.5 text-xs font-medium text-slate-900">@User.Identity.Name</li>
                                <li class="px-3 py-0.5 text-[11px] text-slate-500 font-light">Rol: @(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Alumno")</li>
                                <li class="divider my-1"></li>
                                <li>
                                    <a href="/Account/Logout" class="text-rose-600 hover:bg-rose-50 font-normal flex items-center gap-2 rounded-xl py-1.5">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" /></svg>
                                        <span>Cerrar Sesión</span>
                                    </a>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a href="/Account/Login" class="btn bg-[#0071e3] hover:bg-[#0077ed] text-white btn-xs px-3 py-1 rounded-full font-normal border-0 text-[11px] h-7">
                            Ingresar
                        </a>
                    }
                </div>
            </div>

            <!-- Contenido Principal -->
            <main class="flex-1 p-4 lg:p-8 max-w-6xl w-full mx-auto">
                @if (TempData["AlertaMensaje"] != null)
                {
                    <div role="alert" class="bg-white border border-slate-200 shadow-sm p-3.5 mb-6 text-xs text-slate-700 font-light rounded-2xl flex items-center justify-between">
                        <span>@TempData["AlertaMensaje"]</span>
                    </div>
                }

                @RenderBody()
            </main>

            <!-- Footer Minimalista Apple -->
            <footer class="footer footer-center p-6 bg-transparent text-slate-400 text-xs font-light">
                <div>
                    <p>© @DateTime.Now.Year IESTP "Argentina" • Av. Alfonso Ugarte 599, Lima • Arquitectura .NET 10</p>
                </div>
            </footer>
        </div> 

        <!-- Sidebar (macOS System Settings Style con Iconos Pasteles) -->
        <div class="drawer-side z-40">
            <label for="main-drawer" aria-label="close sidebar" class="drawer-overlay"></label> 
            <aside class="bg-[#f5f5f7]/80 backdrop-blur-xl w-64 min-h-screen border-r border-[#e5e5e7] flex flex-col p-3 shadow-none">
                <div class="px-3 py-3 mb-1 flex items-center gap-2.5">
                    <div class="w-7 h-7 rounded-xl bg-gradient-to-br from-sky-500 to-blue-600 text-white flex items-center justify-center font-medium text-xs shadow-sm shadow-sky-500/20">
                        AR
                    </div>
                    <div>
                        <h2 class="text-xs font-medium text-slate-900 tracking-tight leading-tight">IESTP Argentina</h2>
                        <p class="text-[10px] text-slate-400 font-light">Intranet Modular ERP</p>
                    </div>
                </div>

                <ul class="menu menu-xs w-full space-y-1 flex-1 text-slate-600 font-light p-0">
                    <li>
                        <a href="/" class="flex items-center gap-2.5 px-3 py-2 rounded-xl hover:bg-slate-200/60 transition text-slate-900 font-normal text-xs">
                            <div class="w-6 h-6 rounded-lg bg-blue-100 text-blue-600 flex items-center justify-center shrink-0">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" /></svg>
                            </div>
                            <span>Dashboard General</span>
                        </a>
                    </li>
                    <li class="menu-title pt-3 pb-1 px-3 text-[10px] font-medium uppercase tracking-wider text-slate-400">Módulos (9)</li>
                    <li>
                        <a href="/Modulo01" class="flex items-center justify-between px-2.5 py-1.5 rounded-xl hover:bg-slate-200/60 transition text-xs text-slate-700">
                            <div class="flex items-center gap-2">
                                <div class="w-6 h-6 rounded-lg bg-sky-100 text-sky-600 flex items-center justify-center shrink-0">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" /></svg>
                                </div>
                                <span class="font-normal">Admisión</span>
                            </div>
                            <span class="text-[9px] font-mono bg-sky-50 text-sky-600 px-1.5 py-0.5 rounded border border-sky-200/60">M01</span>
                        </a>
                    </li>
                    <li>
                        <a href="/Modulo02" class="flex items-center justify-between px-2.5 py-1.5 rounded-xl hover:bg-slate-200/60 transition text-xs text-slate-700">
                            <div class="flex items-center gap-2">
                                <div class="w-6 h-6 rounded-lg bg-indigo-100 text-indigo-600 flex items-center justify-center shrink-0">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 14l9-5-9-5-9 5 9 5z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" /></svg>
                                </div>
                                <span class="font-normal">Matrícula</span>
                            </div>
                            <span class="text-[9px] font-mono bg-indigo-50 text-indigo-600 px-1.5 py-0.5 rounded border border-indigo-200/60">M02</span>
                        </a>
                    </li>
                    <li>
                        <a href="/Modulo03" class="flex items-center justify-between px-2.5 py-1.5 rounded-xl hover:bg-slate-200/60 transition text-xs text-slate-700">
                            <div class="flex items-center gap-2">
                                <div class="w-6 h-6 rounded-lg bg-emerald-100 text-emerald-600 flex items-center justify-center shrink-0">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
                                </div>
                                <span class="font-normal">Gestión Docente</span>
                            </div>
                            <span class="text-[9px] font-mono bg-emerald-50 text-emerald-600 px-1.5 py-0.5 rounded border border-emerald-200/60">M03</span>
                        </a>
                    </li>
                    <li>
                        <a href="/Modulo04" class="flex items-center justify-between px-2.5 py-1.5 rounded-xl hover:bg-slate-200/60 transition text-xs text-slate-700">
                            <div class="flex items-center gap-2">
                                <div class="w-6 h-6 rounded-lg bg-amber-100 text-amber-600 flex items-center justify-center shrink-0">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                                </div>
                                <span class="font-normal">Calificaciones</span>
                            </div>
                            <span class="text-[9px] font-mono bg-amber-50 text-amber-600 px-1.5 py-0.5 rounded border border-amber-200/60">M04</span>
                        </a>
                    </li>
                    <li>
                        <a href="/Modulo05" class="flex items-center justify-between px-2.5 py-1.5 rounded-xl hover:bg-slate-200/60 transition text-xs text-slate-700">
                            <div class="flex items-center gap-2">
                                <div class="w-6 h-6 rounded-lg bg-purple-100 text-purple-600 flex items-center justify-center shrink-0">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z" /></svg>
                                </div>
                                <span class="font-normal">Tesorería</span>
                            </div>
                            <span class="text-[9px] font-mono bg-purple-50 text-purple-600 px-1.5 py-0.5 rounded border border-purple-200/60">M05</span>
                        </a>
                    </li>
                    <li>
                        <a href="/Modulo06" class="flex items-center justify-between px-2.5 py-1.5 rounded-xl hover:bg-slate-200/60 transition text-xs text-slate-700">
                            <div class="flex items-center gap-2">
                                <div class="w-6 h-6 rounded-lg bg-rose-100 text-rose-600 flex items-center justify-center shrink-0">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>
                                </div>
                                <span class="font-normal">Biblioteca</span>
                            </div>
                            <span class="text-[9px] font-mono bg-rose-50 text-rose-600 px-1.5 py-0.5 rounded border border-rose-200/60">M06</span>
                        </a>
                    </li>
                    <li>
                        <a href="/Modulo07" class="flex items-center justify-between px-2.5 py-1.5 rounded-xl hover:bg-slate-200/60 transition text-xs text-slate-700">
                            <div class="flex items-center gap-2">
                                <div class="w-6 h-6 rounded-lg bg-teal-100 text-teal-600 flex items-center justify-center shrink-0">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
                                </div>
                                <span class="font-normal">Mesa de Partes</span>
                            </div>
                            <span class="text-[9px] font-mono bg-teal-50 text-teal-600 px-1.5 py-0.5 rounded border border-teal-200/60">M07</span>
                        </a>
                    </li>
                    <li>
                        <a href="/Modulo08" class="flex items-center justify-between px-2.5 py-1.5 rounded-xl hover:bg-slate-200/60 transition text-xs text-slate-700">
                            <div class="flex items-center gap-2">
                                <div class="w-6 h-6 rounded-lg bg-orange-100 text-orange-600 flex items-center justify-center shrink-0">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>
                                </div>
                                <span class="font-normal">Prácticas EFSRT</span>
                            </div>
                            <span class="text-[9px] font-mono bg-orange-50 text-orange-600 px-1.5 py-0.5 rounded border border-orange-200/60">M08</span>
                        </a>
                    </li>
                    <li>
                        <a href="/Modulo09" class="flex items-center justify-between px-2.5 py-1.5 rounded-xl hover:bg-slate-200/60 transition text-xs text-slate-700">
                            <div class="flex items-center gap-2">
                                <div class="w-6 h-6 rounded-lg bg-cyan-100 text-cyan-600 flex items-center justify-center shrink-0">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
                                </div>
                                <span class="font-normal">Mesa de Ayuda TI</span>
                            </div>
                            <span class="text-[9px] font-mono bg-cyan-50 text-cyan-600 px-1.5 py-0.5 rounded border border-cyan-200/60">M09</span>
                        </a>
                    </li>
                </ul>
            </aside>
        </div>
    </div>

    @await RenderSectionAsync("Scripts", required: false)

    <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/service-worker.js')
                    .then(reg => console.log('SW activo:', reg.scope))
                    .catch(err => console.log('SW error:', err));
            });
        }
    </script>
</body>
</html>
