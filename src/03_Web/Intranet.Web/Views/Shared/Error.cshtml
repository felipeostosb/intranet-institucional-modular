@{
    var code = ViewData["StatusCode"] as int? ?? 500;
    ViewData["Title"] = $"Error {code}";
    
    var titulo = code switch
    {
        404 => "Página o Recurso No Encontrado",
        403 => "Acceso Restringido",
        401 => "No Autorizado",
        _ => "Inconveniente en el Servidor"
    };

    var descripcion = code switch
    {
        404 => "La página, módulo o registro que estás buscando no existe o fue movido temporalmente.",
        403 => "Tu rol institucional actual no cuenta con permisos suficientes para acceder a este módulo.",
        401 => "Tu sesión ha expirado o necesitas iniciar sesión para ver este recurso.",
        _ => "Se produjo un error no controlado al procesar la solicitud. Nuestro equipo de arquitectura ha registrado el evento."
    };

    var emoji = code switch
    {
        404 => "🔍",
        403 => "🔒",
        401 => "🔐",
        _ => "⚠️"
    };
}

<div class="min-h-[70vh] flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl p-8 sm:p-12 border border-slate-200/80 shadow-lg max-w-lg w-full text-center space-y-6">
        <div class="w-20 h-20 rounded-3xl bg-blue-50 text-blue-600 border border-blue-200 flex items-center justify-center text-4xl mx-auto shadow-sm">
            @emoji
        </div>

        <div class="space-y-2">
            <span class="text-xs font-bold bg-blue-100 text-blue-800 px-3 py-1 rounded-full border border-blue-200 font-mono">
                CÓDIGO HTTP @code
            </span>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
                @titulo
            </h1>
            <p class="text-xs sm:text-sm text-slate-500 leading-relaxed max-w-md mx-auto">
                @descripcion
            </p>
        </div>

        <div class="pt-4 flex flex-col sm:flex-row gap-3 justify-center">
            <a href="/" class="btn bg-blue-600 hover:bg-blue-700 text-white rounded-xl font-bold text-xs h-11 border-0 shadow-md shadow-blue-500/20 px-6">
                🏛️ Volver al Panel Principal
            </a>
            @if (code == 401 || code == 403)
            {
                <a href="/Account/Login" class="btn btn-ghost rounded-xl font-semibold text-xs h-11 border border-slate-200">
                    Iniciar Sesión
                </a>
            }
        </div>
    </div>
</div>
