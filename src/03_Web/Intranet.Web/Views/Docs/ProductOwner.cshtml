@section Scripts {
    <!-- Librería html2pdf.js para exportar PDF A4 de alta fidelidad -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

    <script>
        function showToast(mensaje) {
            const toast = document.getElementById('toast');
            if (toast) {
                toast.innerHTML = `<span>${mensaje}</span>`;
                toast.classList.remove('hidden');
                setTimeout(() => {
                    toast.classList.add('hidden');
                }, 4000);
            }
        }

        function getCompiledRulesArray() {
            const rules = [];
            if (document.getElementById('chip_unicidad').checked) rules.push('• <strong>Sin Duplicados:</strong> No permitir registrar dos veces el mismo código o nombre.');
            if (document.getElementById('chip_core').checked) rules.push('• <strong>Conectado al Sistema:</strong> Vinculado con la lista oficial de usuarios y docentes.');
            if (document.getElementById('chip_validacion').checked) rules.push('• <strong>Campos Obligatorios:</strong> Validar que no falten datos importantes.');
            if (document.getElementById('chip_estados').checked) rules.push('• <strong>Control de Estados:</strong> Saber si está Pendiente, Aprobado o Finalizado.');
            if (document.getElementById('chip_reporte').checked) rules.push('• <strong>Reportes y Descargas:</strong> Opción para imprimir o descargar en PDF/Excel.');
            if (document.getElementById('chip_auditoria').checked) rules.push('• <strong>Historial de Registro:</strong> Guarda quién guardó la información, fecha y hora.');
            return rules;
        }

        function getCompiledRules() {
            return getCompiledRulesArray().map(r => '- [ ] ' + r.replace(/<[^>]*>/g, '').replace('• ', '')).join('\n');
        }

        function populateOfficialDocument() {
            const select = document.getElementById('modulo');
            const opt = select.options[select.selectedIndex];
            const mod = select.value || 'Módulo No Seleccionado';
            const dba = opt ? opt.getAttribute('data-dba') : 'Por Asignar';
            const modTag = opt ? opt.getAttribute('data-tag') : 'modXX';

            const po = document.getElementById('po').value || 'Sin Nombre';
            const area = document.getElementById('area').value || 'Sin Rol Asignado';
            const obj = document.getElementById('objetivo').value || 'Sin Funcionalidad Especificada';
            const dolor = document.getElementById('dolor').value || 'No se detalló el problema manual.';
            const sol = document.getElementById('solucion').value || 'No se detalló la solución digital.';
            const rawInputs = document.getElementById('inputs').value || 'Código, Nombre, Categoría, Estado';
            const unhappy = document.getElementById('unhappyPath').value || 'Validación en interfaz y alerta amigable ante registros duplicados sin provocar excepciones HTTP 500.';
            const kpi = document.getElementById('kpi').value || 'Reducción del tiempo de atención en un 90% y 100% de trazabilidad operativa.';
            const agenteIA = document.getElementById('agenteIA').value.trim() || 'No requiere agente IA en la primera iteración.';
          
            const now = new Date();
            const fechaStr = `${String(now.getDate()).padStart(2, '0')}/${String(now.getMonth() + 1).padStart(2, '0')}/${now.getFullYear()}`;

            document.getElementById('pdfDocCode').textContent = `INF-REQ-${modTag.toUpperCase()}-2026`;
            document.getElementById('pdfDocDate').textContent = `Fecha: ${fechaStr} • Versión 1.0`;
            document.getElementById('pdfModulo').textContent = mod;
            document.getElementById('pdfSchema').textContent = modTag.toUpperCase();
            document.getElementById('pdfPO').textContent = po;
            document.getElementById('pdfDBA').textContent = dba;
            document.getElementById('pdfArea').textContent = area;
            document.getElementById('pdfObjetivo').textContent = obj;
            document.getElementById('pdfKPI').textContent = kpi;
            document.getElementById('pdfDolor').textContent = dolor;
            document.getElementById('pdfSolucion').textContent = sol;
            document.getElementById('pdfUnhappy').textContent = unhappy;
            document.getElementById('pdfAgenteIA').textContent = agenteIA;
            document.getElementById('pdfSignPO').textContent = po;
            document.getElementById('pdfSignModulo').textContent = mod;
            document.getElementById('pdfSignDBA').textContent = dba;
            document.getElementById('pdfSignSchema').textContent = `Módulo: ${modTag.toUpperCase()}`;

            // Inputs formateados con viñetas
            const inputsArray = rawInputs.split(',').map(s => s.trim()).filter(Boolean);
            const inputsHtml = inputsArray.map(item => `<div>• <span style="font-weight:700;">${item}</span></div>`).join('');
            document.getElementById('pdfInputsList').innerHTML = inputsHtml || '• Campos estándar';

            // Reglas formateadas
            const rulesArray = getCompiledRulesArray();
            const rulesHtml = rulesArray.map(r => `<div style="margin-bottom: 2px;">${r}</div>`).join('');
            document.getElementById('pdfReglasList').innerHTML = rulesHtml;
        }

        async function generateOfficialPDF() {
            const form = document.getElementById('reqForm');
            if (!form.checkValidity()) {
                form.reportValidity();
                return;
            }

            populateOfficialDocument();
          
            const select = document.getElementById('modulo');
            const opt = select.options[select.selectedIndex];
            const modTag = opt ? opt.getAttribute('data-tag') : 'requerimiento';

            const wrapper = document.getElementById('pdfExportWrapper');
            const element = document.getElementById('officialPdfDocument');

            // Posicionamiento absoluto seguro para evitar offsets negativos en html2canvas
            wrapper.style.display = 'block';
            wrapper.style.position = 'fixed';
            wrapper.style.top = '0';
            wrapper.style.left = '0';
            wrapper.style.zIndex = '999999';
            wrapper.style.width = '794px';
            wrapper.style.background = '#ffffff';
            element.style.width = '794px';
            element.style.margin = '0';
            element.style.padding = '22px 28px 16px 28px';

            await new Promise(resolve => setTimeout(resolve, 150));

            const optConfig = {
                margin: [4, 4, 4, 4],
                filename: `Informe_Tecnico_${modTag.toUpperCase()}_IESTP_Argentina.pdf`,
                image: { type: 'jpeg', quality: 0.98 },
                html2canvas: {
                    scale: 2,
                    useCORS: true,
                    logging: false,
                    letterRendering: true,
                    scrollX: 0,
                    scrollY: 0,
                    x: 0,
                    y: 0,
                    width: 794,
                    windowWidth: 794
                },
                jsPDF: {
                    unit: 'mm',
                    format: 'a4',
                    orientation: 'portrait'
                },
                pagebreak: { mode: ['avoid-all', 'css', 'legacy'] }
            };

            try {
                showToast('⏳ Generando Informe Oficial en PDF A4...');
                await html2pdf().set(optConfig).from(element).save();
                showToast('📄 ¡Informe PDF A4 descargado con éxito!');
            } catch (err) {
                console.error('Error generando PDF:', err);
                alert('Hubo un inconveniente al generar el PDF. Puedes usar la opción Imprimir con Ctrl+P.');
            } finally {
                wrapper.style.display = 'none';
                wrapper.style.position = 'static';
                wrapper.style.zIndex = 'auto';
            }
        }

        function printReport() {
            const form = document.getElementById('reqForm');
            if (!form.checkValidity()) {
                form.reportValidity();
                return;
            }
            populateOfficialDocument();
            window.print();
        }

        function getAIPrompt() {
            const select = document.getElementById('modulo');
            const opt = select.options[select.selectedIndex];
            const mod = select.value || '[Módulo XX]';
            const dba = opt ? opt.getAttribute('data-dba') : 'Por Asignar';
            const modTag = opt ? opt.getAttribute('data-tag') : 'modXX';

            const po = document.getElementById('po').value || '[PO]';
            const area = document.getElementById('area').value || '[Rol Usuario]';
            const obj = document.getElementById('objetivo').value || '[Funcionalidad]';
            const dolor = document.getElementById('dolor').value || '[Dolor Actual]';
            const sol = document.getElementById('solucion').value || '[Solución]';
            const inputs = document.getElementById('inputs').value || '';
            const unhappy = document.getElementById('unhappyPath').value || 'Alerta amigable sin errores 500';
            const kpi = document.getElementById('kpi').value || 'Trazabilidad 100%';
            const agenteIA = document.getElementById('agenteIA').value.trim();
            const reglas = getCompiledRules();

            return `Actúa como un Lead Software Architect & Senior .NET 10 Engineer.
Implementa la siguiente funcionalidad oficial para el ${mod} en la Intranet Modular del IESTP "Argentina".

🎯 ESPECIFICACIÓN FUNCIONAL:
* Módulo: ${mod} (PO: ${po} | Rol: ${area})
* Funcionalidad: ${obj}
* KPI: ${kpi}
* Dolor Actual: ${dolor}
* Solución Digital: ${sol}
* Manejo de Errores (Unhappy Path): ${unhappy}
${agenteIA ? `* Automatización con IA: ${agenteIA}` : ''}

🗄️ BASE DE DATOS (PostgreSQL 16 - Esquema '${modTag}' - DBA: ${dba}):
* Ubicación de Script SQL: src/02_Modulos/Intranet.${modTag.charAt(0).toUpperCase() + modTag.slice(1)}/Sql/schema.sql
* Reglas:
${reglas}
* Prohibido hacer JOIN directo a otros esquemas. Usar v_public_* o core.*.

💻 FRONTEND & BACKEND (C# .NET 10 + Razor + DaisyUI):
* Ubicación: src/02_Modulos/Intranet.${modTag.charAt(0).toUpperCase() + modTag.slice(1)}/
* Inputs de Pantalla: ${inputs}
* Estilo: Tailwind CSS + DaisyUI.

Genera el Controlador C#, Vista Razor .cshtml y script SQL idempotente (CREATE TABLE IF NOT EXISTS).`;
        }

        function copyAIPrompt() {
            const text = getAIPrompt();
            navigator.clipboard.writeText(text).then(() => {
                showToast('🤖 ¡Prompt Maestro para Cursor copiado al portapapeles!');
            });
        }

        function getDevFormattedMarkdown() {
            const select = document.getElementById('modulo');
            const opt = select.options[select.selectedIndex];
            const mod = select.value || '[Módulo XX]';
            const dba = opt ? opt.getAttribute('data-dba') : 'Por Asignar';
            const modTag = opt ? opt.getAttribute('data-tag') : 'modXX';

            const po = document.getElementById('po').value || '[Nombre PO]';
            const area = document.getElementById('area').value || '[Rol Usuario]';
            const obj = document.getElementById('objetivo').value || '[Funcionalidad]';
            const dolor = document.getElementById('dolor').value || '[Dolor Actual]';
            const sol = document.getElementById('solucion').value || '[Solución]';
            const inputs = document.getElementById('inputs').value || '';
            const unhappy = document.getElementById('unhappyPath').value || '';
            const kpi = document.getElementById('kpi').value || '';
            const agenteIA = document.getElementById('agenteIA').value.trim();
            const reglas = getCompiledRules();

            return `## 🎯 [REQUERIMIENTO] ${mod}

> 📌 **Funcionalidad:** ${obj}  
> 📊 **Métrica (KPI):** ${kpi}  
> 👤 **PO:** ${po} | 🏢 **Rol Usuario:** ${area} | 🗄️ **DBA:** **${dba}** (\`${modTag}\`)

---

### 🧠 1. Diagnóstico del Dolor vs Solución
* **❌ Proceso Manual Actual:** ${dolor}
* **✅ Flujo Digital en la Intranet:** ${sol}
* **🛡️ Manejo de Error (Unhappy Path):** ${unhappy}
${agenteIA ? `\n* **🤖 Automatización IA:** ${agenteIA}` : ''}

---

### 💻 2. Instrucciones para el Dev (AI-Ready)
* **📥 Inputs de Pantalla:** ${inputs}

---

### 🗄️ 3. Instrucciones para el DBA (${dba} - \`${modTag}\`)
* **Esquema Privado:** \`${modTag}.tabla_nombre\` (\`CREATE TABLE IF NOT EXISTS\`).
* **🔒 Reglas de Integridad:**
${reglas}
* **Contrato Público:** Vista \`${modTag}.v_public_...\`.

---

### ✅ 4. Definition of Done
