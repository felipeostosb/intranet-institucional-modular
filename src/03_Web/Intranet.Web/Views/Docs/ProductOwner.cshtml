@{
    ViewData["Title"] = "Informe de Requerimiento PO & Generador A4";
}

@section Styles {
    <style>
        /* MODO NORMAL EN PANTALLA: Ocultar el contenedor PDF para que solo se vea el formulario */
        #pdfExportWrapper {
            display: none;
        }

        /* MODO IMPRESIÓN (Ctrl+P / Imprimir navegador): Ocultar interfaz y mostrar SOLO el documento A4 centrado */
        @@media print {
            @@page {
                size: A4 portrait;
                margin: 8mm 10mm;
            }
            *, *::before, *::after {
                box-sizing: border-box !important;
            }
            html, body {
                background: #ffffff !important;
                margin: 0 !important;
                padding: 0 !important;
                width: 100% !important;
            }
            .drawer, .drawer-content, main, header, footer, aside, .navbar, .alert, .btn, #screenFormContainer, form, .no-print {
                display: none !important;
                margin: 0 !important;
                padding: 0 !important;
                width: 0 !important;
                height: 0 !important;
            }
            #pdfExportWrapper {
                display: block !important;
                position: static !important;
                width: 100% !important;
                max-width: 100% !important;
                margin: 0 auto !important;
                padding: 0 !important;
                background: #ffffff !important;
            }
            #officialPdfDocument {
                display: block !important;
                width: 100% !important;
                max-width: 100% !important;
                margin: 0 auto !important;
                padding: 0 !important;
                box-sizing: border-box !important;
                color: #0f172a !important;
                background: #ffffff !important;
            }
            table {
                page-break-inside: avoid;
            }
        }
    </style>
}

<div class="space-y-6 max-w-4xl mx-auto pb-12">
    
    <!-- Barra de Navegación Superior / Breadcrumbs -->
    <div class="flex flex-wrap items-center justify-between gap-3 bg-white dark:bg-[#111827] p-4 rounded-2xl border border-slate-200/80 dark:border-slate-800 shadow-sm">
        <div class="flex items-center gap-2 text-xs">
            <a href="/Docs" class="text-slate-500 hover:text-cyan-600 dark:hover:text-cyan-400 font-medium">📚 Documentación</a>
            <span class="text-slate-400">/</span>
            <a href="/Docs#product-owner" class="text-slate-500 hover:text-cyan-600 dark:hover:text-cyan-400 font-medium">Product Owner</a>
            <span class="text-slate-400">/</span>
            <span class="font-bold text-slate-800 dark:text-slate-100">Generador de Ficha & PDF A4</span>
        </div>
        <div class="flex items-center gap-2">
            <a href="/Docs" class="btn btn-ghost btn-xs rounded-xl text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800">
                ← Volver al Manual
            </a>
            <a href="https://github.com/felipeostosb/intranet-institucional-modular/issues/new" target="_blank" class="btn btn-xs bg-slate-900 text-white hover:bg-black dark:bg-slate-800 dark:hover:bg-slate-700 rounded-xl font-bold gap-1">
                <span>GitHub Issues ↗</span>
            </a>
        </div>
    </div>

    <!-- FORMULARIO ULTRA-LEAN (UX DE 3 PASOS: < 90 SEGUNDOS) -->
    <div id="screenFormContainer" class="bg-white dark:bg-[#111827] rounded-3xl shadow-sm border border-slate-200/80 dark:border-slate-800 p-6 sm:p-8 no-print">
      
        <!-- Header Minimalista -->
        <div class="border-b border-slate-100 dark:border-slate-800 pb-5 mb-6">
            <div class="flex items-center justify-between gap-2 mb-2">
                <span class="inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full text-xs font-bold bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-300 border border-emerald-200/60 dark:border-emerald-800">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-600 dark:bg-emerald-400 animate-pulse"></span>
                    Herramienta Oficial Product Owner • IESTP Argentina 2026
                </span>
                <span class="text-xs text-slate-400 dark:text-slate-500 font-medium">⏱️ Llenado en 90 seg</span>
            </div>
            <h1 class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-slate-100 tracking-tight">
                📋 Informe de Requerimiento PO
            </h1>
            <p class="text-slate-500 dark:text-slate-400 text-xs mt-1 leading-relaxed">
                Completa los 3 pasos esenciales para generar tu informe técnico oficial, exportar a <strong>PDF A4 oficial para firmas físicas</strong>, crear el Issue en GitHub o enviar el prompt a Cursor.
            </p>
        </div>

        <form id="reqForm" class="space-y-6">
        
            <!-- PASO 1: ¿Quién eres y qué módulo es? -->
            <div class="bg-slate-50/70 dark:bg-slate-900/50 p-4 sm:p-5 rounded-2xl border border-slate-200/70 dark:border-slate-800 space-y-3">
                <div class="flex items-center gap-2 text-indigo-950 dark:text-indigo-300 font-bold text-xs uppercase tracking-wider">
                    <span class="flex items-center justify-center w-5 h-5 rounded-full bg-indigo-600 text-white text-[10px] font-extrabold">1</span>
                    Identificación & Módulo
                </div>
                
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">Tu Módulo Oficial *</label>
                        <select id="modulo" required
                            class="w-full px-3 py-2 rounded-xl border border-slate-300 dark:border-slate-700 text-xs bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-100 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition font-semibold">
                            <option value="" disabled selected>-- Selecciona tu módulo --</option>
                            <option value="Módulo 01 - Matrícula & Admisión" data-dba="Ismael" data-tag="mod01">01. Matrícula & Admisión (DBA: Ismael)</option>
                            <option value="Módulo 02 - Asistencia & Deserción (DPI)" data-dba="Sheyla" data-tag="mod02">02. Asistencia & Deserción DPI (DBA: Sheyla)</option>
                            <option value="Módulo 03 - Inventario & Equipos" data-dba="Brenda" data-tag="mod03">03. Inventario & Equipos (DBA: Brenda)</option>
                            <option value="Módulo 04 - Horarios & Aulas" data-dba="Equipo 04" data-tag="mod04">04. Horarios & Aulas (Equipo 04)</option>
                            <option value="Módulo 05 - Incidencias & Requerimientos" data-dba="Oliva" data-tag="mod05">05. Incidencias & Requerimientos (DBA: Oliva)</option>
                            <option value="Módulo 06 - Egresados & Titulación" data-dba="Sandra" data-tag="mod06">06. Egresados & Titulación (DBA: Sandra)</option>
                            <option value="Módulo 07 - Encuestas & Calidad Docente" data-dba="Brayan" data-tag="mod07">07. Encuestas & Calidad Docente (DBA: Brayan)</option>
                            <option value="Módulo 08 - Login, Seguridad & Roles" data-dba="Toro" data-tag="mod08">08. Login, Seguridad & Roles (DBA: Toro)</option>
                            <option value="Módulo 09 - Tesorería & Pagos TUPA" data-dba="Equipo 09" data-tag="mod09">09. Tesorería & Pagos TUPA (Equipo 09)</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">Tu Nombre (Product Owner) *</label>
                        <input type="text" id="po" placeholder="Ej. Juan Pérez" required
                            class="w-full px-3 py-2 rounded-xl border border-slate-300 dark:border-slate-700 text-xs bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-100 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition">
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">Rol / Usuario que usará la pantalla *</label>
                        <input type="text" id="area" placeholder="Ej. Encargado de Almacén / Secretaria / Docente" required
                            class="w-full px-3 py-2 rounded-xl border border-slate-300 dark:border-slate-700 text-xs bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-100 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">Nombre de la Funcionalidad *</label>
                        <input type="text" id="objetivo" placeholder="Ej. Registro y asignación de equipos de cómputo" required
                            class="w-full px-3 py-2 rounded-xl border border-slate-300 dark:border-slate-700 text-xs bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-100 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition font-semibold text-indigo-950 dark:text-indigo-200">
                    </div>
                </div>
            </div>

            <!-- PASO 2: La Historia en 2 Respuestas Claras -->
            <div class="bg-slate-50/70 dark:bg-slate-900/50 p-4 sm:p-5 rounded-2xl border border-slate-200/70 dark:border-slate-800 space-y-3">
                <div class="flex items-center gap-2 text-indigo-950 dark:text-indigo-300 font-bold text-xs uppercase tracking-wider">
                    <span class="flex items-center justify-center w-5 h-5 rounded-full bg-indigo-600 text-white text-xs font-extrabold">2</span>
                    El Problema vs. La Solución Digital
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">¿Qué problema o dolor hay hoy con el método manual? *</label>
                    <textarea id="dolor" rows="2" required
                        placeholder="Ej. Se anota en cuadernos físicos o Excel sueltos, se pierde el rastro de los bienes y toma 30 minutos encontrar un registro."
                        class="w-full px-3 py-2 rounded-xl border border-slate-300 dark:border-slate-700 text-xs bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-100 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition"></textarea>
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">¿Qué hará la pantalla en la Intranet y qué resultado entrega? *</label>
                    <textarea id="solucion" rows="2" required
                        placeholder="Ej. Formulario web para registrar/buscar por código único en 3 segundos, actualizar la grilla y descargar comprobante/reporte en PDF."
                        class="w-full px-3 py-2 rounded-xl border border-slate-300 dark:border-slate-700 text-xs bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-100 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition"></textarea>
                </div>
            </div>

            <!-- PASO 3: Datos & Reglas Inteligentes (1 Clic) -->
            <div class="bg-slate-50/70 dark:bg-slate-900/50 p-4 sm:p-5 rounded-2xl border border-slate-200/70 dark:border-slate-800 space-y-3">
                <div class="flex items-center gap-2 text-indigo-950 dark:text-indigo-300 font-bold text-xs uppercase tracking-wider">
                    <span class="flex items-center justify-center w-5 h-5 rounded-full bg-indigo-600 text-white text-xs font-extrabold">3</span>
                    Datos de Entrada y Reglas de Integridad (1 Clic)
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5">Campos que llenará el usuario (Inputs): *</label>
                    <input type="text" id="inputs" required
                        value="Código / Serie, Nombre / Descripción, Categoría / Tipo, Estado / Ubicación, Observaciones"
                        class="w-full px-3 py-2 rounded-xl border border-slate-300 dark:border-slate-700 text-xs font-mono bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-100 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition">
                </div>

                <!-- Smart Chips Universales (1 Clic) -->
                <div>
                    <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5">Reglas automáticas a activar en base de datos:</label>
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2 text-[11px]">
                        <label class="flex items-center gap-2 p-2 bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 cursor-pointer hover:bg-indigo-50 dark:hover:bg-slate-700/60 transition">
                            <input type="checkbox" id="chip_unicidad" checked class="checkbox checkbox-primary checkbox-xs rounded">
                            <span class="font-medium text-slate-700 dark:text-slate-200">Código Único (Sin duplicados)</span>
                        </label>
                        <label class="flex items-center gap-2 p-2 bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 cursor-pointer hover:bg-indigo-50 dark:hover:bg-slate-700/60 transition">
                            <input type="checkbox" id="chip_core" checked class="checkbox checkbox-primary checkbox-xs rounded">
                            <span class="font-medium text-slate-700 dark:text-slate-200">Vínculo con Core</span>
                        </label>
                        <label class="flex items-center gap-2 p-2 bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 cursor-pointer hover:bg-indigo-50 dark:hover:bg-slate-700/60 transition">
                            <input type="checkbox" id="chip_validacion" checked class="checkbox checkbox-primary checkbox-xs rounded">
                            <span class="font-medium text-slate-700 dark:text-slate-200">Campos Obligatorios</span>
                        </label>
                        <label class="flex items-center gap-2 p-2 bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 cursor-pointer hover:bg-indigo-50 dark:hover:bg-slate-700/60 transition">
                            <input type="checkbox" id="chip_estados" checked class="checkbox checkbox-primary checkbox-xs rounded">
                            <span class="font-medium text-slate-700 dark:text-slate-200">Control de Estados</span>
                        </label>
                        <label class="flex items-center gap-2 p-2 bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 cursor-pointer hover:bg-indigo-50 dark:hover:bg-slate-700/60 transition">
                            <input type="checkbox" id="chip_reporte" checked class="checkbox checkbox-primary checkbox-xs rounded">
                            <span class="font-medium text-slate-700 dark:text-slate-200">Descarga PDF / Reporte</span>
                        </label>
                        <label class="flex items-center gap-2 p-2 bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 cursor-pointer hover:bg-indigo-50 dark:hover:bg-slate-700/60 transition">
                            <input type="checkbox" id="chip_auditoria" checked class="checkbox checkbox-primary checkbox-xs rounded">
                            <span class="font-medium text-slate-700 dark:text-slate-200">Auditoría (Fecha / User)</span>
                        </label>
                    </div>
                </div>
            </div>

            <!-- PROGRESSIVE DISCLOSURE: Opciones Avanzadas / IA (Colapsadas por defecto) -->
            <details class="group bg-indigo-50/50 dark:bg-indigo-950/30 rounded-2xl border border-indigo-100 dark:border-indigo-900/50 p-4 transition">
                <summary class="flex items-center justify-between font-bold text-xs text-indigo-950 dark:text-indigo-300 cursor-pointer select-none">
                    <span class="flex items-center gap-2">
                        <span>⚙️</span> Opciones Avanzadas: Manejo de Errores, Métrica KPI & IA (Opcional)
                    </span>
                    <span class="text-indigo-600 dark:text-indigo-400 text-xs group-open:rotate-180 transition-transform">▼</span>
                </summary>
              
                <div class="pt-4 space-y-3 border-t border-indigo-100/80 dark:border-indigo-900/50 mt-3 text-xs">
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <div>
                            <label class="block font-bold text-slate-700 dark:text-slate-300 mb-1">Manejo de Errores / Unhappy Path:</label>
                            <input type="text" id="unhappyPath" placeholder="Ej. Mostrar alerta amigable si el código ya existe"
                                value="Mostrar alerta amigable en pantalla si el código ya existe o faltan campos obligatorios, sin errores 500."
                                class="w-full px-3 py-2 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-100 outline-none focus:ring-2 focus:ring-indigo-500">
                        </div>
                        <div>
                            <label class="block font-bold text-slate-700 dark:text-slate-300 mb-1">Métrica de Éxito / KPI:</label>
                            <input type="text" id="kpi" placeholder="Ej. Reducir tiempo de 20 min a < 1 min"
                                value="Reducir tiempo de atención/registro en un 90% y 100% de trazabilidad sin pérdidas ni duplicados."
                                class="w-full px-3 py-2 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-100 outline-none focus:ring-2 focus:ring-indigo-500">
                        </div>
                    </div>

                    <div>
                        <label class="block font-bold text-slate-700 dark:text-slate-300 mb-1">Automatización Inteligente / Asistente IA:</label>
                        <input type="text" id="agenteIA" placeholder="Ej. Sugerencia de mantenimiento, categorización automática o lectura OCR"
                            class="w-full px-3 py-2 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-100 outline-none focus:ring-2 focus:ring-indigo-500">
                    </div>
                </div>
            </details>

            <!-- Botones de Acción (Grid Limpio) -->
            <div class="pt-2 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-2">
                <button type="button" onclick="generateOfficialPDF()"
                    class="btn btn-error btn-sm rounded-xl text-white font-bold gap-1 shadow-sm text-xs py-2 h-auto">
                    <span>📄 Descargar PDF A4</span>
                </button>

                <button type="button" onclick="printReport()"
                    class="btn btn-neutral btn-sm rounded-xl text-white font-bold gap-1 shadow-sm text-xs py-2 h-auto">
                    <span>🖨️ Imprimir / Vista</span>
                </button>
              
                <button type="button" onclick="openInGitHub()"
                    class="btn btn-success btn-sm rounded-xl text-white font-bold gap-1 shadow-sm text-xs py-2 h-auto">
                    <span>🚀 Enviar a GitHub</span>
                </button>

                <button type="button" onclick="copyAIPrompt()"
                    class="btn btn-secondary btn-sm rounded-xl text-white font-bold gap-1 shadow-sm text-xs py-2 h-auto">
                    <span>🤖 Prompt Cursor</span>
                </button>

                <button type="button" onclick="copyMarkdown()"
                    class="btn btn-primary btn-sm rounded-xl text-white font-bold gap-1 shadow-sm text-xs py-2 h-auto">
                    <span>📋 Copiar WhatsApp</span>
                </button>
            </div>

        </form>

    </div>

    <!-- Toast Flotante para Notificaciones -->
    <div id="toast" class="hidden fixed bottom-6 right-6 z-50 bg-slate-900 dark:bg-slate-800 text-white px-5 py-3 rounded-2xl shadow-2xl border border-slate-700 text-xs font-semibold flex items-center gap-2 animate-bounce">
        <span>✅ ¡Operación completada con éxito!</span>
    </div>

</div>

<!-- ========================================================================= -->
<!-- CONTENEDOR DE RENDERIZADO EXCLUSIVO PARA PDF A4 (1 Hoja Exacta)          -->
<!-- ========================================================================= -->
<div id="pdfExportWrapper">
    <div id="officialPdfDocument" style="width: 794px; padding: 20px 28px 14px 28px; background: #ffffff; color: #0f172a; font-family: 'Plus Jakarta Sans', Arial, sans-serif; box-sizing: border-box; line-height: 1.35;">
      
        <!-- 1. Encabezado Institucional & Membrete Oficial -->
        <table style="width: 100%; border-collapse: collapse; border-bottom: 2.5px solid #1e3a8a; padding-bottom: 6px; margin-bottom: 10px;">
            <tr>
                <td style="vertical-align: top; width: 68%;">
                    <p style="font-size: 7pt; font-weight: 800; color: #1e3a8a; text-transform: uppercase; margin: 0; letter-spacing: 0.8px;">
                        REPÚBLICA DEL PERÚ • MINISTERIO DE EDUCACIÓN • DRELM
                    </p>
                    <h2 style="font-size: 12.5pt; font-weight: 900; color: #0f172a; margin: 1px 0 0 0; letter-spacing: -0.3px;">
                        IESTP "ARGENTINA" — LIMA CENTRO
                    </h2>
                    <p style="font-size: 7.2pt; color: #475569; margin: 1px 0 0 0; font-weight: 600;">
                        Programa de Estudios: Computación e Informática / DSI • Periodo Lectivo 2026-II
                    </p>
                    <p style="font-size: 6.8pt; color: #64748b; margin: 1px 0 0 0;">
                        Proyecto Institucional: Intranet & Sistema de Gestión Académica Modular
                    </p>
                </td>
                <td style="vertical-align: top; text-align: right; width: 32%;">
                    <div style="display: inline-block; background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 6px; padding: 3px 8px; text-align: right;">
                        <p style="font-size: 6.5pt; font-weight: 800; color: #1d4ed8; margin: 0; text-transform: uppercase;">
                            INFORME DE REQUERIMIENTO
                        </p>
                        <p id="pdfDocCode" style="font-size: 7.8pt; font-family: monospace; font-weight: 900; color: #0f172a; margin: 1px 0 0 0;">
                            INF-REQ-MOD03-2026
                        </p>
                        <p id="pdfDocDate" style="font-size: 6.2pt; color: #64748b; margin: 1px 0 0 0;">
                            Fecha: 22/09/2026 • Versión 1.0
                        </p>
                    </div>
                </td>
            </tr>
        </table>

        <!-- Título del Documento -->
        <div style="text-align: center; margin-bottom: 9px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 6px; padding: 5px 8px;">
            <h1 style="font-size: 10.5pt; font-weight: 900; color: #1e3a8a; margin: 0; text-transform: uppercase; letter-spacing: 0.2px;">
                INFORME DE REQUERIMIENTO & ESPECIFICACIÓN FUNCIONAL
            </h1>
            <p style="font-size: 7pt; color: #475569; margin: 1px 0 0 0; font-weight: 600;">
                Mapeo de la Solución, Datos a Ingresar y Criterios de Aceptación
            </p>
        </div>

        <!-- 2. Tabla de Datos Generales & Responsables -->
        <table style="width: 100%; border-collapse: collapse; margin-bottom: 8px; font-size: 7.2pt;">
            <tr style="background: #f1f5f9;">
                <td style="border: 1px solid #cbd5e1; padding: 3px 6px; font-weight: 800; width: 22%; color: #1e293b;">Módulo Oficial:</td>
                <td id="pdfModulo" style="border: 1px solid #cbd5e1; padding: 3px 6px; font-weight: 800; color: #1e3a8a; width: 44%;"></td>
                <td style="border: 1px solid #cbd5e1; padding: 3px 6px; font-weight: 800; width: 14%; color: #1e293b;">Código:</td>
                <td id="pdfSchema" style="border: 1px solid #cbd5e1; padding: 3px 6px; font-weight: 900; font-family: monospace; color: #0369a1; width: 20%;"></td>
            </tr>
            <tr>
                <td style="border: 1px solid #cbd5e1; padding: 3px 6px; font-weight: 700; color: #334155;">Product Owner (PO):</td>
                <td id="pdfPO" style="border: 1px solid #cbd5e1; padding: 3px 6px; font-weight: 700; color: #0f172a;"></td>
                <td style="border: 1px solid #cbd5e1; padding: 3px 6px; font-weight: 700; color: #334155;">Resp. Base Datos:</td>
                <td id="pdfDBA" style="border: 1px solid #cbd5e1; padding: 3px 6px; font-weight: 700; color: #0369a1;"></td>
            </tr>
            <tr style="background: #f8fafc;">
