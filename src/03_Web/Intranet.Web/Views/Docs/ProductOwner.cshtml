        function openInGitHub() {
            const select = document.getElementById('modulo');
            const opt = select.options[select.selectedIndex];
            const mod = select.value || 'Módulo XX';
            const obj = document.getElementById('objetivo').value || 'Nuevo Requerimiento';
            const modTag = opt ? opt.getAttribute('data-tag').toUpperCase() : 'MOD-XX';
          
            const title = encodeURIComponent(`[${modTag}] ${obj}`);
            const body = encodeURIComponent(getDevFormattedMarkdown());
            const url = `https://github.com/felipeostosb/intranet-institucional-modular/issues/new?title=${title}&body=${body}&labels=requerimiento,taller-web`;
            window.open(url, '_blank');
        }

        function copyMarkdown() {
            const text = getDevFormattedMarkdown();
            navigator.clipboard.writeText(text).then(() => {
                showToast('📋 ¡Texto copiado para WhatsApp / Telegram!');
            });
        }
    </script>
