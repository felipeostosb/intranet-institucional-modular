                        <span>Publicar Video</span>
                    </button>
                    <a href="http://35.206.81.32:8080" target="_blank" class="btn btn-ghost btn-sm text-slate-300 hover:text-white rounded-xl text-xs font-semibold gap-1 bg-white/5 border border-white/10">
                        <span>Adminer BD</span>
                        <span class="text-[11px]">↗</span>
