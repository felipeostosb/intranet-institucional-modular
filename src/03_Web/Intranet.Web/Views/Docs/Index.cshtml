    <!-- 📹 SECCIÓN 9: ACADEMIA MULTIMEDIA & VIDEOS                                -->
    <!-- ========================================================================= -->
    <section id="videos" class="scroll-mt-24 space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-200 dark:border-slate-800 pb-3">
            <div class="flex items-center gap-2">
                <span class="text-xl">📹</span>
                <div>
                    <h2 class="text-lg font-black text-slate-900 dark:text-slate-100">9. Academia de Videotutoriales & Demos</h2>
                    <p class="text-xs text-slate-500 dark:text-slate-400">Aprende con videos demostrativos y sube las capacitaciones de tu equipo.</p>
                </div>
            </div>
            <button onclick="modal_nuevo_tutorial.showModal()" class="btn btn-primary btn-xs rounded-xl text-xs font-bold gap-1 self-start sm:self-auto">
                + Publicar Video
            </button>
        </div>

        <!-- Filtros de Módulos & Buscador Rápido -->
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3">
            <!-- Pestañas de Filtrado -->
            <div class="flex gap-1.5 overflow-x-auto pb-1 max-w-full">
                @{
                    var modulosFiltro = new[]
                    {
                        ("Todos", "Todos"),
                        ("General", "General"),
                        ("Modulo00", "00. Seguridad"),
                        ("Modulo01", "01. Matrícula (Ismael)"),
                        ("Modulo02", "02. Asistencia (Sheyla)"),
                        ("Modulo03", "03. Inventario (Brenda)"),
                        ("Modulo04", "04. Horarios (Eq 04)"),
                        ("Modulo05", "05. Incidencias (Oliva)"),
                        ("Modulo06", "06. Egresados (Sandra)"),
                        ("Modulo07", "07. Encuestas (Brayan)"),
                        ("Modulo08", "08. Login & Roles (Toro)"),
                        ("Modulo09", "09. Tesorería (Eq 09)")
                    };
                }
                @foreach (var (cod, nom) in modulosFiltro)
                {
                    var activo = moduloActual.Equals(cod, StringComparison.OrdinalIgnoreCase);
                    <a href="/Docs?modulo=@cod@(string.IsNullOrWhiteSpace(buscar) ? "" : "&buscar=" + buscar)#videos" 
                       class="px-3 py-1.5 rounded-xl text-xs font-semibold whitespace-nowrap transition @(activo ? "bg-slate-900 dark:bg-white text-white dark:text-slate-900 shadow-sm" : "bg-white dark:bg-[#111827] text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 border border-slate-200/80 dark:border-slate-800")">
                        @nom
                    </a>
                }
            </div>

            <!-- Búsqueda Rápida -->
            <form method="get" asp-action="Index" class="flex gap-1.5 w-full sm:w-64 shrink-0">
                <input type="hidden" name="modulo" value="@moduloActual" />
                <input type="text" name="buscar" value="@buscar" placeholder="Buscar video..." class="input input-xs input-bordered w-full rounded-xl bg-white dark:bg-[#111827] border-slate-200 dark:border-slate-800 text-xs h-8" />
                <button type="submit" class="btn btn-xs btn-neutral rounded-xl text-xs h-8">Buscar</button>
            </form>
        </div>

        <!-- Grid de Videos -->
        @if (!Model.Any())
        {
            <div class="bg-white dark:bg-[#111827] rounded-3xl p-10 text-center border border-slate-200/80 dark:border-slate-800 shadow-sm space-y-3">
                <div class="text-3xl">📹</div>
                <h3 class="text-sm font-bold text-slate-800 dark:text-slate-200">No hay videos en este filtro</h3>
                <p class="text-xs text-slate-400 max-w-sm mx-auto">
                    Sé el primero en compartir un tutorial o demo de tu módulo.
                </p>
                <button onclick="modal_nuevo_tutorial.showModal()" class="btn btn-primary btn-xs rounded-xl text-xs font-bold">
                    + Publicar Video
                </button>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                @foreach (var item in Model)
                {
                    <div class="bg-white dark:bg-[#111827] rounded-2xl border border-slate-200/80 dark:border-slate-800 shadow-sm hover:shadow-md transition overflow-hidden flex flex-col group">
                        <!-- Thumbnail con Overlay Play -->
                        <div class="relative aspect-video bg-slate-900 cursor-pointer overflow-hidden" onclick="reproducirVideo('@item.YoutubeVideoId', '@Html.Raw(Html.Encode(item.Titulo))', '@Html.Raw(Html.Encode(item.Autor))')">
                            <img src="https://img.youtube.com/vi/@item.YoutubeVideoId/hqdefault.jpg" alt="@item.Titulo" class="w-full h-full object-cover group-hover:scale-105 transition duration-300 opacity-90 group-hover:opacity-100" />
                            
                            <div class="absolute inset-0 bg-black/30 flex items-center justify-center">
                                <div class="w-11 h-11 rounded-full bg-red-600/90 text-white flex items-center justify-center shadow-lg group-hover:scale-110 group-hover:bg-red-500 transition duration-200">
                                    <svg class="w-5 h-5 fill-current ml-0.5" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                                </div>
                            </div>

                            <div class="absolute top-2 left-2">
                                <span class="badge badge-neutral text-[10px] font-bold px-2 py-0.5 rounded-lg bg-black/60 text-white backdrop-blur-sm border-0">@item.ModuloNombre</span>
                            </div>
                        </div>

                        <!-- Info del Video -->
                        <div class="p-4 flex-1 flex flex-col justify-between space-y-2">
                            <div>
                                <div class="flex items-center justify-between text-[10px] text-slate-400 mb-1">
                                    <span class="font-medium text-blue-600 dark:text-cyan-400">@item.Autor</span>
                                    <span>@item.FechaPublicacion.ToString("dd/MM/yyyy")</span>
                                </div>
                                <h3 class="font-bold text-xs text-slate-900 dark:text-slate-100 leading-snug group-hover:text-blue-600 dark:group-hover:text-cyan-400 transition cursor-pointer" onclick="reproducirVideo('@item.YoutubeVideoId', '@Html.Raw(Html.Encode(item.Titulo))', '@Html.Raw(Html.Encode(item.Autor))')">
                                    @item.Titulo
                                </h3>
                                <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-1 line-clamp-2 leading-relaxed">
                                    @item.Descripcion
                                </p>
                            </div>

                            <div class="pt-2 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between text-[11px]">
                                <span class="text-slate-400">Nivel: @item.Nivel</span>
                                <button onclick="reproducirVideo('@item.YoutubeVideoId', '@Html.Raw(Html.Encode(item.Titulo))', '@Html.Raw(Html.Encode(item.Autor))')" class="text-blue-600 dark:text-cyan-400 font-semibold hover:underline">
                                    Ver Video →
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </section>
</div>

<!-- ========================================================================= -->
<!-- 🎬 MODAL REPRODUCTOR HD DE YOUTUBE                                        -->
<!-- ========================================================================= -->
<dialog id="modal_reproductor" class="modal">
