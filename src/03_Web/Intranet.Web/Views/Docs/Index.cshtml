    </div>
</dialog>

@section Scripts {
    <script>
        function reproducirVideo(videoId, titulo, autor) {
            const modal = document.getElementById('modal_reproductor');
            const iframe = document.getElementById('video_iframe');
            const tit = document.getElementById('video_titulo');
            const aut = document.getElementById('video_autor');

            tit.innerText = titulo;
            aut.innerText = autor ? 'Expositor: ' + autor : '';
            iframe.src = 'https://www.youtube.com/embed/' + videoId + '?autoplay=1&rel=0';
            modal.showModal();
        }

        function cerrarVideo() {
            const modal = document.getElementById('modal_reproductor');
            const iframe = document.getElementById('video_iframe');
            iframe.src = '';
            modal.close();
        }

        // ScrollSpy Inteligente para la Barra Lateral
        document.addEventListener('DOMContentLoaded', function() {
            const sections = document.querySelectorAll('section[id]');
            const navLinks = document.querySelectorAll('.docs-nav-link');

            function highlightNav() {
                let scrollY = window.pageYOffset;
                sections.forEach(current => {
                    const sectionHeight = current.offsetHeight;
                    const sectionTop = current.offsetTop - 120;
                    const sectionId = current.getAttribute('id');

                    if (scrollY > sectionTop && scrollY <= sectionTop + sectionHeight) {
                        navLinks.forEach(link => {
                            if (link.getAttribute('href') === '#' + sectionId) {
                                link.classList.add('bg-cyan-50', 'dark:bg-cyan-950/40', 'text-cyan-600', 'dark:text-cyan-400', 'font-bold', 'border-l-2', 'border-cyan-500');
                                link.classList.remove('text-slate-700', 'dark:text-slate-300');
                            } else {
                                link.classList.remove('bg-cyan-50', 'dark:bg-cyan-950/40', 'text-cyan-600', 'dark:text-cyan-400', 'font-bold', 'border-l-2', 'border-cyan-500');
                                link.classList.add('text-slate-700', 'dark:text-slate-300');
                            }
                        });
                    }
                });
            }

            window.addEventListener('scroll', highlightNav);
            highlightNav();
        });
    </script>
}
