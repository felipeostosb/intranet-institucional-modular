@model IEnumerable<Intranet.Web.Controllers.TutorialItem>
@{
    ViewData["Title"] = "Centro de Documentación & Manuales";
    var moduloActual = (string)(ViewData["ModuloSeleccionado"] ?? "Todos");
    var buscar = (string)(ViewData["Buscar"] ?? "");
}

<div class="space-y-12 pb-16">
    <!-- ========================================================================= -->
    <!-- 🌟 HERO ZEN: CENTRO DE DOCUMENTACIÓN & MANUALES OPERATIVOS                -->
    <!-- ========================================================================= -->
    <div class="bg-gradient-to-br from-slate-900 via-blue-950 to-slate-950 text-white rounded-3xl p-6 sm:p-8 border border-slate-800 shadow-xl relative overflow-hidden">
        <div class="relative z-10 space-y-4">
            <div class="flex flex-wrap items-center justify-between gap-3">
                <div class="flex items-center gap-2">
                    <span class="text-[11px] bg-cyan-400/20 text-cyan-200 border border-cyan-400/30 px-3 py-1 rounded-full font-bold uppercase tracking-wider">
                        Documentación Oficial Universal
                    </span>
                    <span class="text-xs text-slate-400 font-medium">• AQUILA A-ERP</span>
                </div>
                <div class="flex items-center gap-2">
                    <button onclick="modal_nuevo_tutorial.showModal()" class="btn btn-primary btn-sm rounded-xl text-xs font-bold gap-1.5 shadow-sm">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                        <span>Publicar Video</span>
                    </button>
                    <a href="http://35.206.81.32:8080" target="_blank" class="btn btn-ghost btn-sm text-slate-300 hover:text-white rounded-xl text-xs font-semibold gap-1 bg-white/5 border border-white/10">
                        <span>Adminer BD</span>
                        <span class="text-[11px]">↗</span>
                    </a>
                </div>
            </div>

            <div class="max-w-3xl space-y-2">
                <h1 class="text-2xl sm:text-4xl font-black tracking-tight text-white">
                    Manual de Operaciones & Guía de Ingeniería
                </h1>
                <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
                    Recetario maestro para el desarrollo modular de los 10 equipos del IESTP Argentina. Conoce el ciclo completo desde la clonación de Git hasta la entrega, con manuales especializados, <strong>Prompts Maestros para IA</strong> y sinergia de roles.
                </p>
            </div>

            <!-- Accesos Rápidos (Chips Minimalistas) -->
            <div class="flex flex-wrap gap-2 pt-2">
                <a href="#onboarding" class="px-3 py-1 rounded-xl text-xs font-semibold bg-white/10 hover:bg-white/20 text-slate-200 transition border border-white/10">
                    ⚡ Setup & Clonar
                </a>
                <a href="#product-owner" class="px-3 py-1 rounded-xl text-xs font-semibold bg-emerald-500/20 hover:bg-emerald-500/30 text-emerald-200 transition border border-emerald-500/30">
                    👑 Product Owner
                </a>
                <a href="#scrum-master" class="px-3 py-1 rounded-xl text-xs font-semibold bg-cyan-500/20 hover:bg-cyan-500/30 text-cyan-200 transition border border-cyan-500/30">
                    🏃 Scrum Master
                </a>
                <a href="#database" class="px-3 py-1 rounded-xl text-xs font-semibold bg-indigo-500/20 hover:bg-indigo-500/30 text-indigo-200 transition border border-indigo-500/30">
                    🗄️ Especialista BD
                </a>
                <a href="#qa-tester" class="px-3 py-1 rounded-xl text-xs font-semibold bg-amber-500/20 hover:bg-amber-500/30 text-amber-200 transition border border-amber-500/30">
                    🧪 QA Tester
                </a>
                <a href="#prompts-ia" class="px-3 py-1 rounded-xl text-xs font-semibold bg-blue-500/20 hover:bg-blue-500/30 text-blue-200 transition border border-blue-500/30 font-bold">
                    🤖 Prompts para IA
                </a>
                <a href="#sinergia" class="px-3 py-1 rounded-xl text-xs font-semibold bg-purple-500/20 hover:bg-purple-500/30 text-purple-200 transition border border-purple-500/30">
                    🤝 Ciclo de 4 Pasos
                </a>
                <a href="#modulos" class="px-3 py-1 rounded-xl text-xs font-semibold bg-slate-700/50 hover:bg-slate-700/80 text-slate-200 transition border border-slate-600">
                    🏢 10 Módulos
                </a>
                <a href="#videos" class="px-3 py-1 rounded-xl text-xs font-semibold bg-rose-500/20 hover:bg-rose-500/30 text-rose-200 transition border border-rose-500/30">
                    📹 Videos
                </a>
            </div>
        </div>
        <div class="absolute -right-16 -bottom-16 w-72 h-72 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none"></div>
    </div>

    <!-- ========================================================================= -->
    <!-- ⚡ SECCIÓN 1: ONBOARDING, CLONACIÓN & SETUP COMPLETO                       -->
    <!-- ========================================================================= -->
    <section id="onboarding" class="scroll-mt-24 space-y-4">
        <div class="flex items-center gap-2 border-b border-slate-200 dark:border-slate-800 pb-3">
            <span class="text-xl">⚡</span>
            <div>
                <h2 class="text-lg font-black text-slate-900 dark:text-slate-100">1. Setup & Clonación del Repositorio</h2>
                <p class="text-xs text-slate-500 dark:text-slate-400">Guía paso a paso para clonar, configurar y correr la plataforma en menos de 3 minutos.</p>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
            <!-- Paso 1: Requisitos & Clonación -->
            <div class="p-5 rounded-2xl bg-white dark:bg-[#111827] border border-slate-200/80 dark:border-slate-800 shadow-sm space-y-2.5">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-bold text-slate-900 dark:text-slate-100 uppercase tracking-wider">1. Clonar Repositorio</span>
                    <span class="badge badge-xs badge-neutral text-[10px]">Git</span>
                </div>
                <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
                    Asegúrate de tener instalado <strong>.NET 10 SDK</strong> y <strong>Git</strong>. Ejecuta:
                </p>
                <div class="font-mono bg-slate-900 text-cyan-300 p-2.5 rounded-xl text-[11px] select-all space-y-0.5">
                    <div>git clone https://github.com/felipeostosb/intranet-institucional-modular.git</div>
                    <div>cd intranet-institucional-modular</div>
                </div>
            </div>

            <!-- Paso 2: CLI Automatizado -->
            <div class="p-5 rounded-2xl bg-white dark:bg-[#111827] border border-slate-200/80 dark:border-slate-800 shadow-sm space-y-2.5">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-bold text-slate-900 dark:text-slate-100 uppercase tracking-wider">2. Crear Rama (Opción 2)</span>
                    <span class="badge badge-xs badge-primary text-[10px]">Asistente</span>
                </div>
                <p class="text-xs text-slate-500 dark:text-slate-400">
                    Usa la <strong>Opción 2</strong> del asistente para crear tu rama protegida automáticamente:
                </p>
                <div class="font-mono bg-slate-900 text-cyan-300 p-2.5 rounded-xl text-[11px] select-all space-y-0.5">
                    <div>./dev.sh <span class="text-slate-500"># Linux / Mac</span></div>
                    <div>.\dev.ps1 <span class="text-slate-500"># Windows</span></div>
                </div>
                <p class="text-[11px] text-slate-400">Pregunta tu módulo (00-09) y el nombre de la tarea.</p>
            </div>

            <!-- Paso 3: Sincronizar con Producción -->
            <div class="p-5 rounded-2xl bg-white dark:bg-[#111827] border border-slate-200/80 dark:border-slate-800 shadow-sm space-y-2.5">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-bold text-slate-900 dark:text-slate-100 uppercase tracking-wider">3. Actualizar (Opción 3)</span>
                    <span class="badge badge-xs bg-indigo-500/20 text-indigo-700 dark:text-indigo-300 border-indigo-500/30 font-bold text-[10px]">Zero-Loss</span>
                </div>
                <p class="text-xs text-slate-500 dark:text-slate-400">
                    Si otro equipo actualizó <code class="font-mono text-cyan-500">main</code>, usa la <strong>Opción 3</strong>:
                </p>
                <div class="font-mono bg-slate-900 text-indigo-300 p-2.5 rounded-xl text-[11px] select-all">
                    ./dev.sh <span class="text-slate-500">-> Elegir Opción 3</span>
                </div>
                <p class="text-[11px] text-slate-400">Descarga cambios de producción <strong>sin borrar ni perder</strong> tu avance local.</p>
            </div>

            <!-- Paso 4: Ejecución & Base de Datos -->
            <div class="p-5 rounded-2xl bg-white dark:bg-[#111827] border border-slate-200/80 dark:border-slate-800 shadow-sm space-y-2.5">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-bold text-slate-900 dark:text-slate-100 uppercase tracking-wider">4. Correr Intranet (Opción 1)</span>
                    <span class="badge badge-xs badge-success text-[10px]">Port 5000</span>
                </div>
                <p class="text-xs text-slate-500 dark:text-slate-400">
                    Selecciona la <strong>Opción 1</strong> para arrancar la web con Hot-Reload:
                </p>
                <div class="font-mono bg-slate-900 text-emerald-400 p-2.5 rounded-xl text-[11px] select-all">
                    http://localhost:5000
                </div>
                <p class="text-[11px] text-slate-400">Vistas Razor minimalistas con soporte nativo Dark Mode.</p>
            </div>
        </div>
    </section>

    <!-- ========================================================================= -->
    <!-- 👑 SECCIÓN 2: MANUAL DEL PRODUCT OWNER (PO)                               -->
    <!-- ========================================================================= -->
    <section id="product-owner" class="scroll-mt-24 space-y-4">
        <div class="flex items-center justify-between border-b border-slate-200 dark:border-slate-800 pb-3">
            <div class="flex items-center gap-2">
                <span class="text-xl">👑</span>
                <div>
                    <h2 class="text-lg font-black text-slate-900 dark:text-slate-100">2. Manual del Product Owner (PO)</h2>
                    <p class="text-xs text-slate-500 dark:text-slate-400">Definición de requerimientos de negocio, historias de usuario y validación final de aceptación (UAT).</p>
                </div>
            </div>
            <span class="badge badge-sm bg-emerald-500/20 text-emerald-700 dark:text-emerald-300 border-emerald-500/30 font-bold">Negocio & UAT</span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <!-- Tarjeta 1: Rol y Límites (El PO no es QA) -->
            <div class="p-5 rounded-2xl bg-white dark:bg-[#111827] border border-slate-200/80 dark:border-slate-800 shadow-sm space-y-2.5">
                <div class="flex items-center gap-2">
                    <span class="text-sm">🎯</span>
                    <h3 class="text-xs font-bold text-slate-900 dark:text-slate-100 uppercase tracking-wider">Misión: Definir el "QUÉ"</h3>
                </div>
                <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
                    <strong>Regla Clave:</strong> El PO <strong>NO hace de QA</strong>. Su rol es definir el requerimiento y validar la satisfacción del usuario final (UAT), dejando las pruebas técnicas de errores al Especialista QA.
                </p>
                <div class="text-[11px] bg-emerald-50 dark:bg-emerald-950/30 p-2.5 rounded-xl border border-emerald-200 dark:border-emerald-800 text-emerald-800 dark:text-emerald-300">
                    El PO solo recibe la pantalla cuando el <strong>QA Tester</strong> ya validó que no tiene errores de formulario ni bugs de código.
                </div>
            </div>

            <!-- Tarjeta 2: Receta Universal de Historias -->
            <div class="p-5 rounded-2xl bg-white dark:bg-[#111827] border border-slate-200/80 dark:border-slate-800 shadow-sm space-y-2.5">
                <div class="flex items-center gap-2">
                    <span class="text-sm">📝</span>
                    <h3 class="text-xs font-bold text-slate-900 dark:text-slate-100 uppercase tracking-wider">Receta Universal de Requerimientos</h3>
                </div>
                <p class="text-xs text-slate-500 dark:text-slate-400">
                    Aplica esta estructura para <strong>cualquiera de los 10 módulos</strong>:
                </p>
                <div class="text-xs text-slate-600 dark:text-slate-400 space-y-1 leading-relaxed bg-slate-50 dark:bg-slate-900/60 p-2.5 rounded-xl border border-slate-200/50 dark:border-slate-800 font-medium">
                    <div>• <strong>Como:</strong> [Rol: Docente / Alumno / Director / Cajero]</div>
                    <div>• <strong>Quiero:</strong> [Acción concreta en pantalla]</div>
                    <div>• <strong>Para:</strong> [Resultado o beneficio cuantificable]</div>
                </div>
            </div>

            <!-- Tarjeta 3: Criterios de Aceptación Gherkin -->
            <div class="p-5 rounded-2xl bg-white dark:bg-[#111827] border border-slate-200/80 dark:border-slate-800 shadow-sm space-y-2.5">
                <div class="flex items-center gap-2">
                    <span class="text-sm">📋</span>
                    <h3 class="text-xs font-bold text-slate-900 dark:text-slate-100 uppercase tracking-wider">Criterios de Aceptación (Gherkin)</h3>
                </div>
                <p class="text-xs text-slate-500 dark:text-slate-400">
                    Define las condiciones exactas antes de que el equipo empiece a programar:
                </p>
                <div class="text-[11px] text-slate-600 dark:text-slate-400 space-y-1 font-mono bg-slate-50 dark:bg-slate-900/60 p-2.5 rounded-xl border border-slate-200/50 dark:border-slate-800">
                    <div><strong>Dado que:</strong> [Estado inicial del sistema]</div>
                    <div><strong>Cuando:</strong> [El usuario realiza la acción]</div>
                    <div><strong>Entonces:</strong> [Respuesta esperada en pantalla/BD]</div>
                </div>
            </div>
        </div>
    </section>

    <!-- ========================================================================= -->
    <!-- 🏃 SECCIÓN 3: MANUAL DEL SCRUM MASTER (SM)                                -->
    <!-- ========================================================================= -->
    <section id="scrum-master" class="scroll-mt-24 space-y-4">
        <div class="flex items-center justify-between border-b border-slate-200 dark:border-slate-800 pb-3">
            <div class="flex items-center gap-2">
                <span class="text-xl">🏃</span>
                <div>
                    <h2 class="text-lg font-black text-slate-900 dark:text-slate-100">3. Manual del Scrum Master (SM)</h2>
                    <p class="text-xs text-slate-500 dark:text-slate-400">Gobernanza del flujo ágil, protección de la rama main, eliminación de bloqueos y control de entregas.</p>
                </div>
            </div>
            <span class="badge badge-sm bg-cyan-500/20 text-cyan-700 dark:text-cyan-300 border-cyan-500/30 font-bold">Liderazgo Ágil</span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <!-- Tarjeta 1: Blindaje de Ramas -->
            <div class="p-5 rounded-2xl bg-white dark:bg-[#111827] border border-slate-200/80 dark:border-slate-800 shadow-sm space-y-2.5">
                <div class="flex items-center gap-2">
                    <span class="text-sm">🌿</span>
                    <h3 class="text-xs font-bold text-slate-900 dark:text-slate-100 uppercase tracking-wider">Blindaje de la Rama Main</h3>
                </div>
                <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
                    <strong>Innegociable:</strong> Nadie puede hacer push directo a <code class="font-mono text-cyan-600 dark:text-cyan-400">main</code>.
                </p>
                <div class="text-[11px] space-y-1 bg-slate-50 dark:bg-slate-900/60 p-2.5 rounded-xl border border-slate-200/50 dark:border-slate-800 font-mono">
                    <div class="text-slate-400">// Formato estándar obligatorio:</div>
                    <div class="text-emerald-600 dark:text-emerald-400 font-bold">moduloXX/nombre-de-la-tarea</div>
                    <div class="text-slate-500 text-[10px]">Ej: modulo03/actas-calificaciones</div>
                </div>
            </div>

            <!-- Tarjeta 2: Daily Sync -->
            <div class="p-5 rounded-2xl bg-white dark:bg-[#111827] border border-slate-200/80 dark:border-slate-800 shadow-sm space-y-2.5">
                <div class="flex items-center gap-2">
                    <span class="text-sm">⏱️</span>
                    <h3 class="text-xs font-bold text-slate-900 dark:text-slate-100 uppercase tracking-wider">Daily Standup (5 Minutos)</h3>
                </div>
                <p class="text-xs text-slate-500 dark:text-slate-400">
                    Reunión rápida al inicio del sprint para alinear a PO, DBA, Devs y QA:
                </p>
                <ol class="text-xs text-slate-600 dark:text-slate-400 space-y-1.5 list-decimal list-inside">
                    <li>¿Qué avance de tu módulo cerraste ayer?</li>
                    <li>¿Qué pantalla o tabla vas a conectar hoy?</li>
                    <li>¿Tienes algún bloqueo con la BD o dependencias?</li>
                </ol>
            </div>

            <!-- Tarjeta 3: Definition of Done (DoD) -->
            <div class="p-5 rounded-2xl bg-white dark:bg-[#111827] border border-slate-200/80 dark:border-slate-800 shadow-sm space-y-2.5">
                <div class="flex items-center gap-2">
                    <span class="text-sm">✅</span>
                    <h3 class="text-xs font-bold text-slate-900 dark:text-slate-100 uppercase tracking-wider">Definition of Done (DoD)</h3>
                </div>
                <p class="text-xs text-slate-500 dark:text-slate-400">Requisitos obligatorios antes de aprobar el Pull Request:</p>
                <ul class="text-xs text-slate-600 dark:text-slate-400 space-y-1.5">
                    <li>✓ <code class="font-mono">dotnet build</code> con <strong>0 Warnings, 0 Errors</strong>.</li>
                    <li>✓ Interfaz limpia en estándar <strong>Zen Minimalista</strong>.</li>
                    <li>✓ <strong>Validación de QA:</strong> 0 bugs reportados por el Tester.</li>
                    <li>✓ <strong>Visto Bueno del PO:</strong> Requerimiento funcional cumplido.</li>
                </ul>
            </div>
        </div>
    </section>

    <!-- ========================================================================= -->
    <!-- 🗄️ SECCIÓN 4: MANUAL DEL ESPECIALISTA DE BASE DE DATOS (DBA)              -->
    <!-- ========================================================================= -->
    <section id="database" class="scroll-mt-24 space-y-4">
        <div class="flex items-center justify-between border-b border-slate-200 dark:border-slate-800 pb-3">
            <div class="flex items-center gap-2">
                <span class="text-xl">🗄️</span>
                <div>
                    <h2 class="text-lg font-black text-slate-900 dark:text-slate-100">4. Manual del Especialista de Base de Datos (DBA)</h2>
                    <p class="text-xs text-slate-500 dark:text-slate-400">Guía completa de ciclo de vida relacional: esquemas soberanos, integración con core, scripts SQL e índices.</p>
                </div>
            </div>
            <span class="badge badge-sm bg-indigo-500/20 text-indigo-700 dark:text-indigo-300 border-indigo-500/30 font-bold">PostgreSQL 16 Cloud</span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
            <!-- 1. Conexión & Adminer -->
            <div class="p-5 rounded-2xl bg-white dark:bg-[#111827] border border-slate-200/80 dark:border-slate-800 shadow-sm space-y-2.5">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-bold text-slate-900 dark:text-slate-100 uppercase tracking-wider">1. Conexión Cloud</span>
                    <a href="http://35.206.81.32:8080" target="_blank" class="text-xs text-blue-600 dark:text-cyan-400 font-semibold hover:underline">Adminer ↗</a>
                </div>
                <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
                    Acceso web sin instalación o vía DBeaver / pgAdmin / psql:
                </p>
                <div class="text-[11px] font-mono bg-slate-50 dark:bg-slate-900/60 p-2.5 rounded-xl border border-slate-200/50 dark:border-slate-800 space-y-0.5 text-slate-700 dark:text-slate-300">
                    <div>Host: <strong>35.206.81.32:5432</strong></div>
                    <div>BD: <strong>db_intranet_iestp</strong></div>
                    <div>User: <strong>user_equipoXX</strong></div>
                </div>
            </div>

            <!-- 2. Soberanía de Esquemas -->
            <div class="p-5 rounded-2xl bg-white dark:bg-[#111827] border border-slate-200/80 dark:border-slate-800 shadow-sm space-y-2.5">
                <div class="flex items-center gap-2">
                    <span class="text-sm">🛡️</span>
                    <h3 class="text-xs font-bold text-slate-900 dark:text-slate-100 uppercase tracking-wider">2. Soberanía de Esquema</h3>
                </div>
                <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
                    Cada equipo administra exclusivamente su esquema (<code class="font-mono text-cyan-600 dark:text-cyan-400">mod00..09</code>):
                </p>
                <div class="text-[11px] text-slate-600 dark:text-slate-400 space-y-1 bg-slate-50 dark:bg-slate-900/60 p-2.5 rounded-xl border border-slate-200/50 dark:border-slate-800 font-mono">
                    <div>• <strong>ALL PRIVILEGES</strong> en <code class="text-cyan-600 dark:text-cyan-400">modXX.*</code></div>
                    <div>• <strong>SELECT</strong> en <code class="text-emerald-600 dark:text-emerald-400">core.*</code></div>
                    <div class="text-rose-500 font-sans font-bold pt-0.5">Prohibido DROP/ALTER en esquemas ajenos.</div>
                </div>
            </div>

            <!-- 3. Integración con Core -->
            <div class="p-5 rounded-2xl bg-white dark:bg-[#111827] border border-slate-200/80 dark:border-slate-800 shadow-sm space-y-2.5">
                <div class="flex items-center gap-2">
                    <span class="text-sm">🔗</span>
                    <h3 class="text-xs font-bold text-slate-900 dark:text-slate-100 uppercase tracking-wider">3. Tablas Maestras (Core)</h3>
                </div>
                <p class="text-xs text-slate-500 dark:text-slate-400">
                    Vincula tus tablas con Foreign Keys hacia el esquema maestro:
                </p>
                <div class="text-[11px] font-mono bg-slate-900 text-cyan-300 p-2 rounded-xl space-y-0.5 select-all">
                    <div>core.estudiantes(id)</div>
                    <div>core.docentes(id)</div>
                    <div>core.carreras(id)</div>
                    <div>core.semestres(id)</div>
                </div>
            </div>

            <!-- 4. Gestión de Scripts SQL -->
            <div class="p-5 rounded-2xl bg-white dark:bg-[#111827] border border-slate-200/80 dark:border-slate-800 shadow-sm space-y-2.5">
                <div class="flex items-center gap-2">
                    <span class="text-sm">📁</span>
                    <h3 class="text-xs font-bold text-slate-900 dark:text-slate-100 uppercase tracking-wider">4. Scripts en el Repo</h3>
                </div>
                <p class="text-xs text-slate-500 dark:text-slate-400">
                    Guarda tus scripts en la carpeta de tu módulo:
                </p>
