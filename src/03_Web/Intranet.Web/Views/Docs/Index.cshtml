                @{
                    var modulosFiltro = new[]
                    {
                        ("Todos", "Todos"),
                        ("General", "General"),
                        ("Modulo00", "00. Seguridad"),
                        ("Modulo01", "01. Matrícula"),
                        ("Modulo02", "02. Asistencia"),
                        ("Modulo03", "03. Notas"),
                        ("Modulo04", "04. Horarios"),
                        ("Modulo05", "05. Docentes"),
                        ("Modulo06", "06. Trámites"),
                        ("Modulo07", "07. Bolsa"),
                        ("Modulo08", "08. Encuestas"),
                        ("Modulo09", "09. Tesorería")
                    };
                }
                @foreach (var (cod, nom) in modulosFiltro)
                {
                    var activo = moduloActual.Equals(cod, StringComparison.OrdinalIgnoreCase);
                    <a href="/Docs?modulo=@cod@(string.IsNullOrWhiteSpace(buscar) ? "" : "&buscar=" + buscar)#videos" 
                       class="px-3 py-1.5 rounded-xl text-xs font-semibold whitespace-nowrap transition @(activo ? "bg-slate-900 dark:bg-white text-white dark:text-slate-900 shadow-sm" : "bg-white dark:bg-[#111827] text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 border border-slate-200/80 dark:border-slate-800")">
                        @nom
                    </a>
                }
            </div>

            <!-- Búsqueda Rápida -->
            <form method="get" asp-action="Index" class="flex gap-1.5 w-full sm:w-64 shrink-0">
                <input type="hidden" name="modulo" value="@moduloActual" />
                <input type="text" name="buscar" value="@buscar" placeholder="Buscar video..." class="input input-xs input-bordered w-full rounded-xl bg-white dark:bg-[#111827] border-slate-200 dark:border-slate-800 text-xs h-8" />
