@model IEnumerable<Intranet.Web.Controllers.TutorialItem>
@{
    ViewData["Title"] = "Guías & Videotutoriales";
    var moduloActual = (string)(ViewData["ModuloSeleccionado"] ?? "Todos");
    var buscar = (string)(ViewData["Buscar"] ?? "");
}

<div class="space-y-8">
    <!-- Header Zen de Documentación -->
    <div class="bg-gradient-to-r from-slate-900 via-blue-950 to-indigo-950 text-white rounded-3xl p-6 sm:p-8 border border-white/10 shadow-lg relative overflow-hidden">
        <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div class="space-y-1">
                <div class="flex items-center gap-2">
                    <span class="text-[11px] bg-cyan-400/20 text-cyan-200 border border-cyan-400/30 px-2.5 py-0.5 rounded-full font-bold">Academia Multimedia</span>
                    <span class="text-xs text-slate-400">• IESTP Argentina</span>
                </div>
                <h1 class="text-2xl sm:text-3xl font-black tracking-tight text-white">
                    Guías & Videotutoriales
                </h1>
                <p class="text-xs sm:text-sm text-slate-300 max-w-xl">
                    Demostraciones paso a paso y guías de desarrollo para cada módulo.
                </p>
            </div>
            
            <div class="flex items-center gap-2 shrink-0">
                <button onclick="modal_nuevo_tutorial.showModal()" class="btn btn-primary btn-sm rounded-xl text-xs font-bold gap-1.5 shadow-sm">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                    <span>Publicar Video</span>
                </button>
            </div>
        </div>
        <div class="absolute -right-10 -bottom-10 w-60 h-60 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none"></div>
    </div>

    <!-- SECCIÓN DE VIDEOS: Filtro + Grid -->
    <div id="videos" class="space-y-4">
        <!-- Barra de Búsqueda y Filtro de Pestañas -->
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3">
            <!-- Filtros de Módulos (Scroll horizontal limpio) -->
            <div class="flex gap-1.5 overflow-x-auto pb-1 max-w-full">
                @{
                    var modulosFiltro = new[]
                    {
                        ("Todos", "Todos"),
                        ("General", "General"),
                        ("Modulo00", "00. Seguridad"),
                        ("Modulo01", "01. Matrícula"),
                        ("Modulo02", "02. Asistencia"),
                        ("Modulo03", "03. Notas"),
                        ("Modulo04", "04. Horarios"),
                        ("Modulo05", "05. Docentes"),
                        ("Modulo06", "06. Trámites"),
                        ("Modulo07", "07. Bolsa"),
                        ("Modulo08", "08. Encuestas"),
                        ("Modulo09", "09. Tesorería")
                    };
                }
                @foreach (var (cod, nom) in modulosFiltro)
                {
                    var activo = moduloActual.Equals(cod, StringComparison.OrdinalIgnoreCase);
                    <a href="/Docs?modulo=@cod@(string.IsNullOrWhiteSpace(buscar) ? "" : "&buscar=" + buscar)#videos" 
                       class="px-3 py-1.5 rounded-xl text-xs font-semibold whitespace-nowrap transition @(activo ? "bg-slate-900 dark:bg-white text-white dark:text-slate-900 shadow-sm" : "bg-white dark:bg-[#111827] text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 border border-slate-200/80 dark:border-slate-800")">
                        @nom
                    </a>
                }
            </div>

            <!-- Búsqueda rápida -->
            <form method="get" asp-action="Index" class="flex gap-1.5 w-full sm:w-64 shrink-0">
                <input type="hidden" name="modulo" value="@moduloActual" />
                <input type="text" name="buscar" value="@buscar" placeholder="Buscar video..." class="input input-xs input-bordered w-full rounded-xl bg-white dark:bg-[#111827] border-slate-200 dark:border-slate-800 text-xs h-8" />
                <button type="submit" class="btn btn-xs btn-neutral rounded-xl text-xs h-8">Buscar</button>
            </form>
        </div>

        <!-- Grid de Videos -->
        @if (!Model.Any())
        {
            <div class="bg-white dark:bg-[#111827] rounded-3xl p-10 text-center border border-slate-200/80 dark:border-slate-800 shadow-sm space-y-3">
                <div class="text-3xl">📹</div>
                <h3 class="text-sm font-bold text-slate-800 dark:text-slate-200">No hay videos en este filtro</h3>
                <p class="text-xs text-slate-400 max-w-sm mx-auto">
                    Sé el primero en subir un videotutorial para este módulo.
                </p>
                <button onclick="modal_nuevo_tutorial.showModal()" class="btn btn-primary btn-xs rounded-xl text-xs font-bold">
                    + Publicar Video
                </button>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                @foreach (var item in Model)
                {
                    <div class="bg-white dark:bg-[#111827] rounded-2xl border border-slate-200/80 dark:border-slate-800 shadow-sm hover:shadow-md transition overflow-hidden flex flex-col group">
                        <!-- Thumbnail de YouTube con Botón Play Overlay -->
                        <div class="relative aspect-video bg-slate-900 cursor-pointer overflow-hidden" onclick="reproducirVideo('@item.YoutubeVideoId', '@Html.Raw(Html.Encode(item.Titulo))', '@Html.Raw(Html.Encode(item.Autor))')">
                            <img src="https://img.youtube.com/vi/@item.YoutubeVideoId/hqdefault.jpg" alt="@item.Titulo" class="w-full h-full object-cover group-hover:scale-105 transition duration-300 opacity-90 group-hover:opacity-100" />
                            
                            <div class="absolute inset-0 bg-black/30 flex items-center justify-center">
                                <div class="w-11 h-11 rounded-full bg-red-600/90 text-white flex items-center justify-center shadow-lg group-hover:scale-110 group-hover:bg-red-500 transition duration-200">
                                    <svg class="w-5 h-5 fill-current ml-0.5" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                                </div>
                            </div>

                            <div class="absolute top-2 left-2">
                                <span class="badge badge-neutral text-[10px] font-bold px-2 py-0.5 rounded-lg bg-black/60 text-white backdrop-blur-sm border-0">@item.ModuloNombre</span>
                            </div>
                        </div>

                        <!-- Detalle del Video -->
                        <div class="p-4 flex-1 flex flex-col justify-between space-y-2">
                            <div>
                                <div class="flex items-center justify-between text-[10px] text-slate-400 mb-1">
                                    <span class="font-medium text-blue-600 dark:text-cyan-400">@item.Autor</span>
                                    <span>@item.FechaPublicacion.ToString("dd/MM/yyyy")</span>
                                </div>
                                <h3 class="font-bold text-xs text-slate-900 dark:text-slate-100 leading-snug group-hover:text-blue-600 dark:group-hover:text-cyan-400 transition cursor-pointer" onclick="reproducirVideo('@item.YoutubeVideoId', '@Html.Raw(Html.Encode(item.Titulo))', '@Html.Raw(Html.Encode(item.Autor))')">
                                    @item.Titulo
                                </h3>
                                <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-1 line-clamp-2">
                                    @item.Descripcion
                                </p>
                            </div>

                            <div class="pt-2 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between text-[11px]">
                                <span class="text-slate-400">Nivel: @item.Nivel</span>
                                <button onclick="reproducirVideo('@item.YoutubeVideoId', '@Html.Raw(Html.Encode(item.Titulo))', '@Html.Raw(Html.Encode(item.Autor))')" class="text-blue-600 dark:text-cyan-400 font-semibold hover:underline">
                                    Ver Tutorial →
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- GUÍAS RÁPIDAS DE DESARROLLO (3 Bloques Limpios) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-4 border-t border-slate-200 dark:border-slate-800">
        <!-- 1. CLI -->
        <div id="onboarding" class="p-5 rounded-2xl bg-white dark:bg-[#111827] border border-slate-200/80 dark:border-slate-800 space-y-3">
            <div class="flex items-center gap-2">
                <span class="text-lg">🚀</span>
                <h3 class="text-xs font-bold text-slate-900 dark:text-slate-100 uppercase tracking-wider">
                    1. Inicio Rápido & CLI
                </h3>
            </div>
            <p class="text-[11px] text-slate-500 dark:text-slate-400">
                Ejecuta el asistente interactivo para crear tu rama y correr la intranet:
            </p>
            <div class="font-mono bg-slate-900 text-cyan-300 p-2.5 rounded-xl text-[11px] select-all space-y-1">
                <div>./dev.sh <span class="text-slate-500"># Linux / Mac</span></div>
                <div>.\dev.ps1 <span class="text-slate-500"># Windows</span></div>
            </div>
        </div>

        <!-- 2. Base de Datos -->
        <div id="database" class="p-5 rounded-2xl bg-white dark:bg-[#111827] border border-slate-200/80 dark:border-slate-800 space-y-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <span class="text-lg">🗄️</span>
                    <h3 class="text-xs font-bold text-slate-900 dark:text-slate-100 uppercase tracking-wider">
                        2. PostgreSQL Cloud
                    </h3>
                </div>
                <a href="http://35.206.81.32:8080" target="_blank" class="text-[11px] text-blue-600 dark:text-cyan-400 font-semibold hover:underline">
                    Adminer ↗
                </a>
            </div>
            <p class="text-[11px] text-slate-500 dark:text-slate-400">
                Cada equipo tiene su esquema propio (<code>mod00..09</code>) y lectura compartida de <code>core</code>.
            </p>
            <div class="text-[11px] text-slate-600 dark:text-slate-400 space-y-1">
                <div>• Host: <code class="font-mono text-slate-800 dark:text-slate-200">35.206.81.32:5432</code></div>
                <div>• BD: <code class="font-mono text-slate-800 dark:text-slate-200">db_intranet_iestp</code></div>
            </div>
        </div>

        <!-- 3. Normativa MINEDU -->
        <div id="minedu" class="p-5 rounded-2xl bg-white dark:bg-[#111827] border border-slate-200/80 dark:border-slate-800 space-y-3">
            <div class="flex items-center gap-2">
                <span class="text-lg">⚖️</span>
                <h3 class="text-xs font-bold text-slate-900 dark:text-slate-100 uppercase tracking-wider">
                    3. Normativa Oficial
                </h3>
            </div>
            <ul class="text-[11px] text-slate-500 dark:text-slate-400 space-y-1">
                <li>• <strong>18 Semanas:</strong> Duración del semestre académico.</li>
                <li>• <strong>30% Inasistencias:</strong> Condición DPI automática (nota 00).</li>
                <li>• <strong>Escala 0 a 20:</strong> Nota mínima aprobatoria 13.</li>
            </ul>
        </div>
    </div>
</div>

<!-- Modal Reproductor de Video -->
<dialog id="modal_reproductor" class="modal">
    <div class="modal-box max-w-3xl p-0 rounded-3xl bg-slate-950 border border-slate-800 text-white overflow-hidden shadow-2xl">
        <div class="p-3 bg-slate-900 flex justify-between items-center border-b border-slate-800">
            <div>
                <h3 id="video_titulo" class="font-bold text-xs text-slate-100">Tutorial</h3>
                <p id="video_autor" class="text-[10px] text-cyan-400"></p>
            </div>
            <button onclick="cerrarVideo()" class="btn btn-xs btn-circle btn-ghost text-slate-400 hover:text-white">✕</button>
        </div>
        <div class="aspect-video w-full bg-black">
            <iframe id="video_iframe" class="w-full h-full" src="" title="Tutorial YouTube" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
        </div>
    </div>
    <form method="dialog" class="modal-backdrop">
        <button onclick="cerrarVideo()">close</button>
    </form>
</dialog>

<!-- Modal Publicar Nuevo Tutorial -->
<dialog id="modal_nuevo_tutorial" class="modal">
    <div class="modal-box rounded-3xl max-w-md bg-white dark:bg-[#111827] text-slate-800 dark:text-slate-200 border border-slate-200/80 dark:border-slate-800 shadow-2xl">
        <div class="flex items-center justify-between mb-4">
            <h3 class="font-bold text-sm">Publicar Video Tutorial</h3>
            <button type="button" onclick="modal_nuevo_tutorial.close()" class="btn btn-xs btn-circle btn-ghost">✕</button>
        </div>

        <form asp-action="Agregar" method="post" class="space-y-3 text-xs">
            @Html.AntiForgeryToken()
            
            <div>
                <label class="font-bold block mb-1 text-[11px]">Título del Video <span class="text-red-500">*</span></label>
                <input type="text" name="titulo" required placeholder="Ej: Conexión del Módulo 03 con PostgreSQL" class="input input-xs input-bordered w-full rounded-xl dark:bg-slate-800 dark:border-slate-700 h-9" />
            </div>

            <div class="grid grid-cols-2 gap-2">
                <div>
                    <label class="font-bold block mb-1 text-[11px]">Módulo <span class="text-red-500">*</span></label>
                    <select name="moduloCodigo" class="select select-xs select-bordered w-full rounded-xl dark:bg-slate-800 dark:border-slate-700 h-9">
                        <option value="General">General / Onboarding</option>
                        <option value="Modulo00">00. Seguridad</option>
                        <option value="Modulo01">01. Matrícula</option>
                        <option value="Modulo02" selected>02. Asistencia</option>
                        <option value="Modulo03">03. Calificaciones</option>
                        <option value="Modulo04">04. Horarios</option>
                        <option value="Modulo05">05. Carga Docente</option>
                        <option value="Modulo06">06. Mesa de Partes</option>
                        <option value="Modulo07">07. Bolsa Trabajo</option>
                        <option value="Modulo08">08. Encuestas</option>
                        <option value="Modulo09">09. Tesorería</option>
                    </select>
                </div>

                <div>
                    <label class="font-bold block mb-1 text-[11px]">Nivel</label>
                    <select name="nivel" class="select select-xs select-bordered w-full rounded-xl dark:bg-slate-800 dark:border-slate-700 h-9">
                        <option value="Básico">Básico</option>
                        <option value="Intermedio" selected>Intermedio</option>
                        <option value="Avanzado">Avanzado</option>
                    </select>
                </div>
            </div>

            <div>
                <label class="font-bold block mb-1 text-[11px]">Enlace de YouTube <span class="text-red-500">*</span></label>
                <input type="url" name="youtubeUrl" required placeholder="https://www.youtube.com/watch?v=..." class="input input-xs input-bordered w-full rounded-xl dark:bg-slate-800 dark:border-slate-700 h-9" />
            </div>

            <div>
                <label class="font-bold block mb-1 text-[11px]">Autor / Expositor</label>
                <input type="text" name="autor" placeholder="Ej: Sheyla, Toro, Mendoza..." class="input input-xs input-bordered w-full rounded-xl dark:bg-slate-800 dark:border-slate-700 h-9" />
            </div>

            <div>
                <label class="font-bold block mb-1 text-[11px]">Descripción Breve</label>
                <textarea name="descripcion" rows="2" placeholder="Resumen del tutorial..." class="textarea textarea-xs textarea-bordered w-full rounded-xl dark:bg-slate-800 dark:border-slate-700"></textarea>
            </div>

            <div class="modal-action pt-2">
                <button type="button" onclick="modal_nuevo_tutorial.close()" class="btn btn-ghost btn-xs rounded-xl">Cancelar</button>
                <button type="submit" class="btn btn-primary btn-xs rounded-xl font-bold">Publicar</button>
            </div>
        </form>
    </div>
</dialog>

<script>
    function reproducirVideo(videoId, titulo, autor) {
        const modal = document.getElementById('modal_reproductor');
        const iframe = document.getElementById('video_iframe');
        const tit = document.getElementById('video_titulo');
        const aut = document.getElementById('video_autor');

        tit.innerText = titulo;
        aut.innerText = autor ? 'Expositor: ' + autor : '';
        iframe.src = 'https://www.youtube.com/embed/' + videoId + '?autoplay=1&rel=0';
        modal.showModal();
    }

    function cerrarVideo() {
        const modal = document.getElementById('modal_reproductor');
        const iframe = document.getElementById('video_iframe');
        iframe.src = '';
        modal.close();
    }
</script>
