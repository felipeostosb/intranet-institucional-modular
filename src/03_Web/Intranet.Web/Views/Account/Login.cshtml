@{
    Layout = null;
    ViewData["Title"] = "Iniciar Sesión - IESTP Argentina";
}

<!DOCTYPE html>
<html lang="es" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    
    <!-- Fuente Montserrat Oficial -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdn.jsdelivr.net/npm/daisyui@4.12.10/dist/full.min.css" rel="stylesheet" type="text/css" />

    <style>
        body {
            font-family: 'Montserrat', sans-serif;
            letter-spacing: -0.01em;
        }
    </style>
</head>
<body class="bg-gradient-to-br from-slate-100 via-sky-50/50 to-indigo-50/40 min-h-screen flex items-center justify-center p-4">
    <div class="card w-full max-w-lg bg-white shadow-xl shadow-sky-950/5 border border-slate-200/80 rounded-3xl">
        <div class="card-body p-6 sm:p-8">
            <div class="text-center mb-6">
                <div class="w-14 h-14 rounded-2xl bg-gradient-to-tr from-sky-600 to-indigo-600 text-white flex items-center justify-center text-2xl font-black mx-auto mb-3 shadow-md shadow-sky-500/20">
                    AR
                </div>
                <h1 class="text-xl sm:text-2xl font-black tracking-tight text-slate-900">IESTP "Argentina"</h1>
                <p class="text-xs font-bold text-sky-700 mt-0.5">Intranet Institucional • Semestre 2026-II</p>
                <p class="text-[11px] text-slate-500 mt-0.5">Av. Alfonso Ugarte 599, Lima</p>
            </div>

            @if (ViewBag.Error != null)
            {
                <div role="alert" class="p-3 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-xs font-medium mb-4 flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-4 w-4 text-rose-600" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                    <span>@ViewBag.Error</span>
                </div>
            }

            <form method="post" asp-action="Login" asp-controller="Account" class="space-y-3.5">
                <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

                <div class="form-control">
                    <label class="label py-1">
                        <span class="label-text font-bold text-xs text-slate-700">DNI o Código Institucional</span>
                    </label>
                    <input type="text" id="identificador" name="identificador" required placeholder="Ej: 87654321 o COORD-DSI" class="input input-sm input-bordered w-full rounded-xl focus:input-primary font-medium text-xs h-10" />
                </div>

                <div class="form-control">
                    <label class="label py-1">
                        <span class="label-text font-bold text-xs text-slate-700">Contraseña</span>
                    </label>
                    <input type="password" id="password" name="password" required placeholder="Tu contraseña o DNI" class="input input-sm input-bordered w-full rounded-xl focus:input-primary font-medium text-xs h-10" />
                </div>

                <div class="form-control pt-2">
                    <button type="submit" class="btn bg-sky-600 hover:bg-sky-700 text-white w-full font-bold text-xs rounded-xl shadow-md shadow-sky-600/20 border-0 h-10 min-h-0">
                        Ingresar a la Intranet
                    </button>
                </div>
            </form>

            <div class="divider my-4 text-[10px] font-bold text-slate-400 uppercase tracking-wider">Cuentas Demo (Clic para Rellenar)</div>
            
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
                <button type="button" onclick="setLogin('10000001', '123456')" class="p-2 rounded-xl bg-sky-50 hover:bg-sky-100 border border-sky-100 text-left transition flex flex-col justify-between">
                    <span class="font-bold text-[11px] text-sky-900">🏛️ Director</span>
                    <span class="text-[9px] text-slate-500 font-medium">Lic. Alvarado</span>
                </button>
                <button type="button" onclick="setLogin('20000001', '123456')" class="p-2 rounded-xl bg-indigo-50 hover:bg-indigo-100 border border-indigo-100 text-left transition flex flex-col justify-between">
                    <span class="font-bold text-[11px] text-indigo-900">💻 Coordinador</span>
                    <span class="text-[9px] text-slate-500 font-medium">Ing. Mendoza (DSI)</span>
                </button>
                <button type="button" onclick="setLogin('30000001', '123456')" class="p-2 rounded-xl bg-amber-50 hover:bg-amber-100 border border-amber-100 text-left transition flex flex-col justify-between">
                    <span class="font-bold text-[11px] text-amber-900">📑 Secretaria</span>
                    <span class="text-[9px] text-slate-500 font-medium">Lic. Morales</span>
                </button>
                <button type="button" onclick="setLogin('40000001', '123456')" class="p-2 rounded-xl bg-emerald-50 hover:bg-emerald-100 border border-emerald-100 text-left transition flex flex-col justify-between">
                    <span class="font-bold text-[11px] text-emerald-900">💰 Tesorería</span>
                    <span class="text-[9px] text-slate-500 font-medium">Lic. Ramos</span>
                </button>
                <button type="button" onclick="setLogin('12345678', '123456')" class="p-2 rounded-xl bg-cyan-50 hover:bg-cyan-100 border border-cyan-100 text-left transition flex flex-col justify-between">
                    <span class="font-bold text-[11px] text-cyan-900">👨‍🏫 Docente</span>
                    <span class="text-[9px] text-slate-500 font-medium">Mg. Sánchez</span>
                </button>
                <button type="button" onclick="setLogin('87654321', '123456')" class="p-2 rounded-xl bg-purple-50 hover:bg-purple-100 border border-purple-100 text-left transition flex flex-col justify-between">
                    <span class="font-bold text-[11px] text-purple-900">🎓 Alumno</span>
                    <span class="text-[9px] text-slate-500 font-medium">Felipe Ostos</span>
                </button>
            </div>
        </div>
    </div>

    <script>
        function setLogin(id, pass) {
            document.getElementById('identificador').value = id;
            document.getElementById('password').value = pass;
        }
    </script>
</body>
</html>
