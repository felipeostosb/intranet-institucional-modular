@{
    Layout = null;
    ViewData["Title"] = "Iniciar Sesión - IESTP Argentina";
}

<!DOCTYPE html>
<html lang="es" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    
    <!-- Fuente Montserrat Oficial (Pesos Finos) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600&display=swap" rel="stylesheet">

    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdn.jsdelivr.net/npm/daisyui@4.12.10/dist/full.min.css" rel="stylesheet" type="text/css" />

    <style>
        body {
            font-family: 'Montserrat', -apple-system, BlinkMacSystemFont, sans-serif;
            -webkit-font-smoothing: antialiased;
            letter-spacing: -0.015em;
        }
    </style>
</head>
<body class="bg-[#fbfbfd] min-h-screen flex items-center justify-center p-4 font-light text-slate-800">
    <div class="w-full max-w-md bg-white rounded-3xl p-8 sm:p-10 border border-[#e5e5e7] shadow-[0_4px_30px_rgba(0,0,0,0.03)]">
        <div class="text-center mb-8">
            <div class="w-12 h-12 rounded-2xl bg-slate-900 text-white flex items-center justify-center text-sm font-medium mx-auto mb-4">
                AR
            </div>
            <h1 class="text-xl font-normal text-slate-900 tracking-tight">IESTP "Argentina"</h1>
            <p class="text-xs text-slate-400 font-light mt-1">Intranet Institucional • Semestre 2026-II</p>
        </div>

        @if (ViewBag.Error != null)
        {
            <div role="alert" class="p-3 rounded-2xl bg-[#f5f5f7] border border-rose-200/80 text-rose-700 text-xs font-light mb-5 flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-4 w-4 text-rose-500" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                <span>@ViewBag.Error</span>
            </div>
        }

        <form method="post" asp-action="Login" asp-controller="Account" class="space-y-4">
            <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

            <div class="space-y-1">
                <label class="text-[11px] font-normal text-slate-500 uppercase tracking-wider block">
                    DNI o Código Institucional
                </label>
                <input type="text" id="identificador" name="identificador" required placeholder="87654321 o COORD-DSI" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 bg-[#fbfbfd] text-slate-900 text-xs focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#0071e3]/30 focus:border-[#0071e3] transition font-normal" />
            </div>

            <div class="space-y-1">
                <label class="text-[11px] font-normal text-slate-500 uppercase tracking-wider block">
                    Contraseña
                </label>
                <input type="password" id="password" name="password" required placeholder="Tu contraseña" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 bg-[#fbfbfd] text-slate-900 text-xs focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#0071e3]/30 focus:border-[#0071e3] transition font-normal" />
            </div>

            <div class="pt-2">
                <button type="submit" class="w-full py-2.5 rounded-xl bg-[#0071e3] hover:bg-[#0077ed] text-white text-xs font-normal transition shadow-sm">
                    Iniciar Sesión
                </button>
            </div>
        </form>

        <div class="my-6 border-t border-slate-100 relative text-center">
            <span class="bg-white px-3 text-[10px] text-slate-400 font-light relative -top-2.5">Acceso Rápido por Rol</span>
        </div>
        
        <div class="grid grid-cols-3 gap-2 text-center">
            <button type="button" onclick="setLogin('10000001', '123456')" class="p-2.5 rounded-2xl bg-indigo-50/60 hover:bg-indigo-100/80 border border-indigo-100/80 transition text-[11px] group">
                <div class="font-normal text-indigo-900 group-hover:text-indigo-950">Director</div>
                <div class="text-[9px] text-indigo-500 font-light">Alvarado</div>
            </button>
            <button type="button" onclick="setLogin('20000001', '123456')" class="p-2.5 rounded-2xl bg-sky-50/60 hover:bg-sky-100/80 border border-sky-100/80 transition text-[11px] group">
                <div class="font-normal text-sky-900 group-hover:text-sky-950">Coord.</div>
                <div class="text-[9px] text-sky-500 font-light">Mendoza</div>
            </button>
            <button type="button" onclick="setLogin('30000001', '123456')" class="p-2.5 rounded-2xl bg-emerald-50/60 hover:bg-emerald-100/80 border border-emerald-100/80 transition text-[11px] group">
                <div class="font-normal text-emerald-900 group-hover:text-emerald-950">Secretaría</div>
                <div class="text-[9px] text-emerald-500 font-light">Morales</div>
            </button>
            <button type="button" onclick="setLogin('40000001', '123456')" class="p-2.5 rounded-2xl bg-purple-50/60 hover:bg-purple-100/80 border border-purple-100/80 transition text-[11px] group">
                <div class="font-normal text-purple-900 group-hover:text-purple-950">Tesorería</div>
                <div class="text-[9px] text-purple-500 font-light">Ramos</div>
            </button>
            <button type="button" onclick="setLogin('12345678', '123456')" class="p-2.5 rounded-2xl bg-amber-50/60 hover:bg-amber-100/80 border border-amber-100/80 transition text-[11px] group">
                <div class="font-normal text-amber-900 group-hover:text-amber-950">Docente</div>
                <div class="text-[9px] text-amber-500 font-light">Sánchez</div>
            </button>
            <button type="button" onclick="setLogin('87654321', '123456')" class="p-2.5 rounded-2xl bg-rose-50/60 hover:bg-rose-100/80 border border-rose-100/80 transition text-[11px] group">
                <div class="font-normal text-rose-900 group-hover:text-rose-950">Alumno</div>
                <div class="text-[9px] text-rose-500 font-light">Felipe</div>
            </button>
        </div>
    </div>

    <script>
        function setLogin(id, pass) {
            document.getElementById('identificador').value = id;
            document.getElementById('password').value = pass;
        }
    </script>
</body>
</html>
