@{
    ViewData["Title"] = "Iniciar Sesión";
}

<div class="max-w-md mx-auto my-8 space-y-6">
    <!-- Tarjeta de Login -->
    <div class="bg-white rounded-3xl p-8 border border-slate-200/80 shadow-lg space-y-6">
        <div class="text-center space-y-2">
            <div class="w-14 h-14 rounded-2xl bg-blue-600 text-white flex items-center justify-center font-bold text-2xl mx-auto shadow-md shadow-blue-500/20">
                🏛️
            </div>
            <h1 class="text-xl font-extrabold text-slate-900 tracking-tight">
                Iniciar Sesión en la Intranet
            </h1>
            <p class="text-xs text-slate-500">
                Acceso unificado SSO para Estudiantes, Docentes y Personal Institucional.
            </p>
        </div>

        <form asp-action="Login" method="post" class="space-y-4 text-xs">
            <div>
                <label class="font-bold text-slate-700 block mb-1.5 uppercase text-[10px] tracking-wider">DNI / Identificador</label>
                <input type="text" name="dni" id="input_dni" required placeholder="Ingresa tu DNI" class="input input-bordered w-full rounded-xl bg-slate-50 focus:bg-white text-xs font-medium" />
            </div>

            <div>
                <label class="font-bold text-slate-700 block mb-1.5 uppercase text-[10px] tracking-wider">Contraseña</label>
                <input type="password" name="password" id="input_pass" required placeholder="••••••" class="input input-bordered w-full rounded-xl bg-slate-50 focus:bg-white text-xs" />
            </div>

            <button type="submit" class="btn bg-blue-600 hover:bg-blue-700 text-white w-full rounded-xl font-bold text-xs h-11 border-0 shadow-md shadow-blue-500/20">
                Ingresar a la Plataforma
            </button>
        </form>
    </div>

    <!-- Botones de Prueba Rápida con Tonos Pasteles -->
    <div class="bg-white rounded-3xl p-6 border border-slate-200/80 shadow-sm space-y-3">
        <h2 class="text-xs font-bold text-slate-500 uppercase tracking-wider text-center">
            ⚡ Accesos Rápidos de Prueba (1 Clic)
        </h2>
        <div class="grid grid-cols-2 gap-2">
            <button onclick="setCredentials('10000001', '123456')" class="p-2.5 rounded-xl bg-blue-50 hover:bg-blue-100 text-blue-800 border border-blue-200 text-xs font-semibold text-left transition flex items-center justify-between">
                <span>Director</span>
                <span class="text-[10px] bg-blue-200/60 px-1.5 py-0.5 rounded">Auto</span>
            </button>
            <button onclick="setCredentials('20000001', '123456')" class="p-2.5 rounded-xl bg-indigo-50 hover:bg-indigo-100 text-indigo-800 border border-indigo-200 text-xs font-semibold text-left transition flex items-center justify-between">
                <span>Coordinador</span>
                <span class="text-[10px] bg-indigo-200/60 px-1.5 py-0.5 rounded">Auto</span>
            </button>
            <button onclick="setCredentials('30000001', '123456')" class="p-2.5 rounded-xl bg-emerald-50 hover:bg-emerald-100 text-emerald-800 border border-emerald-200 text-xs font-semibold text-left transition flex items-center justify-between">
                <span>Secretaría</span>
                <span class="text-[10px] bg-emerald-200/60 px-1.5 py-0.5 rounded">Auto</span>
            </button>
            <button onclick="setCredentials('40000001', '123456')" class="p-2.5 rounded-xl bg-purple-50 hover:bg-purple-100 text-purple-800 border border-purple-200 text-xs font-semibold text-left transition flex items-center justify-between">
                <span>Tesorería</span>
                <span class="text-[10px] bg-purple-200/60 px-1.5 py-0.5 rounded">Auto</span>
            </button>
            <button onclick="setCredentials('12345678', '123456')" class="p-2.5 rounded-xl bg-amber-50 hover:bg-amber-100 text-amber-800 border border-amber-200 text-xs font-semibold text-left transition flex items-center justify-between">
                <span>Docente</span>
                <span class="text-[10px] bg-amber-200/60 px-1.5 py-0.5 rounded">Auto</span>
            </button>
            <button onclick="setCredentials('87654321', '123456')" class="p-2.5 rounded-xl bg-rose-50 hover:bg-rose-100 text-rose-800 border border-rose-200 text-xs font-semibold text-left transition flex items-center justify-between">
                <span>Alumno</span>
                <span class="text-[10px] bg-rose-200/60 px-1.5 py-0.5 rounded">Auto</span>
            </button>
        </div>
    </div>
</div>

<script>
    function setCredentials(dni, pass) {
        document.getElementById('input_dni').value = dni;
        document.getElementById('input_pass').value = pass;
    }
</script>
